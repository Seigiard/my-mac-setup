{{- $machineRole := includeTemplate "machine-role" . | trim -}}
{
  "fileSuggestion": {
    "type": "command",
    "command": "~/.claude/hooks/file-suggestion.sh"
  },
  "cleanupPeriodDays": 365,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "mcp__claude-in-chrome",
      "mcp__fff"
    ],
    "deny": [
      "DesignSync",
      "NotebookEdit",
      "PushNotification",
      "RemoteTrigger",
      "ReportFindings",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -r:*)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "disableClaudeAiConnectors": true,
  "disableBundledSkills": true,
  "syncClaudeAiSkills": false,
  "syncClaudeAiPlugins": false,
  "hooks": {
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash '{{ .chezmoi.homeDir }}/.claude/hooks/claude-worktree-create.sh'",
            "timeout": 600
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash '{{ .chezmoi.homeDir }}/.claude/hooks/claude-worktree-remove.sh'",
            "timeout": 600
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write|Bash|mcp__fff__grep|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "bash '{{ .chezmoi.homeDir }}/.claude/hooks/agent-hooks-dispatch.sh'",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '{{ .chezmoi.homeDir }}/.claude/hooks/handoff-pre-compact.sh'",
            "timeout": 240
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '{{ .chezmoi.homeDir }}/.claude/hooks/herdr-resource-context.sh'",
            "timeout": 25
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '{{ .chezmoi.homeDir }}/.claude/hooks/handoff-session-start.sh'",
            "timeout": 10
          }
        ]
      }{{ if lookPath "herdr" }},
      {{/* `herdr integration install claude` appends this entry to the live settings, so without it here every herdr upgrade puts the two owners back into conflict. herdr-resource-context.sh delegates to the same hook to guarantee identity is reported first and survives a missing jq; this entry is the redundant half, kept only to match what herdr writes. */}}{
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '{{ .chezmoi.homeDir }}/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }{{ end }}
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash '{{ .chezmoi.homeDir }}/.claude/hooks/herdr-worktree-identity-hook.sh'",
            "timeout": 2
          },
          {
            "type": "command",
            "command": "bash '{{ .chezmoi.homeDir }}/.claude/hooks/herdr-resource-context.sh'",
            "timeout": 25
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash '{{ .chezmoi.homeDir }}/.claude/hooks/herdr-resource-context.sh'",
            "timeout": 25
          }
        ]
      }
    ]
  },
  "disableRemoteControl": true,
  "crossSessionInbound": "refuse",
  "disableWorkflows": true,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/hooks/statusline.sh"
  },
  "enabledPlugins": {
    "playwright@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": false,
    "security-guidance@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "where-am-i@claude-code-mods": true,
    "image-view@claude-image-view": true{{ if eq $machineRole "mbp2026" }},
    "membrane-operator@membrane.private": true,
    "summit@summit-ai-notes": true
{{- end }}
  },
  "extraKnownMarketplaces": {
    "claude-code-mods": {
      "source": {
        "source": "github",
        "repo": "hamzafer/claude-code-mods"
      }
    },
    "claude-image-view": {
      "source": {
        "source": "github",
        "repo": "jarrodwatts/claude-image-view"
      }
    }{{ if eq $machineRole "mbp2026" }},
    "membrane.private": {
      "source": {
        "source": "github",
        "repo": "membranehq/platform"
      }
    },
    "summit-ai-notes": {
      "source": {
        "source": "github",
        "repo": "SummitNotes/mcp-markeplace"
      }
    }
{{- end }}
  },
  "outputStyle": "writing-style",
  "effortLevel": "high",
  "autoUpdatesChannel": "stable",
  "skipDangerousModePermissionPrompt": true,
  "theme": "custom:light-ansi-daltonized",
  "autoCompactEnabled": true,
  "additionalDirectories": [
    "{{ .chezmoi.homeDir }}/Dropbox/Knowledge Base",
    "{{ .chezmoi.homeDir }}/Dropbox/Knowledge Base/Calendar/",
    "~/Library/CloudStorage/Dropbox/Knowledge Base/",
    "~/Library/CloudStorage/Dropbox/Knowledge Base/Calendar/",
    "~/.claude/hooks/"
  ],
  "feedbackSurveyRate": 0,
  "includeGitInstructions": false,
  "env": {
    "CLAUDE_CODE_IDLE_COMPACT_MIN_TOKENS": "400000"
  },
  "autoMemoryEnabled": false,
  "tui": "fullscreen",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high",
      "autoCompactWindow": 400000
    },
    "claude-fable-5-1": {
      "autoCompactWindow": 400000
    }
  }
}
