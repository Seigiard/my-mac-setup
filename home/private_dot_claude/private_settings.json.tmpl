{{- $cutoverActive := eq (includeTemplate ".chezmoitemplates/agent-skills-cutover-active.tmpl" .) "true" }}
{
  "fileSuggestion": {
    "type": "command",
    "command": "~/.claude/hooks/file-suggestion.sh"
  },
  "cleanupPeriodDays": 365,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "mcp__claude-in-chrome",
      "mcp__deepwiki",
      "mcp__jina",
      "mcp__tavily-mcp",
      "mcp__fff"
    ],
    "deny": [
      "DesignSync",
      "NotebookEdit",
      "PushNotification",
      "RemoteTrigger",
      "ReportFindings",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -r:*)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "disableClaudeAiConnectors": true,
  "disableBundledSkills": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__fff__grep",
        "hooks": [
          {
            "type": "command",
            "command": "bash '{{ .chezmoi.homeDir }}/.claude/hooks/fff-grep-guard.sh'",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "bash '{{ .chezmoi.homeDir }}/.claude/hooks/webfetch-markdown-hint.sh'",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '{{ .chezmoi.homeDir }}/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '{{ .chezmoi.homeDir }}/.claude/hooks/herdr-task-sync-hook.sh' session",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '{{ .chezmoi.homeDir }}/.claude/hooks/herdr-task-sync-hook.sh' compact",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash '{{ .chezmoi.homeDir }}/.claude/hooks/herdr-task-sync-hook.sh' prompt",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "disableRemoteControl": true,
  "disableWorkflows": true,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/hooks/statusline.sh"
  },
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": true,
{{- if not $cutoverActive }}
    "compound-engineering@compound-engineering-plugin": true,
    "frontend-design@claude-plugins-official": true,
{{- end }}
    "playwright@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
{{- if not $cutoverActive }}
  "extraKnownMarketplaces": {
    "compound-engineering-plugin": {
      "source": {
        "source": "github",
        "repo": "EveryInc/compound-engineering-plugin"
      },
      "autoUpdate": true
    }
  },
{{- end }}
  "outputStyle": "writing-style",
  "effortLevel": "high",
  "autoCompactWindow": 400000,
  "autoUpdatesChannel": "stable",
  "skipDangerousModePermissionPrompt": true,
  "theme": "custom:light-ansi-daltonized",
  "autoCompactEnabled": false,
  "additionalDirectories": [
    "{{ .chezmoi.homeDir }}/Dropbox/Knowledge Base",
    "{{ .chezmoi.homeDir }}/Dropbox/Knowledge Base/Calendar/",
    "~/Library/CloudStorage/Dropbox/Knowledge Base/",
    "~/Library/CloudStorage/Dropbox/Knowledge Base/Calendar/",
    "~/.claude/hooks/"
  ],
  "feedbackSurveyState": {
    "lastShownTime": 1754040532937
  },
  "autoMemoryEnabled": false,
  "tui": "fullscreen"
}
