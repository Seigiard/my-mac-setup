#!/usr/bin/env bash
# Move the live local Pane Labels writer to the standalone package. This is the
# only dotfiles-owned lifecycle code: later installs and updates belong to the
# package and the normal GitHub-plugin installer.
set -u

plugin_id="seigi.pane-labels"
repo="Seigiard/herdr-pane-labels"
ref="aba61eb788c5fe0630dc570d96fd14683e2f63c7"
legacy_engine="$HOME/.local/bin/herdr-pane-labels"
legacy_aliases="$HOME/.local/lib/herdr-aliases.sh"
legacy_process="$HOME/.local/lib/herdr-process.sh"
legacy_child="$HOME/.local/bin/herdr-child"
legacy_plugin="${XDG_CONFIG_HOME:-$HOME/.config}/herdr/plugins/herdr-pane-labels"
cache="$HOME/.cache/herdr-pane-labels"
rollback="$cache/cutover-rollback"
sockets="$rollback/sockets"
version_file="$HOME/.local/lib/herdr-pane-labels.version"

log() { printf 'herdr pane-labels migration: %s\n' "$*"; }
error() { printf 'herdr pane-labels migration: %s\n' "$*" >&2; }

cleanup_rollback() {
  rm -rf -- "$rollback"
}

restore_file() {
  local backup="$1" target="$2"
  [ -f "$backup" ] || return 0
  mkdir -p "${target%/*}" || return 1
  cp -p "$backup" "$target"
}

wait_gone() {
  local pid="$1" attempt=0
  while kill -0 "$pid" 2>/dev/null; do
    attempt=$((attempt + 1))
    [ "$attempt" -lt 100 ] || return 1
    sleep 0.05
  done
}

running_sockets() {
  herdr session list --json | jq -r '
    (.result.sessions // .sessions) as $sessions
    | if ($sessions | type) == "array"
      then [$sessions[] | select(.running == true) | .socket_path // empty] | .[]
      else error("malformed session list")
      end' | LC_ALL=C sort -u
}

stop_daemons() {
  local socket namespace lock pid start current command attempt
  while IFS= read -r socket; do
    [ -n "$socket" ] || continue
    namespace="$cache/sockets/$(printf '%s' "$socket" | base64 | tr '/+' '_-' | tr -d '=\n')"
    lock="$namespace/sweep.lock"
    [ -d "$lock" ] || continue
    pid="$(cat "$lock/pid" 2>/dev/null)"
    start="$(cat "$lock/start" 2>/dev/null)"
    case "$pid" in '' | *[!0-9]*) return 1 ;; esac
    kill -0 "$pid" 2>/dev/null || continue
    current="$(ps -p "$pid" -o lstart= 2>/dev/null | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
    command="$(ps -ww -p "$pid" -o command= 2>/dev/null | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
    [ "$current" = "$start" ] || return 1
    case "$command" in *"$legacy_engine --sweep-daemon"*) ;; *) return 1 ;; esac
    kill -TERM "$pid" 2>/dev/null || return 1
    wait_gone "$pid" || return 1
    attempt=0
    while [ -d "$lock" ]; do
      attempt=$((attempt + 1))
      [ "$attempt" -lt 100 ] || return 1
      sleep 0.05
    done
  done < "$sockets"
}

disable_plugin() {
  local socket failed=0
  while IFS= read -r socket; do
    [ -n "$socket" ] || continue
    env HERDR_SOCKET_PATH="$socket" herdr plugin disable "$plugin_id" >/dev/null 2>&1 || failed=1
  done < "$sockets"
  [ "$failed" -eq 0 ]
}

restore_local_plugin() {
  [ -d "$rollback/plugin" ] || return 1
  env -u HERDR_SOCKET_PATH herdr plugin link "$rollback/plugin" --enabled >/dev/null 2>&1
}

package_already_installed() {
  [ -x "$legacy_engine" ] || return 1
  [ -f "$version_file" ] || return 1
  herdr plugin list --json 2>/dev/null | jq -e \
    --arg id "$plugin_id" --arg repo "${repo##*/}" \
    '.result.plugins[] | select(.plugin_id == $id and .source.kind == "github" and .source.repo == $repo)' \
    >/dev/null 2>&1
}

local_plugin_registered=0
if [ -x "$legacy_engine" ] || [ -d "$legacy_plugin" ]; then
  if herdr plugin list --json 2>/dev/null | jq -e \
    --arg id "$plugin_id" \
    '.result.plugins[] | select(.plugin_id == $id and .source.kind == "local")' \
    >/dev/null 2>&1; then
    local_plugin_registered=1
  fi
fi

enable_package() {
  local output
  if output="$(env -u HERDR_SOCKET_PATH herdr plugin enable "$plugin_id" 2>&1)"; then
    return 0
  fi
  if [[ "$output" == *server_not_running* ]] && \
    env -u HERDR_SOCKET_PATH herdr plugin list --json 2>/dev/null | jq -e \
      --arg id "$plugin_id" \
      '.result.plugins[] | select(.plugin_id == $id and .enabled == true)' \
      >/dev/null 2>&1; then
    return 0
  fi
  [ -z "$output" ] || printf '%s\n' "$output" >&2
  return 1
}

reload_herdr_config() {
  local output
  if output="$(env -u HERDR_SOCKET_PATH herdr server reload-config 2>&1)"; then
    return 0
  fi
  if [[ "$output" == *server_not_running* ]]; then
    return 0
  fi
  [ -z "$output" ] || printf '%s\n' "$output" >&2
  return 1
}

rollback() {
  local socket
  env -u HERDR_SOCKET_PATH herdr plugin uninstall "$plugin_id" >/dev/null 2>&1 || true
  restore_file "$rollback/engine" "$legacy_engine" || true
  restore_file "$rollback/aliases" "$legacy_aliases" || true
  restore_file "$rollback/process" "$legacy_process" || true
  restore_file "$rollback/child" "$legacy_child" || true
  if restore_local_plugin; then
    while IFS= read -r socket; do
      [ -n "$socket" ] || continue
      env HERDR_SOCKET_PATH="$socket" herdr plugin enable "$plugin_id" >/dev/null 2>&1 || true
      env HERDR_SOCKET_PATH="$socket" herdr server reload-config >/dev/null 2>&1 || true
      env HERDR_SOCKET_PATH="$socket" "$legacy_engine" --ensure-sweep-daemon >/dev/null 2>&1 || true
    done < "$sockets"
  fi
  if [ -f "$rollback/version" ]; then
    restore_file "$rollback/version" "$version_file" || true
  else
    rm -f -- "$version_file"
  fi
  cleanup_rollback
}

if package_already_installed; then
  exit 0
fi

if [ ! -x "$legacy_engine" ] && [ ! -d "$legacy_plugin" ]; then
  exit 0
fi

if ! command -v herdr >/dev/null 2>&1; then
  error "herdr is required to migrate the running writer; retry after installation"
  exit 1
fi

mkdir -p "$rollback" || exit 1
if ! running_sockets > "$sockets"; then
  error "could not inspect running Herdr sessions; retry on the next apply"
  cleanup_rollback
  exit 1
fi

if [ -x "$legacy_engine" ]; then cp -p "$legacy_engine" "$rollback/engine" || { cleanup_rollback; exit 1; }; fi
if [ -f "$legacy_aliases" ]; then cp -p "$legacy_aliases" "$rollback/aliases" || { cleanup_rollback; exit 1; }; fi
if [ -f "$legacy_process" ]; then cp -p "$legacy_process" "$rollback/process" || { cleanup_rollback; exit 1; }; fi
if [ -x "$legacy_child" ]; then cp -p "$legacy_child" "$rollback/child" || { cleanup_rollback; exit 1; }; fi
if [ -f "$version_file" ]; then cp -p "$version_file" "$rollback/version" || { cleanup_rollback; exit 1; }; fi
if [ -d "$legacy_plugin" ]; then cp -R "$legacy_plugin" "$rollback/plugin" || { cleanup_rollback; exit 1; }; fi

if ! disable_plugin || ! stop_daemons; then
  error "could not quiesce the old writer safely; no files were removed"
  rollback
  exit 1
fi

# Prevent a child launch from crossing the interval where the old alias policy
# has stopped and the package's policy has not yet been installed.
if [ -x "$legacy_child" ]; then
  printf '%s\n' '#!/bin/sh' 'exit 1' > "$legacy_child.cutover" || { rollback; exit 1; }
  chmod 755 "$legacy_child.cutover"
  mv "$legacy_child.cutover" "$legacy_child" || { rollback; exit 1; }
fi

if [ "$local_plugin_registered" -eq 1 ]; then
  if ! env -u HERDR_SOCKET_PATH herdr plugin uninstall "$plugin_id" >/dev/null 2>&1; then
    error "could not unregister the local plugin; restoring the local writer"
    rollback
    exit 1
  fi
fi
if ! env -u HERDR_SOCKET_PATH herdr plugin install "$repo" --ref "$ref" -y; then
  error "package installation failed; restoring the local writer"
  rollback
  exit 1
fi
if ! enable_package; then
  error "package enable failed; restoring the local writer"
  rollback
  exit 1
fi

if [ "$(cat "$version_file" 2>/dev/null)" != "0.2.3" ] || [ ! -x "$legacy_engine" ]; then
  error "package installation did not activate its CLI boundary"
  rollback
  exit 1
fi

if ! reload_herdr_config; then
  error "Herdr config reload failed; restoring the local writer"
  rollback
  exit 1
fi

while IFS= read -r socket; do
  [ -n "$socket" ] || continue
  if ! env HERDR_SOCKET_PATH="$socket" HERDR_PANE_LABELS_STRICT_SWEEP=1 "$legacy_engine" --sweep >/dev/null 2>&1 || \
    ! env HERDR_SOCKET_PATH="$socket" "$legacy_engine" --ensure-sweep-daemon >/dev/null 2>&1; then
    error "package reconciliation failed for $socket; restoring the local writer"
    rollback
    exit 1
  fi
done < "$sockets"

rm -rf -- "$legacy_plugin"
restore_file "$rollback/child" "$legacy_child" || {
  error "could not restore herdr-child after cutover"
  rollback
  exit 1
}
rm -f -- "$rollback/engine" "$rollback/aliases" "$rollback/process" "$rollback/child" "$rollback/version"
rm -rf -- "$rollback/plugin"
cleanup_rollback
log "migrated live Pane Labels to $repo at $ref"
