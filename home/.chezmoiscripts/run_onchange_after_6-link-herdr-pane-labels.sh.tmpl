#!/usr/bin/env bash
# chezmoi:template:left-delimiter="# {{" right-delimiter="}}"
# Link, enable, and verify the pane-labels plugin after managed files change.
#
# Hash triggers:
# # {{ include "dot_local/bin/executable_herdr-pane-labels" | sha256sum }}
# # {{ include "dot_local/lib/herdr-aliases.sh" | sha256sum }}
# # {{ include "private_dot_config/herdr/plugins/herdr-pane-labels/herdr-plugin.toml" | sha256sum }}
# # {{ include "private_dot_config/herdr/plugins/herdr-pane-labels/ensure.sh" | sha256sum }}
# # {{ include "private_dot_config/herdr/plugins/herdr-pane-labels/sweep.sh" | sha256sum }}
# # {{ include ".chezmoitemplates/herdr-pane-labels-cutover-lib.sh" | sha256sum }}

# {{ include ".chezmoitemplates/herdr-pane-labels-cutover-lib.sh" }}

set -u

hpl_cutover_setup || exit 1
trap hpl_cutover_cleanup EXIT
hpl_cutover_mark_deployed || exit 1

if ! command -v herdr >/dev/null 2>&1; then
  if [ -d "$HPL_CUTOVER_ROLLBACK_DIR" ]; then
    hpl_cutover_error "herdr not found; pane-label activation remains pending"
    exit 1
  fi
  echo "herdr not found; skipping pane-labels plugin link"
  exit 0
fi

if [[ ! -f "$HPL_CUTOVER_PLUGIN_DIR/herdr-plugin.toml" ]] || [[ ! -x "$HPL_CUTOVER_NEW_ENGINE" ]]; then
  hpl_cutover_error "managed pane-label engine or plugin manifest is missing"
  exit 1
fi

if ! hpl_cutover_refresh_sessions || ! hpl_cutover_drain_fixed_point; then
  hpl_cutover_fail_after_deploy
  exit 1
fi

hpl_cutover_hook after-second-drain || { hpl_cutover_fail_after_deploy; exit 1; }

if ! hpl_cutover_run_with_deadline herdr plugin link "$HPL_CUTOVER_PLUGIN_DIR" >/dev/null 2>&1; then
  hpl_cutover_error "failed to link $HPL_CUTOVER_PLUGIN_ID"
  hpl_cutover_fail_after_deploy
  exit 1
fi
hpl_cutover_mark_plugin_linked

if ! hpl_cutover_refresh_sessions; then
  hpl_cutover_fail_after_deploy
  exit 1
fi

if ! hpl_cutover_has_sessions; then
  hpl_cutover_commit || exit 1
  hpl_cutover_log "linked $HPL_CUTOVER_PLUGIN_ID; no running Herdr sessions require verification"
  exit 0
fi

if ! hpl_cutover_run_for_sessions herdr plugin enable "$HPL_CUTOVER_PLUGIN_ID" >/dev/null 2>&1 || \
  ! hpl_cutover_run_for_sessions herdr server reload-config >/dev/null 2>&1; then
  hpl_cutover_error "failed to enable or reload $HPL_CUTOVER_PLUGIN_ID"
  hpl_cutover_fail_after_deploy
  exit 1
fi
hpl_cutover_trace plugin-enabled

if ! hpl_cutover_refresh_sessions; then
  hpl_cutover_fail_after_deploy
  exit 1
fi

# Link/reload does not rerun startup hooks for existing sessions. Complete one
# pass, then explicitly start and verify one daemon for each socket.
while IFS= read -r socket; do
  [[ -n "$socket" ]] || continue
  hpl_cutover_run_with_deadline env HERDR_SOCKET_PATH="$socket" HERDR_PANE_LABELS_STRICT_SWEEP=1 \
    "$HPL_CUTOVER_NEW_ENGINE" --sweep >/dev/null || {
    hpl_cutover_fail_after_deploy
    exit 1
  }
  hpl_cutover_trace "first-pass:$socket"
done < "$HPL_CUTOVER_SOCKETS"

if ! hpl_cutover_ensure_all "$HPL_CUTOVER_NEW_ENGINE" "$HPL_CUTOVER_NEW_CACHE"; then
  hpl_cutover_fail_after_deploy
  exit 1
fi

hpl_cutover_commit || exit 1

hpl_cutover_log "linked and verified $HPL_CUTOVER_PLUGIN_ID"
exit 0
