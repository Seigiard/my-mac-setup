#!/bin/bash
# Modify ~/.claude.json to register the MCP servers.
# Requires: jq.

existing=$(cat)

# Every server entry is built with jq, so without it there is no way to write
# the file at all and stdin is the only safe answer.
if ! command -v jq &>/dev/null; then
  echo "$existing"
  exit 0
fi

# The managed set replaces mcpServers whole, so a server dropped from it is
# removed from the live file on the next apply. Web search and DeepWiki run
# through the curl scripts of the markdown-new skill, not through MCP.
echo "$existing" | jq \
  --arg home "$HOME" \
  '.mcpServers = {
    "fff": { "type": "stdio", "command": ($home + "/.local/bin/fff-mcp"), "args": [], "env": {} },
    "executor": { "type": "stdio", "command": ($home + "/.local/bin/executor"), "args": ["mcp"], "env": {} },
    "memex": { "type": "stdio", "command": "memex", "args": ["mcp", "--transport", "stdio"], "env": {} }
  }'
