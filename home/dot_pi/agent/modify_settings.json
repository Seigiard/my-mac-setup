#!/usr/bin/env bash
# Keep the terminal theme and required packages while preserving Pi runtime fields.

set -euo pipefail

if command -v bun >/dev/null 2>&1; then
  runtime=(bun -e)
elif command -v node >/dev/null 2>&1; then
  runtime=(node -e)
else
  printf 'Pi settings modifier requires bun or node\n' >&2
  exit 1
fi

# shellcheck disable=SC2016 # JavaScript template syntax must stay literal.
"${runtime[@]}" '
(async () => {
  let input = "";
  for await (const chunk of process.stdin) input += chunk;

  const settings = input.trim() === "" ? {} : JSON.parse(input);
  const required = [
    "git:github.com/EveryInc/compound-engineering-plugin",
    "npm:pi-ask-user",
    "npm:pi-subagentura",
    "npm:@trevonistrevon/pi-loop",
    "npm:pi-web-access",
    "npm:pi-context-view",
    "npm:@ff-labs/pi-fff",
  ];
  const packages = Array.isArray(settings.packages) ? settings.packages : [];
  const requiredSkills = ["~/.claude/skills"];
  const skills = Array.isArray(settings.skills) ? settings.skills : [];

  for (const packageSource of required) {
    if (!packages.includes(packageSource)) packages.push(packageSource);
  }
  for (const skillSource of requiredSkills) {
    if (!skills.includes(skillSource)) skills.push(skillSource);
  }

  settings.theme = "terminal";
  settings.packages = packages;
  settings.skills = skills;
  process.stdout.write(`${JSON.stringify(settings, null, 2)}\n`);
})().catch((error) => {
  console.error(error.message);
  process.exitCode = 1;
});
'
