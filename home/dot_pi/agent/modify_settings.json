#!/usr/bin/env bash
# Keep the terminal theme and exact extension package set while preserving Pi runtime fields.

set -euo pipefail

if command -v bun >/dev/null 2>&1; then
  runtime=(bun -e)
elif command -v node >/dev/null 2>&1; then
  runtime=(node -e)
else
  printf 'Pi settings modifier requires bun or node\n' >&2
  exit 1
fi

# shellcheck disable=SC2016 # JavaScript template syntax must stay literal.
"${runtime[@]}" '
(async () => {
  let input = "";
  for await (const chunk of process.stdin) input += chunk;

  const fs = require("fs");
  const path = require("path");
  const settings = input.trim() === "" ? {} : JSON.parse(input);
  const extensions = [
    "npm:@ff-labs/pi-fff",
    "npm:@howaboua/pi-codex-conversion",
    "npm:pi-subagents",
    "npm:pi-agent-browser-native",
    "npm:pi-ask-user",
    "npm:@trevonistrevon/pi-loop",
    "npm:pi-web-access",
    "npm:pi-context-view",
  ];
  const configHome = process.env.XDG_CONFIG_HOME || path.join(process.env.HOME || ".", ".config");
  const cutoverReady = path.join(configHome, "agent-skills", "cutover-ready");
  const cutoverGeneration = path.join(configHome, "agent-skills", "cutover-generation");
  let cutoverActive = false;
  try {
    cutoverActive = fs.readFileSync(cutoverReady).equals(fs.readFileSync(cutoverGeneration));
  } catch (_) {
    // Absent, unreadable, and malformed attestation inputs preserve the fallback.
  }

  let skills = Array.isArray(settings.skills) ? settings.skills : [];
  if (cutoverActive) {
    skills = skills.filter((skillSource) => skillSource !== "~/.claude/skills");
  } else {
    extensions.splice(4, 0, "git:github.com/EveryInc/compound-engineering-plugin");
    if (!skills.includes("~/.claude/skills")) skills.push("~/.claude/skills");
  }

  settings.theme = "terminal";
  settings.packages = extensions;
  settings.skills = skills;
  process.stdout.write(`${JSON.stringify(settings, null, 2)}\n`);
})().catch((error) => {
  console.error(error.message);
  process.exitCode = 1;
});
'
