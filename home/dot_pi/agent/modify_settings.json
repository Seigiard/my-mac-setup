#!/usr/bin/env bash
# Keep the terminal theme and required packages while preserving Pi runtime fields.

set -euo pipefail

if command -v bun >/dev/null 2>&1; then
  runtime=(bun -e)
elif command -v node >/dev/null 2>&1; then
  runtime=(node -e)
else
  printf 'Pi settings modifier requires bun or node\n' >&2
  exit 1
fi

# shellcheck disable=SC2016 # JavaScript template syntax must stay literal.
"${runtime[@]}" '
(async () => {
  let input = "";
  for await (const chunk of process.stdin) input += chunk;

  const settings = input.trim() === "" ? {} : JSON.parse(input);
  const required = [
    "git:github.com/EveryInc/compound-engineering-plugin",
    "npm:pi-ask-user",
    "npm:pi-subagentura@3.3.0",
    "npm:@trevonistrevon/pi-loop",
    "npm:pi-web-access",
    "npm:pi-context-view",
    "npm:@ff-labs/pi-fff",
  ];
  // pi-subagentura is pinned: its trial gated adoption on an exact version, and
  // an unpinned entry would let any pi refresh move the machine to an untried one.
  // baseOf strips a version pin so a re-pin replaces the stale entry instead of
  // accumulating a duplicate. The last "@" is a version only when it comes after
  // the package name — "npm:@ff-labs/pi-fff" carries a scope, not a pin.
  const baseOf = (source) => {
    const at = source.lastIndexOf("@");
    return at > source.lastIndexOf("/") && at > source.indexOf(":") + 1
      ? source.slice(0, at)
      : source;
  };
  const requiredSources = new Set(required);
  const requiredBases = new Set(required.map(baseOf));
  const packages = (Array.isArray(settings.packages) ? settings.packages : [])
    .filter((source) => requiredSources.has(source) || !requiredBases.has(baseOf(source)));

  for (const packageSource of required) {
    if (!packages.includes(packageSource)) packages.push(packageSource);
  }

  settings.theme = "terminal";
  settings.packages = packages;
  process.stdout.write(`${JSON.stringify(settings, null, 2)}\n`);
})().catch((error) => {
  console.error(error.message);
  process.exitCode = 1;
});
'
