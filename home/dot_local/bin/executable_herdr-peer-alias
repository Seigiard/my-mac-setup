#!/usr/bin/env bash
# herdr-peer-alias — print one free agent alias.
# Peers started outside herdr-child (the se-* review peers) name their agent
# from here. The name comes from the package's pool whenever its allocator
# answers; when it cannot, this falls back to a placeholder outside that pool,
# which pane-label reconciliation is entitled to rename once the allocator
# returns. A caller must therefore not treat the printed name as stable for the
# life of the run.

set -euo pipefail

# Alias policy belongs to the standalone pane-labels package. This command
# selects candidates only; registration remains the caller's responsibility.
herdr_alias_candidates() {
  local allocator="${HERDR_ALIAS_ALLOCATOR:-herdr-pane-labels}"
  if ! command -v "$allocator" >/dev/null 2>&1 && \
    [ "$allocator" = herdr-pane-labels ] && [ -x "$HOME/.local/bin/herdr-pane-labels" ]; then
    allocator="$HOME/.local/bin/herdr-pane-labels"
  fi
  command -v "$allocator" >/dev/null 2>&1 || {
    printf 'herdr-peer-alias: alias allocator is not on PATH: %s\n' "$allocator" >&2
    return 1
  }
  "$allocator" --alias-candidates "$1"
}

usage() {
  cat >&2 <<'USAGE'
Usage: herdr-peer-alias <seed> [reserved-alias ...]

Prints one alias that no live agent holds and that no reserved argument
claims. Reserve an alias that this run already picked but has not yet
registered with herdr agent start.

Normally a color-animal name from the pane-labels package. If its allocator
cannot answer, prints an unnamed-* placeholder instead, which the package may
rename once it can.
USAGE
}

[ $# -ge 1 ] || { usage; exit 2; }
case "$1" in -h | --help) usage; exit 0 ;; esac

seed="$1"
shift

for binary in herdr jq; do
  command -v "$binary" >/dev/null 2>&1 || {
    printf 'herdr-peer-alias: %s is not on PATH\n' "$binary" >&2
    exit 1
  }
done

list_json="$(herdr agent list)" || {
  printf 'herdr-peer-alias: could not list live agents\n' >&2
  exit 1
}
# A partial agent record would hide an occupied alias and hand out a duplicate.
taken="$(printf '%s' "$list_json" | jq -er '
  .result.agents as $agents
  | if ($agents | type) == "array" and all($agents[]; has("pane_id"))
    then [$agents[] | .name // empty] | join("\n")
    else error("malformed agent list")
    end')" || {
  printf 'herdr-peer-alias: malformed herdr agent list\n' >&2
  exit 1
}

for reserved in "$@"; do
  taken="$taken
$reserved"
done

# Read the whole pool before scanning it. A process substitution here left the
# producer writing 1024 candidates into a pipe that this loop closes at the
# first free alias; the remainder is around the size of a pipe buffer, so the
# producer sometimes took EPIPE and bash reported the broken pipe on the stderr
# it inherited from us. It also discarded the producer's exit status, so a pool
# that failed validation was reported as exhausted instead.
candidates="$(herdr_alias_candidates "$seed")" || {
  # Same degradation as herdr-child: the allocator is missing for a whole window
  # on a clean machine, because chezmoi deploys this command before the package
  # installs, and again after any failed install. Refusing to name a peer stops
  # it from starting at all, which is a steep price for a decorative name. The
  # placeholders keep the pool's name shape but pair a word no color list holds,
  # so the package's reconciler can tell them from allocated names and rename
  # them once it answers again.
  printf 'herdr-peer-alias: alias allocator unavailable; using a placeholder name\n' >&2
  candidates="$(printf 'unnamed-%s\n' alpha bravo charlie delta echo foxtrot golf hotel \
    india juliet kilo lima mike november oscar papa quebec romeo sierra tango)"
}

if [ -n "$candidates" ]; then
  while IFS= read -r candidate; do
    if ! printf '%s\n' "$taken" | grep -qxF "$candidate"; then
      printf '%s\n' "$candidate"
      exit 0
    fi
  done <<< "$candidates"
fi

printf 'herdr-peer-alias: alias pool is exhausted\n' >&2
exit 1
