#!/usr/bin/env bash
# revmux front end: spends the Claude plan's monthly API credit on review rounds.
#
# revmux strips ANTHROPIC_API_KEY from its claude children by default, so they
# sign in with the Claude Code subscription and draw down its usage window. The
# plan's API credit is reachable only through a key. This wrapper hands revmux
# the key from REVMUX_ANTHROPIC_API_KEY under the name claude reads, with the
# flag that stops revmux from stripping it. The key travels under its own name
# in ~/.zshenv because a shell-wide ANTHROPIC_API_KEY also moves interactive
# claude onto the API. Codex agents are not affected.
#
# Without REVMUX_ANTHROPIC_API_KEY the real binary runs unchanged. The wrapper
# sits earlier in PATH than the binary under the same name, so every caller
# (the revmux skill, revmux-round.sh, a shell) goes through it. Keep this Bash
# 3.2 compatible.
set -u

self_dir=$(cd "$(dirname "$0")" && pwd -P)
# Invoked through PATH, the wrapper fronts the first revmux after its own entry:
# an entry before it may be another front end that delegates back here, and
# choosing it would exec in a loop. Invoked by a path outside PATH, it fronts
# the first revmux anywhere but its own directory.
before=""
after=""
seen_self=0
old_ifs=$IFS
IFS=:
for dir in $PATH; do
  # An empty or relative entry means the working directory, which the key
  # must never follow into a binary somebody planted there.
  case "$dir" in /*) ;; *) continue ;; esac
  candidate_dir=$(cd "$dir" 2>/dev/null && pwd -P) || continue
  if [ "$candidate_dir" = "$self_dir" ]; then
    seen_self=1
    continue
  fi
  candidate="$candidate_dir/revmux"
  [ -f "$candidate" ] && [ -x "$candidate" ] || continue
  if [ "$seen_self" = 1 ]; then
    after=$candidate
    break
  fi
  [ -n "$before" ] || before=$candidate
done
IFS=$old_ifs

if [ "$seen_self" = 1 ]; then
  real=$after
else
  real=$before
fi
if [ -z "$real" ]; then
  echo "revmux: no revmux binary in PATH after this wrapper" >&2
  exit 127
fi

if [ -n "${REVMUX_ANTHROPIC_API_KEY:-}" ]; then
  export ANTHROPIC_API_KEY="$REVMUX_ANTHROPIC_API_KEY"
  exec "$real" --preserve-anthropic-api-key "$@"
fi
exec "$real" "$@"
