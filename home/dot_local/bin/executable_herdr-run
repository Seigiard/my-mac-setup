#!/usr/bin/env bash

set -o pipefail

SCRIPT_DIR="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=home/dot_local/lib/herdr-process.sh
source "$SCRIPT_DIR/../lib/herdr-process.sh"

usage() {
  printf '%s\n' 'usage: herdr-run <label> [--cwd DIR] [--dir DIR] [--wait] [--timeout SEC] [--stall-minutes N] -- <command...>' >&2
  printf '%s\n' '       herdr-run verdict <label> [--dir DIR]' >&2
}

valid_label() {
  [[ "$1" =~ ^[[:alnum:]][[:alnum:]._-]*$ ]]
}

compose_project_name() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -c 'abcdefghijklmnopqrstuvwxyz0123456789_-' '-'
}

write_meta() {
  local cwd="$1" meta_file="$2" head=none dirty=0 start

  start="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  if git -C "$cwd" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    head="$(git -C "$cwd" rev-parse HEAD 2>/dev/null || printf '%s' none)"
    if [ -n "$(git -C "$cwd" status --porcelain --untracked-files=all)" ]; then
      dirty=1
    fi
  fi

  printf 'start=%s\nhead=%s\ndirty=%s\ncwd=%s\n' "$start" "$head" "$dirty" "$cwd" > "$meta_file"
}

write_launch_script() {
  local script_file="$1" cwd="$2" log_file="$3" exit_file="$4" compose_project="$5" label="$6"
  shift 6
  local argument

  {
    printf '%s\n' '#!/usr/bin/env bash'
    printf '%s\n' 'set -o pipefail'
    printf '%s\n' "cd -- $(printf '%q' "$cwd")"
    printf '%s\n' "export PWD=$(printf '%q' "$cwd")"
    printf '%s\n' "export PATH=$(printf '%q' "$HOME/.local/share/mise/shims"):\$PATH"
    printf '%s\n' "export COMPOSE_PROJECT_NAME=$(printf '%q' "$compose_project")"
    printf '%s' 'set --'
    for argument in "$@"; do
      printf ' %q' "$argument"
    done
    printf '\n'
    printf '%s\n' "\"\$@\" 2>&1 | tee $(printf '%q' "$log_file")"
    printf '%s\n' 'status=${PIPESTATUS[0]}'
    printf '%s\n' "printf '%s\\n' \"\$status\" > $(printf '%q' "$exit_file")"
    printf '%s\n' "printf 'herdr-run: $label exit=%s\\n' \"\$status\""
    printf '%s\n' 'exit "$status"'
  } > "$script_file"
  chmod +x "$script_file"
}

wait_for_exit() {
  local label="$1" log_file="$2" exit_file="$3" pid_file="$4" pane_file="$5" timeout="$6" stall_seconds="$7"
  local start now last_growth last_size size idle_seconds stall_reported=0 pid pane exit_code

  start="$(date +%s)"
  last_growth="$start"
  last_size=0
  while [ ! -s "$exit_file" ]; do
    now="$(date +%s)"
    if [ -f "$log_file" ]; then
      size="$(wc -c < "$log_file" | tr -d '[:space:]')"
      if [ "$size" -gt "$last_size" ]; then
        last_size="$size"
        last_growth="$now"
      fi
    fi

    idle_seconds=$((now - last_growth))
    if [ "$stall_reported" -eq 0 ] && [ "$idle_seconds" -ge "$stall_seconds" ]; then
      if [ -s "$pid_file" ]; then
        pid="$(cat "$pid_file")"
        printf 'herdr-run: %s stall: log idle %ss pid=%s\n' "$label" "$idle_seconds" "$pid" >&2
        ps -o pid=,ppid=,stat=,etime=,pcpu=,command= -p "$pid" >&2 || true
      else
        pane="$(cat "$pane_file" 2>/dev/null || printf '%s' unknown)"
        printf 'herdr-run: %s stall: log idle %ss pane=%s\n' "$label" "$idle_seconds" "$pane" >&2
      fi
      stall_reported=1
    fi

    if [ -n "$timeout" ] && [ $((now - start)) -ge "$timeout" ]; then
      printf 'herdr-run: %s timeout after %ss, workload left running\n' "$label" "$timeout" >&2
      return 124
    fi
    sleep 0.1
  done

  exit_code="$(tr -d '[:space:]' < "$exit_file")"
  case "$exit_code" in
    '' | *[!0-9]*) return 1 ;;
  esac
  return "$exit_code"
}

run_verdict() {
  local label state_dir meta_file exit_file log_file head dirty cwd exit_code failed ansi_escape failure_pattern

  [ $# -gt 0 ] || {
    usage
    return 2
  }
  label="$1"
  shift
  valid_label "$label" || {
    usage
    return 2
  }

  state_dir="${HERDR_RUN_DIR:-$HOME/.cache/herdr-run}"
  while [ $# -gt 0 ]; do
    case "$1" in
      --dir)
        [ $# -ge 2 ] || {
          usage
          return 2
        }
        state_dir="$2"
        shift 2
        ;;
      *)
        usage
        return 2
        ;;
    esac
  done

  meta_file="$state_dir/$label.meta"
  exit_file="$state_dir/$label.exit"
  log_file="$state_dir/$label.log"
  [ -f "$meta_file" ] || return 2

  head="$(sed -n 's/^head=//p' "$meta_file")"
  dirty="$(sed -n 's/^dirty=//p' "$meta_file")"
  cwd="$(sed -n 's/^cwd=//p' "$meta_file")"
  ansi_escape="$(printf '\033')"
  failure_pattern="^[[:space:]]*($(printf '\342\234\227')|Failed)"
  if [ -f "$log_file" ]; then
    failed="$(LC_ALL=C sed "s/${ansi_escape}\\[[0-9;]*[[:alpha:]]//g" "$log_file" | grep -E "$failure_pattern" | wc -l | tr -d '[:space:]')"
  else
    failed=0
  fi

  if [ -s "$exit_file" ]; then
    exit_code="$(tr -d '[:space:]' < "$exit_file")"
    case "$exit_code" in
      '' | *[!0-9]*) exit_code=none ;;
    esac
    printf 'state=complete\nexit=%s\nhead=%s\ndirty=%s\ncwd=%s\nfailed=%s\n' \
      "$exit_code" "$head" "$dirty" "$cwd" "$failed"
    [ "$exit_code" = none ] && return 1
    return "$exit_code"
  fi

  printf 'state=running\nexit=none\nhead=%s\ndirty=%s\ncwd=%s\nfailed=%s\n' \
    "$head" "$dirty" "$cwd" "$failed"
  return 3
}

run_workload() {
  local label="$1" cwd="$PWD" state_dir="${HERDR_RUN_DIR:-$HOME/.cache/herdr-run}" wait=0 timeout='' stall_minutes=5 stall_seconds
  local script_file log_file exit_file meta_file pid_file pane_file compose_project tab_result pane

  shift
  valid_label "$label" || {
    usage
    return 2
  }

  while [ $# -gt 0 ]; do
    case "$1" in
      --cwd)
        [ $# -ge 2 ] || {
          usage
          return 2
        }
        cwd="$2"
        shift 2
        ;;
      --dir)
        [ $# -ge 2 ] || {
          usage
          return 2
        }
        state_dir="$2"
        shift 2
        ;;
      --wait)
        wait=1
        shift
        ;;
      --timeout)
        [ $# -ge 2 ] || {
          usage
          return 2
        }
        timeout="$2"
        shift 2
        ;;
      --stall-minutes)
        [ $# -ge 2 ] || {
          usage
          return 2
        }
        stall_minutes="$2"
        shift 2
        ;;
      --)
        shift
        break
        ;;
      *)
        usage
        return 2
        ;;
    esac
  done

  [ $# -gt 0 ] || {
    usage
    return 2
  }
  [ -z "$timeout" ] || [[ "$timeout" =~ ^[0-9]+$ ]] || {
    usage
    return 2
  }
  [ "$wait" -eq 1 ] || [ -z "$timeout" ] || {
    usage
    return 2
  }
  [[ "$stall_minutes" =~ ^[0-9]+$ ]] || {
    usage
    return 2
  }
  [ -d "$cwd" ] || {
    printf 'herdr-run: cwd is not a directory: %s\n' "$cwd" >&2
    return 2
  }

  mkdir -p "$state_dir"
  stall_seconds="${HERDR_RUN_STALL_SECONDS:-$((stall_minutes * 60))}"
  [[ "$stall_seconds" =~ ^[0-9]+$ ]] || {
    usage
    return 2
  }

  script_file="$state_dir/$label.sh"
  log_file="$state_dir/$label.log"
  exit_file="$state_dir/$label.exit"
  meta_file="$state_dir/$label.meta"
  pid_file="$state_dir/$label.pid"
  pane_file="$state_dir/$label.pane"
  rm -f "$log_file" "$exit_file" "$pid_file" "$pane_file"

  compose_project="herdr-run-$(compose_project_name "$label")"
  write_meta "$cwd" "$meta_file"
  write_launch_script "$script_file" "$cwd" "$log_file" "$exit_file" "$compose_project" "$label" "$@"

  if [ "${HERDR_ENV:-}" = 1 ]; then
    tab_result="$(herdr tab create --workspace "$HERDR_WORKSPACE_ID" --cwd "$cwd" --label "$label" --no-focus)" || return 1
    pane="$(printf '%s\n' "$tab_result" | sed -n 's/.*"pane_id":"\([^"]*\)".*/\1/p' | sed -n '1p')"
    [ -n "$pane" ] || return 1
    printf '%s\n' "$pane" > "$pane_file"
    herdr pane run "$pane" "bash $script_file" || return 1
    printf 'dir=%s\nlabel=%s\npane=%s\n' "$state_dir" "$label" "$pane"
  else
    (
      close_inherited_descriptors
      nohup bash "$script_file" </dev/null >/dev/null 2>&1 &
      printf '%s\n' "$!" > "$pid_file"
    )
    printf 'dir=%s\nlabel=%s\n' "$state_dir" "$label"
  fi

  if [ "$wait" -eq 1 ]; then
    wait_for_exit "$label" "$log_file" "$exit_file" "$pid_file" "$pane_file" "$timeout" "$stall_seconds"
    return $?
  fi
  return 0
}

main() {
  [ $# -gt 0 ] || {
    usage
    return 2
  }
  if [ "$1" = verdict ]; then
    shift
    run_verdict "$@"
  else
    run_workload "$@"
  fi
}

main "$@"
