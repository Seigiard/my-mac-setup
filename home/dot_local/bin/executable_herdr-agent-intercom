#!/usr/bin/env bash

set -euo pipefail

usage() {
  printf 'usage: herdr-agent-intercom claude|opencode|pi [arguments...]\n' >&2
  exit 2
}

[[ $# -gt 0 ]] || usage
agent="$1"
shift
case "$agent" in
  claude|opencode|pi) ;;
  *) usage ;;
esac

agent_command="$(command -v "$agent" 2>/dev/null || true)"
if [[ -z "$agent_command" ]]; then
  printf 'herdr-agent-intercom: %s is not on PATH\n' "$agent" >&2
  exit 1
fi

if [[ "${HERDR_ENV:-}" != "1" ]]; then
  exec "$agent_command" "$@"
fi

if [[ "${HERDR_AGENT_INTERCOM_ACTIVE:-}" == "1" ]] &&
  [[ -n "${HERDR_PANE_ID:-}" && "${HERDR_AGENT_INTERCOM_PANE:-}" == "$HERDR_PANE_ID" ]]; then
  exec "$agent_command" "$@"
fi

# A new pane can inherit its parent's adapter environment. It must enroll under
# its own registered alias, or start without that inherited Intercom identity.
unset HERDR_AGENT_INTERCOM_ACTIVE HERDR_AGENT_INTERCOM_NAME HERDR_AGENT_INTERCOM_PANE
unset OPENCODE_INTERCOM_NAME HERDR_AGENT_INTERCOM_PI_LOAD
unset HERDR_AGENT_INTERCOM_CLAIM HERDR_AGENT_INTERCOM_CLAIM_AGENT

case "$agent" in
  claude)
    for arg in "$@"; do
      [[ "$arg" != "--" ]] || break
      case "$arg" in
        -h|--help|-v|--version|-p|--print) exec "$agent_command" "$@" ;;
      esac
    done
    claude_args=("$@")
    arg_index=0
    while [[ "$arg_index" -lt "${#claude_args[@]}" ]]; do
      arg="${claude_args[$arg_index]}"
      case "$arg" in
        agents|auth|auto-mode|doctor|gateway|import|install|mcp|plugin|plugins|project|setup-token|ultrareview|update|upgrade)
          exec "$agent_command" "$@"
          ;;
        --allow-dangerously-skip-permissions|--ax-screen-reader|--background|--bare|--bg|--brief|-c|--chrome|--continue|--dangerously-skip-permissions|--disable-slash-commands|--exclude-dynamic-system-prompt-sections|--fork-session|--forward-subagent-text|--ide|--include-hook-events|--include-partial-messages|--no-chrome|--no-session-persistence|--replay-user-messages|--safe-mode|--strict-mcp-config|--verbose)
          arg_index=$((arg_index + 1))
          ;;
        --agent|--agents|--append-system-prompt|--autocompact|--debug-file|--effort|--environment|--fallback-model|--input-format|--json-schema|--max-budget-usd|--model|--name|-n|--output-format|--permission-mode|--plugin-dir|--plugin-url|--remote-control-session-name-prefix|--session-id|--setting-sources|--settings|--system-prompt)
          arg_index=$((arg_index + 2))
          ;;
        --cloud|--debug|-d|--from-pr|--prompt-suggestions|--remote-control|--resume|-r|--teleport|--tmux|--worktree|-w)
          arg_index=$((arg_index + 1))
          if [[ "$arg_index" -lt "${#claude_args[@]}" ]]; then
            case "${claude_args[$arg_index]}" in
              -*) ;;
              *) arg_index=$((arg_index + 1)) ;;
            esac
          fi
          ;;
        --add-dir|--allowedTools|--allowed-tools|--betas|--disallowedTools|--disallowed-tools|--file|--mcp-config|--tools)
          arg_index=$((arg_index + 1))
          while [[ "$arg_index" -lt "${#claude_args[@]}" ]]; do
            case "${claude_args[$arg_index]}" in
              -*) break ;;
              *) arg_index=$((arg_index + 1)) ;;
            esac
          done
          ;;
        --*=*) arg_index=$((arg_index + 1)) ;;
        *) break ;;
      esac
    done
    ;;
  pi)
    for arg in "$@"; do
      [[ "$arg" != "--" ]] || break
      case "$arg" in
        -p|--print|--export|--export=*|--list-models|--list-models=*)
          exec "$agent_command" "$@"
          ;;
      esac
    done
    case "${1:-}" in
      auth|config|install|list|remove|uninstall|update|-h|--help|-v|--version)
        exec "$agent_command" "$@"
        ;;
    esac
    ;;
esac

intercom_name=""
if [[ -n "${HERDR_PANE_ID:-}" ]]; then
  snapshot="$(herdr agent get "$HERDR_PANE_ID" 2>/dev/null)" || snapshot=""
  intercom_name="$(printf '%s' "$snapshot" | python3 -c '
import json
import sys

try:
    agent = json.load(sys.stdin)["result"]["agent"]
    name = agent["name"]
    if agent["pane_id"] != sys.argv[1]:
        raise SystemExit(1)
except (KeyError, TypeError, json.JSONDecodeError):
    raise SystemExit(1)
if not isinstance(name, str) or not name.strip():
    raise SystemExit(1)
sys.stdout.write(name)
' "$HERDR_PANE_ID")" || intercom_name=""
fi

# Managed callers allocate from this pool before `herdr agent start`. Arbitrary
# pending names cannot be renamed until the client starts, so never wait here
# for the reconciler or mistake such a name for the final alias.
if [[ -n "$intercom_name" ]]; then
  allocator="${HERDR_ALIAS_ALLOCATOR:-herdr-pane-labels}"
  if ! command -v "$allocator" >/dev/null 2>&1 &&
    [[ "$allocator" == herdr-pane-labels && -x "$HOME/.local/bin/herdr-pane-labels" ]]; then
    allocator="$HOME/.local/bin/herdr-pane-labels"
  fi
  candidates="$("$allocator" --alias-candidates intercom-validation 2>/dev/null)" || candidates=""
  allocated=0
  while IFS= read -r candidate; do
    if [[ "$candidate" == "$intercom_name" ]]; then
      allocated=1
      break
    fi
  done <<< "$candidates"
  [[ "$allocated" == 1 ]] || intercom_name=""
fi

# A pane that has never hosted an agent carries no record at all, and Herdr
# allocates its alias only after detecting the started client from the terminal
# title that client emits. There is therefore nothing to read here, and waiting
# cannot help: the name this lookup wants comes into being strictly after the
# moment it is needed. Declare the record instead. `pane report-agent` creates
# it, `agent rename` puts a pool alias on it, and that rename is the collision
# boundary -- `agent_name_taken` is decided by the server and arrives before
# the client starts, which is the guarantee a name chosen locally cannot offer.
#
# Only a pane with no record qualifies. A record whose name failed the pool
# check above belongs to someone else's launch (#304); renaming it would take a
# session's identity away from its owner.
#
# The claim suppresses screen detection for as long as it is held, so it
# declares `unknown` rather than a state it cannot know. A session that dies
# before the release then reads as "no information" instead of a confident lie.
# `herdr-agent-intercom-release` performs the release once detection can take
# over; HERDR_AGENT_INTERCOM_CLAIM tells it that this launcher is the claimant.
# Only Claude Code has a surface that can end the claim: the `UserPromptSubmit`
# hook this repository deploys. OpenCode's and Pi's own transports are tool-call
# gates, not lifecycle surfaces, so a claim taken for them would be held for the
# life of the session with nothing able to release it. They keep the fallback.
if [[ -z "$intercom_name" && "$agent" == claude && -n "${HERDR_PANE_ID:-}" ]] &&
  command -v herdr >/dev/null 2>&1 &&
  command -v herdr-peer-alias >/dev/null 2>&1; then
  # `herdr agent get` reports a missing record on stderr and exits non-zero, so
  # the exit status is the ordinary answer here rather than a failure. Discard
  # it and keep the text; blanking the capture on a non-zero status would throw
  # away the one message this branch exists to match.
  claim_probe="$(herdr agent get "$HERDR_PANE_ID" 2>&1)" || true
  if [[ "$claim_probe" == *agent_not_found* ]]; then
    claim_pane="$HERDR_PANE_ID"
    claim_agent="$agent"
    claim_held=0
    # Every exit between taking the claim and handing the pane to the client
    # would otherwise leave a record with detection suppressed and nothing
    # behind it. A successful exec replaces this process and runs no EXIT trap,
    # so this fires only on the paths that never reach the client -- a signal,
    # or one of the argument checks further down that exit non-zero.
    release_unfinished_claim() {
      [[ "$claim_held" == 1 ]] || return 0
      claim_held=0
      herdr pane release-agent "$claim_pane" --source herdr-agent-intercom \
        --agent "$claim_agent" --seq "$(date +%s%N)" >/dev/null 2>&1 || true
    }
    trap release_unfinished_claim EXIT INT TERM

    pane_key="${HERDR_PANE_ID//[^A-Za-z0-9]/_}"
    claim_seed="${HERDR_SOCKET_PATH:-no-socket}|$HERDR_PANE_ID|$agent|$$|$(date +%s)-$RANDOM"
    claimed=0
    unreconciled_name=""
    reserved=()
    attempt=1

    # A pane keeps the agent-session identity of the first client that ever ran
    # in it, and `pane get` still reports it long after that client is gone --
    # the only place it stays visible, because `agent get` has no record left to
    # carry it. Measured on herdr 0.9.1: that field is write-once per pane.
    # Nothing clears it, a fresh identity from the same source does not replace
    # it, and while it is set the pane ignores every `pane report-agent` for
    # that agent kind while still reporting success. So this one read decides
    # the route before a single pool name is spent, and the pane's own record is
    # the evidence rather than the wording of a rejection.
    pane_probe="$(herdr pane get "$HERDR_PANE_ID" 2>/dev/null)" || pane_probe=""
    if [[ "$pane_probe" == *'"agent_session"'* ]]; then
      candidate="$(herdr-peer-alias "$claim_seed" 2>/dev/null)" || candidate=""
      if [[ -n "$candidate" && "$candidate" != unnamed-* ]]; then
        unreconciled_name="$candidate"
      fi
    else
      while [[ "$attempt" -le 3 ]]; do
        candidate="$(herdr-peer-alias "$claim_seed" "${reserved[@]+"${reserved[@]}"}" 2>/dev/null)" || candidate=""
        # herdr-peer-alias degrades to an `unnamed-*` placeholder when the
        # allocator is silent. That name is outside the pool on purpose, so
        # claiming it would only produce a record the pool check rejects.
        [[ -n "$candidate" && "$candidate" != unnamed-* ]] || break
        herdr pane report-agent "$HERDR_PANE_ID" --source herdr-agent-intercom \
          --agent "$agent" --state unknown --seq "$(date +%s%N)" >/dev/null 2>&1 || break
        claim_held=1
        if rename_result="$(herdr agent rename "$HERDR_PANE_ID" "$candidate" 2>&1)"; then
          intercom_name="$candidate"
          claimed=1
          break
        fi
        # Releasing a claim on a pane with no running client destroys the record,
        # which is exactly the state to return to before trying the next name.
        release_unfinished_claim
        # Only a taken name is worth another candidate. The refusal that means
        # the declaration never landed is decided before this loop, so any other
        # rejection here is a condition this launcher does not model. Keep the
        # name and let the first prompt reconcile it: that path is correct for
        # an unmodelled refusal for the same reason it is correct for a used
        # pane, and it costs no further candidates either way.
        if [[ "$rename_result" != *agent_name_taken* ]]; then
          unreconciled_name="$candidate"
          break
        fi
        reserved+=("$candidate")
        attempt=$((attempt + 1))
      done
    fi

    if [[ "$claimed" == 1 ]]; then
      # The marker is what lets the release find a claim whose launcher is gone
      # -- a session killed before its first prompt exports nothing to its
      # successor. Without the marker the claim could never be released at all,
      # so a claim that cannot be recorded is given back instead of leaked.
      claim_dir="${XDG_STATE_HOME:-$HOME/.local/state}/agent-intercom/claims"
      if mkdir -p "$claim_dir" 2>/dev/null &&
        printf '%s\n' "$agent" > "$claim_dir/$pane_key" 2>/dev/null; then
        export HERDR_AGENT_INTERCOM_CLAIM="$HERDR_PANE_ID"
        export HERDR_AGENT_INTERCOM_CLAIM_AGENT="$agent"
      else
        printf 'herdr-agent-intercom: cannot record the pane claim; releasing it\n' >&2
        release_unfinished_claim
        intercom_name=""
      fi
    elif [[ -n "$unreconciled_name" ]]; then
      # The name is a real Intercom identity immediately, but Herdr does not
      # know it until detection creates the record, so until the first prompt
      # the sidebar alias and the Intercom name differ. Recording the pending
      # rename is what makes closing that gap possible at all: the hook cannot
      # re-derive which alias this session enrolled under. A session that cannot
      # be reconciled would keep a name no peer can discover, so it starts
      # without Intercom instead -- the same trade the claim marker makes.
      reconcile_dir="${XDG_STATE_HOME:-$HOME/.local/state}/agent-intercom/reconcile"
      if mkdir -p "$reconcile_dir" 2>/dev/null &&
        printf '%s\n' "$unreconciled_name" > "$reconcile_dir/$pane_key" 2>/dev/null; then
        intercom_name="$unreconciled_name"
      else
        printf 'herdr-agent-intercom: cannot record the pending rename for %s\n' "$unreconciled_name" >&2
      fi
    fi
    # Give back only a claim that bought nothing. A successful claim is held
    # deliberately until the client's first prompt releases it, and the loop
    # breaks before the first `pane report-agent` when the allocator is silent,
    # so there is nothing to release on that path either.
    [[ "$claimed" == 1 ]] || release_unfinished_claim
  fi
fi

if [[ -z "$intercom_name" ]]; then
  printf 'herdr-agent-intercom: canonical pane alias unavailable; starting %s without Intercom\n' "$agent" >&2
  exec "$agent_command" "$@"
fi

intercom_root="$HOME/.local/share/agent-intercom"
# Shared durable state belongs to Intercom, not to any client's config tree.
export INTERCOM_DIR="${INTERCOM_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/agent-intercom}"
export HERDR_AGENT_INTERCOM_ACTIVE=1
export HERDR_AGENT_INTERCOM_NAME="$intercom_name"
export HERDR_AGENT_INTERCOM_PANE="$HERDR_PANE_ID"
case "$agent" in
  claude)
    cci="$intercom_root/node_modules/.bin/cci"
    bridge="$HOME/.local/bin/herdr-agent-intercom-claude"
    claude_server="$intercom_root/node_modules/@dataforxyz/agent-intercom-claude/dist/claude-server.mjs"
    inbox_monitor="$intercom_root/node_modules/@dataforxyz/agent-intercom-claude/dist/inbox-monitor.mjs"
    if [[ ! -x "$cci" || ! -x "$bridge" || ! -f "$claude_server" || ! -f "$inbox_monitor" ]]; then
      # Nothing will answer to the name here, so the pending rename must not
      # publish it: a sidebar alias no session serves sends every peer that
      # reads it nowhere, which is worse than this pane keeping Herdr's own.
      if [[ -n "${reconcile_dir:-}" && -n "${pane_key:-}" ]]; then
        rm -f "$reconcile_dir/$pane_key"
      fi
      exec "$agent_command" "$@"
    fi
    export AGENT_INTERCOM_CLAUDE_COMMAND="$agent_command"
    export AGENT_INTERCOM_CLAUDE_ARGC="$#"
    arg_index=0
    for arg in "$@"; do
      printf -v "AGENT_INTERCOM_CLAUDE_ARG_$arg_index" '%s' "$arg"
      export "AGENT_INTERCOM_CLAUDE_ARG_$arg_index"
      arg_index=$((arg_index + 1))
    done

    # cci reparses its own argv and drops unknown native Claude options. Give it
    # only the overlapping controls it must reconstruct; the bridge restores
    # the complete native argv afterward.
    cci_args=()
    permission_args=()
    arg_index=0
    while [[ "$arg_index" -lt "${#claude_args[@]}" ]]; do
      arg="${claude_args[$arg_index]}"
      case "$arg" in
        --) break ;;
        --model|--effort|--add-dir)
          next_index=$((arg_index + 1))
          [[ "$next_index" -lt "${#claude_args[@]}" ]] || {
            printf 'herdr-agent-intercom: %s requires a value\n' "$arg" >&2
            exit 2
          }
          cci_args+=("$arg" "${claude_args[$next_index]}")
          arg_index=$((arg_index + 2))
          continue
          ;;
        --model=*|--effort=*|--add-dir=*) cci_args+=("$arg") ;;
        --permission-mode)
          next_index=$((arg_index + 1))
          [[ "$next_index" -lt "${#claude_args[@]}" ]] || {
            printf 'herdr-agent-intercom: --permission-mode requires a value\n' >&2
            exit 2
          }
          permission_args=(--permission-mode "${claude_args[$next_index]}")
          arg_index=$((arg_index + 2))
          continue
          ;;
        --permission-mode=*) permission_args=("$arg") ;;
        --dangerously-skip-permissions) permission_args=("$arg") ;;
      esac
      arg_index=$((arg_index + 1))
    done
    set +u
    exec "$cci" "${cci_args[@]}" "${permission_args[@]}" \
      --tui --transport mcp --name "$intercom_name" --claude "$bridge"
    ;;
  opencode)
    export OPENCODE_INTERCOM_NAME="$intercom_name"
    exec "$agent_command" "$@"
    ;;
  pi)
    export HERDR_AGENT_INTERCOM_PI_LOAD="$$"
    pi_args=()
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --name|-n)
          [[ $# -gt 1 ]] || {
            printf 'herdr-agent-intercom: %s requires a value\n' "$1" >&2
            exit 2
          }
          shift 2
          ;;
        --name=*) shift ;;
        --)
          pi_args+=("$@")
          break
          ;;
        *)
          pi_args+=("$1")
          shift
          ;;
      esac
    done
    set +u
    exec "$agent_command" --name "$intercom_name" "${pi_args[@]}"
    ;;
esac
