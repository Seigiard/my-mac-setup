#!/usr/bin/env bash

set -euo pipefail

usage() {
  printf 'usage: herdr-agent-intercom claude|opencode|pi [arguments...]\n' >&2
  exit 2
}

[[ $# -gt 0 ]] || usage
agent="$1"
shift
case "$agent" in
  claude|opencode|pi) ;;
  *) usage ;;
esac

agent_command="$(command -v "$agent" 2>/dev/null || true)"
if [[ -z "$agent_command" ]]; then
  printf 'herdr-agent-intercom: %s is not on PATH\n' "$agent" >&2
  exit 1
fi

if [[ "${HERDR_ENV:-}" != "1" ]]; then
  exec "$agent_command" "$@"
fi

if [[ "${HERDR_AGENT_INTERCOM_ACTIVE:-}" == "1" ]] &&
  [[ -n "${HERDR_PANE_ID:-}" && "${HERDR_AGENT_INTERCOM_PANE:-}" == "$HERDR_PANE_ID" ]]; then
  unset HERDR_AGENT_INTERCOM_RECOVERY_INTENT
  exec "$agent_command" "$@"
fi

# A new pane can inherit its parent's adapter environment. It must enroll under
# its own registered alias, or start without that inherited Intercom identity.
unset HERDR_AGENT_INTERCOM_ACTIVE HERDR_AGENT_INTERCOM_NAME HERDR_AGENT_INTERCOM_PANE
unset OPENCODE_INTERCOM_NAME HERDR_AGENT_INTERCOM_PI_LOAD
unset HERDR_AGENT_INTERCOM_RECOVERY_INTENT

recovery_configuration() {
  recovery_root="${XDG_STATE_HOME:-$HOME/.local/state}/agent-intercom/recovery/v1"
  recovery_engine="${HERDR_AGENT_INTERCOM_LIB_DIR:-$HOME/.local/lib}/intercom-claim-recovery.py"
  recovery_label="${HERDR_AGENT_INTERCOM_RECOVERY_LABEL:-com.seigiard.herdr-agent-intercom-recovery}"
  recovery_plist="${HERDR_AGENT_INTERCOM_RECOVERY_PLIST:-$HOME/Library/LaunchAgents/$recovery_label.plist}"
  recovery_python="$(command -v python3 2>/dev/null)" || return 1
  [[ -r "$recovery_engine" ]] || return 1
}

prepare_recovery_owner() {
  [[ -n "${HERDR_SOCKET_PATH:-}" && "$(uname -s)" == Darwin ]] || return 1
  recovery_configuration || return 1
  "$recovery_python" "$recovery_engine" --ensure-owner --owner-root "$recovery_root" \
    --owner-label "$recovery_label" --owner-plist "$recovery_plist" >/dev/null
}

resolve_recovery_alias() {
  # No recovery state means the independently allocated alias can be reused.
  [[ -e "${XDG_STATE_HOME:-$HOME/.local/state}/agent-intercom/recovery/v1" ]] || return 0
  recovery_configuration || return 1
  local result
  result="$("$recovery_python" "$recovery_engine" --reuse-alias "$recovery_root" \
    --alias "$intercom_name" --owner-label "$recovery_label" --owner-plist "$recovery_plist")" || return 1
  intercom_name="$(printf '%s' "$result" | "$recovery_python" -c 'import json,sys; print(json.load(sys.stdin)["alias"])')" || return 1
}

case "$agent" in
  claude)
    for arg in "$@"; do
      [[ "$arg" != "--" ]] || break
      case "$arg" in
        -h|--help|-v|--version|-p|--print) exec "$agent_command" "$@" ;;
      esac
    done
    claude_args=("$@")
    arg_index=0
    while [[ "$arg_index" -lt "${#claude_args[@]}" ]]; do
      arg="${claude_args[$arg_index]}"
      case "$arg" in
        agents|auth|auto-mode|doctor|gateway|import|install|mcp|plugin|plugins|project|setup-token|ultrareview|update|upgrade)
          exec "$agent_command" "$@"
          ;;
        --allow-dangerously-skip-permissions|--ax-screen-reader|--background|--bare|--bg|--brief|-c|--chrome|--continue|--dangerously-skip-permissions|--disable-slash-commands|--exclude-dynamic-system-prompt-sections|--fork-session|--forward-subagent-text|--ide|--include-hook-events|--include-partial-messages|--no-chrome|--no-session-persistence|--replay-user-messages|--safe-mode|--strict-mcp-config|--verbose)
          arg_index=$((arg_index + 1))
          ;;
        --agent|--agents|--append-system-prompt|--autocompact|--debug-file|--effort|--environment|--fallback-model|--input-format|--json-schema|--max-budget-usd|--model|--name|-n|--output-format|--permission-mode|--plugin-dir|--plugin-url|--remote-control-session-name-prefix|--session-id|--setting-sources|--settings|--system-prompt)
          arg_index=$((arg_index + 2))
          ;;
        --cloud|--debug|-d|--from-pr|--prompt-suggestions|--remote-control|--resume|-r|--teleport|--tmux|--worktree|-w)
          arg_index=$((arg_index + 1))
          if [[ "$arg_index" -lt "${#claude_args[@]}" ]]; then
            case "${claude_args[$arg_index]}" in
              -*) ;;
              *) arg_index=$((arg_index + 1)) ;;
            esac
          fi
          ;;
        --add-dir|--allowedTools|--allowed-tools|--betas|--disallowedTools|--disallowed-tools|--file|--mcp-config|--tools)
          arg_index=$((arg_index + 1))
          while [[ "$arg_index" -lt "${#claude_args[@]}" ]]; do
            case "${claude_args[$arg_index]}" in
              -*) break ;;
              *) arg_index=$((arg_index + 1)) ;;
            esac
          done
          ;;
        --*=*) arg_index=$((arg_index + 1)) ;;
        *) break ;;
      esac
    done
    ;;
  opencode)
    # Known utilities and disabled integrations bypass enrollment to avoid
    # spending a pool alias. Missed classifications still get recovery after
    # confirmed process exit, but need not acquire a claim in the first place.
    #
    # `--pure` is one of them: it runs without external plugins, so the Intercom
    # adapter would not load and the Herdr integration would not report either.
    #
    # The subcommand can sit behind any number of global options, because yargs
    # accepts them before it (`opencode --log-level DEBUG serve` runs `serve`),
    # so the argv walk below skips options and their values and classifies the
    # first bare word. The list is the `Commands:` block of `opencode --help`
    # plus `help`, which yargs registers without printing, and minus two:
    # `pr` checks out a branch and then runs the full client, so it enrolls like
    # any other interactive launch, and `version` is not a command at all --
    # `opencode version` starts the client in a directory of that name.
    for arg in "$@"; do
      [[ "$arg" != "--" ]] || break
      case "$arg" in
        -h|--help|-v|--version|--pure) exec "$agent_command" "$@" ;;
        # The shell completion Homebrew installs calls the bare name, which is
        # this launcher's wrapper function, so every Tab press after `opencode `
        # arrives here. yargs answers it and exits without a client, and the
        # words it passes start with the command name rather than a subcommand,
        # so the walk below would read it as an interactive launch.
        --get-yargs-completions|--get-yargs-completions=*) exec "$agent_command" "$@" ;;
        # An explicit false leaves the plugins loaded, so that launch enrolls
        # like any other. Every other spelling counts as pure, because guessing
        # wrong that way only costs the launch its Intercom, while guessing it
        # the other way claims a pane no plugin will ever report back.
        --pure=false|--pure=0) ;;
        --pure=*) exec "$agent_command" "$@" ;;
      esac
    done
    opencode_args=("$@")
    arg_index=0
    while [[ "$arg_index" -lt "${#opencode_args[@]}" ]]; do
      arg="${opencode_args[$arg_index]}"
      case "$arg" in
        --) break ;;
        --agent|--cors|--hostname|--log-level|--mdns-domain|--model|-m|--port|--prompt|--replay-limit|--session|-s)
          arg_index=$((arg_index + 2))
          ;;
        --*=*) arg_index=$((arg_index + 1)) ;;
        -*) arg_index=$((arg_index + 1)) ;;
        acp|agent|attach|completion|db|debug|export|github|help|import|mcp|models|plug|plugin|providers|auth|run|serve|session|stats|uninstall|upgrade|web)
          exec "$agent_command" "$@"
          ;;
        *) break ;;
      esac
    done
    ;;
  pi)
    # Pi's pipe-driven print mode cannot take lifecycle authority.
    if [[ ! -t 0 || ! -t 1 ]]; then
      exec "$agent_command" "$@"
    fi
    # Headless modes and disabled extensions cannot take lifecycle authority.
    # Bypass known cases instead of acquiring a claim that only exit recovery
    # would release.
    #
    # `--mode` is decided by its value, not by the token: `resolveAppMode` in
    # pi 0.87.1 treats `rpc` and `json` as headless and everything else --
    # `text`, the documented default -- as interactive. Passing through on the
    # bare flag would cost `pi --mode text` the Intercom it has today. Pi rejects
    # the `--mode=value` spelling outright ("Unknown option: --mode"), so the
    # space-separated form is the only one to match.
    pi_prev=""
    for arg in "$@"; do
      [[ "$arg" != "--" ]] || break
      case "$pi_prev $arg" in
        '--mode json'|'--mode rpc') exec "$agent_command" "$@" ;;
      esac
      case "$arg" in
        -h|--help|-v|--version)
          exec "$agent_command" "$@"
          ;;
        -p|--print|--export|--export=*|--list-models|--list-models=*)
          exec "$agent_command" "$@"
          ;;
        --no-extensions|-ne)
          exec "$agent_command" "$@"
          ;;
      esac
      pi_prev="$arg"
    done
    # Pi reads a subcommand only in first position -- `pi --verbose list` sends
    # `list` to the model as a message -- so unlike the flags above this needs
    # no argv walk.
    case "${1:-}" in
      auth|config|install|list|remove|uninstall|update)
        exec "$agent_command" "$@"
        ;;
    esac
    ;;
esac

intercom_name=""
intercom_root="$HOME/.local/share/agent-intercom"
if [[ "$agent" == claude ]]; then
  cci="$intercom_root/node_modules/.bin/cci"
  bridge="${HERDR_AGENT_INTERCOM_BIN_DIR:-$HOME/.local/bin}/herdr-agent-intercom-claude"
  native_bridge="${HERDR_AGENT_INTERCOM_LIB_DIR:-$HOME/.local/lib}/herdr-agent-intercom-native-claude"
  claude_server="$intercom_root/node_modules/@dataforxyz/agent-intercom-claude/dist/claude-server.mjs"
  inbox_monitor="$intercom_root/node_modules/@dataforxyz/agent-intercom-claude/dist/inbox-monitor.mjs"
  monitor_manifest="$intercom_root/node_modules/@dataforxyz/agent-intercom-claude/monitors/monitors.json"
  # Missing optional enrollment components must be known before acquiring a claim.
  if [[ ! -x "$cci" || ! -x "$bridge" || ! -x "$native_bridge" || ! -f "$claude_server" ||
        ! -f "$inbox_monitor" || ! -f "$monitor_manifest" ]]; then
    printf 'herdr-agent-intercom: enrollment components unavailable; starting claude without Intercom\n' >&2
    exec "$agent_command" "$@"
  fi
fi
if [[ -n "${HERDR_PANE_ID:-}" ]]; then
  snapshot="$(herdr agent get "$HERDR_PANE_ID" 2>/dev/null)" || snapshot=""
  intercom_name="$(printf '%s' "$snapshot" | python3 -c '
import json
import sys

try:
    agent = json.load(sys.stdin)["result"]["agent"]
    name = agent["name"]
    if agent["pane_id"] != sys.argv[1]:
        raise SystemExit(1)
except (KeyError, TypeError, json.JSONDecodeError):
    raise SystemExit(1)
if not isinstance(name, str) or not name.strip():
    raise SystemExit(1)
sys.stdout.write(name)
' "$HERDR_PANE_ID")" || intercom_name=""
fi

# Managed callers allocate from this pool before `herdr agent start`. Arbitrary
# pending names cannot be renamed until the client starts, so never wait here
# for the reconciler or mistake such a name for the final alias.
if [[ -n "$intercom_name" ]]; then
  allocator="${HERDR_ALIAS_ALLOCATOR:-herdr-pane-labels}"
  if ! command -v "$allocator" >/dev/null 2>&1 &&
    [[ "$allocator" == herdr-pane-labels && -x "$HOME/.local/bin/herdr-pane-labels" ]]; then
    allocator="$HOME/.local/bin/herdr-pane-labels"
  fi
  candidates="$("$allocator" --alias-candidates intercom-validation 2>/dev/null)" || candidates=""
  allocated=0
  while IFS= read -r candidate; do
    if [[ "$candidate" == "$intercom_name" ]]; then
      allocated=1
      break
    fi
  done <<< "$candidates"
  [[ "$allocated" == 1 ]] || intercom_name=""
fi

if [[ -n "$intercom_name" ]] && ! resolve_recovery_alias; then
  printf 'herdr-agent-intercom: existing alias recovery is unresolved; starting %s without Intercom\n' "$agent" >&2
  exec "$agent_command" "$@"
fi

# A pane that has never hosted an agent carries no record at all, and Herdr
# allocates its alias only after detecting the started client from the terminal
# title that client emits. There is therefore nothing to read here, and waiting
# cannot help: the name this lookup wants comes into being strictly after the
# moment it is needed. Declare the record instead. `pane report-agent` creates
# it, `agent rename` puts a pool alias on it, and that rename is the collision
# boundary -- `agent_name_taken` is decided by the server and arrives before
# the client starts, which is the guarantee a name chosen locally cannot offer.
#
# Only a pane with no record qualifies. A record whose name failed the pool
# check above belongs to someone else's launch (#304); renaming it would take a
# session's identity away from its owner.
#
# The claim suppresses screen detection for as long as it is held, so it
# declares `unknown` rather than a state it cannot know. A session that dies
# before the release then reads as "no information" instead of a confident lie.
#
# Who ends the claim differs by client, and only Claude needs this launcher's
# help. Measured on herdr 0.9.1: OpenCode's and Pi's own Herdr integrations
# report `pane.report_agent` under their `herdr:<client>` source and take the
# pane's lifecycle authority back over a held claim -- OpenCode at its first
# prompt, Pi already at session start -- keeping the alias this claim allocated.
# From then on the pane reads `full_lifecycle_hook_authority`, exactly as it
# does for a session that never took a claim, so the claim leaves no residue and
# a release would be inert against a record it no longer owns. Claude publishes
# no such state, so its pane depends on screen detection, and only its release
# gives detection back: `herdr-agent-intercom-release` performs it from the
# `UserPromptSubmit` hook this repository deploys.
if [[ -z "$intercom_name" && -n "${HERDR_PANE_ID:-}" ]] &&
  command -v herdr >/dev/null 2>&1 &&
  command -v herdr-peer-alias >/dev/null 2>&1; then
  # `herdr agent get` reports a missing record on stderr and exits non-zero, so
  # the exit status is the ordinary answer here rather than a failure. Discard
  # it and keep the text; blanking the capture on a non-zero status would throw
  # away the one message this branch exists to match.
  claim_probe="$(herdr agent get "$HERDR_PANE_ID" 2>&1)" || true
  if [[ "$claim_probe" == *agent_not_found* ]]; then
    recovery_intent=""

    pane_key="${HERDR_PANE_ID//[^A-Za-z0-9]/_}"
    claim_seed="${HERDR_SOCKET_PATH:-no-socket}|$HERDR_PANE_ID|$agent|$$|$(date +%s)-$RANDOM"
    unreconciled_name=""
    reserved=()
    attempt=1

    # A pane keeps the agent-session identity of the first client that ever ran
    # in it, and `pane get` still reports it long after that client is gone --
    # the only place it stays visible, because `agent get` has no record left to
    # carry it. Measured on herdr 0.9.1: that field is write-once per pane.
    # Nothing clears it, a fresh identity from the same source does not replace
    # it, and while it is set the pane ignores every `pane report-agent` while
    # still reporting success -- whatever agent kind that report names, not only
    # the kind the identity carries. A pane whose first client was OpenCode or Pi
    # is as undeclarable as one that hosted Claude, so this tests for the field
    # and deliberately not for its `agent` value: narrowing it to `claude` would
    # send every pi- or opencode-used pane back to the route that cannot work.
    # So this one read decides the route before a single pool name is spent, and
    # the pane's own record is the evidence rather than the wording of a
    # rejection.
    pane_probe="$(herdr pane get "$HERDR_PANE_ID" 2>/dev/null)" || pane_probe=""
    if [[ "$pane_probe" == *'"agent_session"'* ]]; then
      candidate="$(herdr-peer-alias "$claim_seed" 2>/dev/null)" || candidate=""
      if [[ -n "$candidate" && "$candidate" != unnamed-* ]]; then
        unreconciled_name="$candidate"
      fi
    elif prepare_recovery_owner; then
      while [[ "$attempt" -le 3 ]]; do
        candidate="$(herdr-peer-alias "$claim_seed" "${reserved[@]+"${reserved[@]}"}" 2>/dev/null)" || candidate=""
        # herdr-peer-alias degrades to an `unnamed-*` placeholder when the
        # allocator is silent. That name is outside the pool on purpose, so
        # claiming it would only produce a record the pool check rejects.
        [[ -n "$candidate" && "$candidate" != unnamed-* ]] || break
        recovery_result="$("$recovery_python" "$recovery_engine" --claim-intent "$recovery_root/intents" \
          --agent "$agent" --source herdr-agent-intercom-recovery-v1 --alias "$candidate" --launcher-pid "$$")" || recovery_result=""
        recovery_intent="$(printf '%s' "$recovery_result" | "$recovery_python" -c 'import json,sys; print(json.load(sys.stdin).get("intent", ""))' 2>/dev/null)" || recovery_intent=""
        claimed_result="$(printf '%s' "$recovery_result" | "$recovery_python" -c 'import json,sys; print(json.load(sys.stdin).get("claimed") is True)' 2>/dev/null)" || claimed_result=False
        if [[ "$claimed_result" == True && -n "$recovery_intent" ]]; then
          intercom_name="$candidate"
          export HERDR_AGENT_INTERCOM_RECOVERY_INTENT="$recovery_intent"
          export HERDR_AGENT_INTERCOM_PYTHON="$recovery_python"
          break
        fi
        # Retry only a collision whose reserved rollback was verified by the engine.
        retry_result="$(printf '%s' "$recovery_result" | "$recovery_python" -c 'import json,sys; print(json.load(sys.stdin).get("retry") is True)' 2>/dev/null)" || retry_result=False
        if [[ "$retry_result" != True ]]; then
          printf 'herdr-agent-intercom: enrollment unavailable; any partial claim remains pending for recovery\n' >&2
          break
        fi
        reserved+=("$candidate")
        attempt=$((attempt + 1))
      done
    else
      printf 'herdr-agent-intercom: automatic claim recovery unavailable; starting %s without a new claim\n' "$agent" >&2
    fi

    # Used-pane reconciliation remains separate from claim recovery.
    if [[ -n "$unreconciled_name" && "$agent" == claude ]]; then
      # The name is a real Intercom identity immediately, but Herdr does not
      # know it until detection creates the record, so until the first prompt
      # the sidebar alias and the Intercom name differ. Recording the pending
      # rename is what makes closing that gap possible at all: the hook cannot
      # re-derive which alias this session enrolled under. A session that cannot
      # be reconciled would keep a name no peer can discover, so it starts
      # without Intercom rather than keep a name that cannot be reconciled.
      reconcile_dir="${XDG_STATE_HOME:-$HOME/.local/state}/agent-intercom/reconcile"
      if mkdir -p "$reconcile_dir" 2>/dev/null &&
        printf '%s\n' "$unreconciled_name" > "$reconcile_dir/$pane_key" 2>/dev/null; then
        intercom_name="$unreconciled_name"
      else
        printf 'herdr-agent-intercom: cannot record the pending rename for %s\n' "$unreconciled_name" >&2
      fi
    fi
  fi
fi

if [[ -z "$intercom_name" ]]; then
  printf 'herdr-agent-intercom: canonical pane alias unavailable; starting %s without Intercom\n' "$agent" >&2
  exec "$agent_command" "$@"
fi

# Shared durable state belongs to Intercom, not to any client's config tree.
export INTERCOM_DIR="${INTERCOM_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/agent-intercom}"
export HERDR_AGENT_INTERCOM_ACTIVE=1
export HERDR_AGENT_INTERCOM_NAME="$intercom_name"
export HERDR_AGENT_INTERCOM_PANE="$HERDR_PANE_ID"
case "$agent" in
  claude)
    export AGENT_INTERCOM_CLAUDE_COMMAND="$agent_command"
    export AGENT_INTERCOM_CLAUDE_ARGC="$#"
    arg_index=0
    for arg in "$@"; do
      printf -v "AGENT_INTERCOM_CLAUDE_ARG_$arg_index" '%s' "$arg"
      export "AGENT_INTERCOM_CLAUDE_ARG_$arg_index"
      arg_index=$((arg_index + 1))
    done

    # cci reparses its own argv and drops unknown native Claude options. Give it
    # only the overlapping controls it must reconstruct; the bridge restores
    # the complete native argv afterward.
    cci_args=()
    permission_args=()
    arg_index=0
    while [[ "$arg_index" -lt "${#claude_args[@]}" ]]; do
      arg="${claude_args[$arg_index]}"
      case "$arg" in
        --) break ;;
        --model|--effort|--add-dir)
          next_index=$((arg_index + 1))
          [[ "$next_index" -lt "${#claude_args[@]}" ]] || {
            printf 'herdr-agent-intercom: %s requires a value\n' "$arg" >&2
            exit 2
          }
          cci_args+=("$arg" "${claude_args[$next_index]}")
          arg_index=$((arg_index + 2))
          continue
          ;;
        --model=*|--effort=*|--add-dir=*) cci_args+=("$arg") ;;
        --permission-mode)
          next_index=$((arg_index + 1))
          [[ "$next_index" -lt "${#claude_args[@]}" ]] || {
            printf 'herdr-agent-intercom: --permission-mode requires a value\n' >&2
            exit 2
          }
          permission_args=(--permission-mode "${claude_args[$next_index]}")
          arg_index=$((arg_index + 2))
          continue
          ;;
        --permission-mode=*) permission_args=("$arg") ;;
        --dangerously-skip-permissions) permission_args=("$arg") ;;
      esac
      arg_index=$((arg_index + 1))
    done
    set +u
    exec "$cci" "${cci_args[@]}" "${permission_args[@]}" \
      --tui --transport mcp --name "$intercom_name" --claude "$bridge"
    ;;
  opencode)
    export OPENCODE_INTERCOM_NAME="$intercom_name"
    exec "$agent_command" "$@"
    ;;
  pi)
    export HERDR_AGENT_INTERCOM_PI_LOAD="$$"
    pi_args=()
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --name|-n)
          [[ $# -gt 1 ]] || {
            printf 'herdr-agent-intercom: %s requires a value\n' "$1" >&2
            exit 2
          }
          shift 2
          ;;
        --name=*) shift ;;
        --)
          pi_args+=("$@")
          break
          ;;
        *)
          pi_args+=("$1")
          shift
          ;;
      esac
    done
    set +u
    exec "$agent_command" --name "$intercom_name" "${pi_args[@]}"
    ;;
esac
