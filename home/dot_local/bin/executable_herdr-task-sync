#!/usr/bin/env bash
# herdr-task-sync — name the herdr pane after the coding-agent session's task.
#
# Adapters (the Claude Code hook, the pi extension, the opencode plugin) call
# this script with the submitted prompt on stdin. It returns immediately and
# lets a detached worker do the slow part: ask a naming model for a short
# English slug, then name the pane `<agent badge> <slug>` and rebuild the tab
# label from every pane in that tab. A pane with no agent is named after the
# command running in it, so `bun run dev` joins the tab label on its own.
#
# The slug also stays published as the pane's `task` metadata token, so a
# sidebar row configured with `$task` keeps working.
#
# Usage:
#   herdr-task-sync --agent <name> --session <id> [--pane <id>]
#                   [--transcript <path>] [--set <name>]
#
#   --set <name>   publish <name> directly (normalized, no model call)
#   --transcript   derive the naming context from a Claude Code JSONL
#                  transcript instead of stdin (session start / pre-compact)
#
# Environment overrides:
#   HERDR_TASK_SYNC_PI_MODEL, HERDR_TASK_SYNC_CLAUDE_MODEL,
#   HERDR_TASK_SYNC_TIMEOUT (seconds per engine), HERDR_TASK_SYNC_STATE_DIR
#
# Nothing here may fail loudly: every guard exits 0 so an agent never breaks
# because naming is unavailable.

set -uo pipefail

STATE_DIR="${HERDR_TASK_SYNC_STATE_DIR:-$HOME/.cache/herdr-task-sync}"
ENGINE_TIMEOUT="${HERDR_TASK_SYNC_TIMEOUT:-30}"
PI_MODEL="${HERDR_TASK_SYNC_PI_MODEL:-openai-codex/gpt-5.4-mini}"
CLAUDE_MODEL="${HERDR_TASK_SYNC_CLAUDE_MODEL:-claude-haiku-4-5-20251001}"
STATE_MAX_AGE_DAYS=14
SOURCE_ID="task-sync"
SLUG_MAX_LEN=40
# R4 asks for 2-4 words. A wordier answer is prose, not a name — an engine that
# explains itself instead of naming the session counts as a failed call, so the
# chain advances rather than putting a sentence in the sidebar.
SLUG_MAX_WORDS=5
# A command name shares the tab label with every other pane of the tab, so it
# is capped harder than a task slug and ends in an ellipsis when it is cut.
PROC_LABEL_MAX_LEN=24
# An idle pane still holds a slot in the tab, so it is named rather than
# dropped: the tab label then shows how many panes the tab has.
IDLE_PANE_LABEL="~"
# Panes are joined with a middle dot (U+00B7): a full-height bar drew a wall
# through the tab row. Override with HERDR_TASK_SYNC_SEPARATOR.
LABEL_SEPARATOR="${HERDR_TASK_SYNC_SEPARATOR:- · }"
# Seconds between two sweeps of the daemon. Five keeps a finished command
# visible for at most one glance without hammering the herdr socket.
SWEEP_INTERVAL="${HERDR_TASK_SYNC_SWEEP_INTERVAL:-5}"
SWEEP_LOCK_DIR="$STATE_DIR/sweep.lock"
INBOX_LOCK_ATTEMPTS="${HERDR_TASK_SYNC_LOCK_ATTEMPTS:-20}"
SOCKET_PATH="${HERDR_SOCKET_PATH:-}"

agent=""
session=""
pane="${HERDR_PANE_ID:-}"
transcript=""
set_name=""
seq=""
worker_mode=0

mode="name"

usage() {
  cat >&2 <<'EOF'
Usage: herdr-task-sync --agent <name> --session <id> [--pane <id>]
                       [--transcript <path>] [--set <name>]
       herdr-task-sync --sweep | --sweep-daemon | --ensure-daemon
The prompt is read from stdin.
EOF
}

while [ $# -gt 0 ]; do
  case "$1" in
    --agent) agent="${2:-}"; shift 2 ;;
    --session) session="${2:-}"; shift 2 ;;
    --pane) pane="${2:-}"; shift 2 ;;
    --transcript) transcript="${2:-}"; shift 2 ;;
    --set) set_name="${2:-}"; shift 2 ;;
    --worker) worker_mode=1; shift ;;
    --sweep) mode="sweep"; shift ;;
    --sweep-daemon) mode="sweep-daemon"; shift ;;
    --ensure-daemon) mode="ensure-daemon"; shift ;;
    -h|--help) usage; exit 0 ;;
    *) shift ;;
  esac
done

# ---------------------------------------------------------------- utilities

# Bound LLM output before it reaches the --token argument and the sidebar:
# lowercase, keep [a-z0-9-] only, collapse runs, trim, cap the length.
normalize_slug() {
  LC_ALL=C printf '%s' "$1" \
    | tr '[:upper:]' '[:lower:]' \
    | tr -c 'a-z0-9-' '-' \
    | sed -e 's/--*/-/g' -e 's/^-//' -e 's/-$//' \
    | cut -c "1-$SLUG_MAX_LEN" \
    | sed -e 's/-$//'
}

first_nonempty_line() {
  printf '%s\n' "$1" | sed -e 's/\r$//' | grep -m1 '[^[:space:]]' || true
}

slug_word_count() {
  printf '%s' "$1" | tr '-' '\n' | grep -c '.' || true
}

# A microsecond floor for monotonic inbox generations and metadata sequences.
now_seq() {
  if [ -n "${HERDR_TASK_SYNC_TEST_NOW_SEQ:-}" ]; then
    printf '%s' "$HERDR_TASK_SYNC_TEST_NOW_SEQ"
    return 0
  fi
  if command -v python3 >/dev/null 2>&1; then
    local value
    value="$(python3 -c 'import time; print(int(time.time()*1000000))' 2>/dev/null)"
    if [ -n "$value" ]; then
      printf '%s' "$value"
      return 0
    fi
  fi
  printf '%s000000' "$(date +%s)"
}

sanitize_key() {
  LC_ALL=C printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '-' | cut -c1-64
}

legacy_state_file_path() {
  printf '%s/%s.state' "$STATE_DIR" \
    "$(sanitize_key "${agent}-${pane}-${session}")"
}

encode_key() {
  printf '%s' "$1" | base64 | tr '/+' '_-' | tr -d '=\n'
}

encode_value() {
  printf '%s' "$1" | base64 | tr -d '\n'
}

namespace_dir() {
  [ -n "$SOCKET_PATH" ] || return 1
  printf '%s/sockets/%s' "$STATE_DIR" "$(encode_key "$SOCKET_PATH")"
}

pane_state_dir() {
  printf '%s/panes/%s' "$(namespace_dir)" "$(encode_key "$pane")"
}

task_state_file() {
  local identity
  identity="$(printf '%s\037%s\037%s' "$agent" "$pane" "$session")"
  printf '%s/tasks/%s.state' "$(namespace_dir)" "$(encode_key "$identity")"
}

migration_marker_file() {
  local identity
  identity="$(printf '%s\037%s\037%s' "$agent" "$pane" "$session")"
  printf '%s/migration/%s.done' "$(namespace_dir)" "$(encode_key "$identity")"
}

atomic_write() {
  local file="$1" content="$2" dir tmp
  [ ! -d "$file" ] || return 1
  dir="$(dirname "$file")"
  mkdir -p "$dir" 2>/dev/null || return 1
  tmp="$(umask 077; mktemp "$dir/.record.XXXXXX" 2>/dev/null)" || return 1
  if ! printf '%s\n' "$content" > "$tmp" 2>/dev/null; then
    rm -f "$tmp"
    return 1
  fi
  if [ -d "$file" ] || ! mv "$tmp" "$file" 2>/dev/null; then
    rm -f "$tmp"
    return 1
  fi
  return 0
}

record_number() {
  local file="$1" key="$2" value
  [ -f "$file" ] || return 0
  value="$(sed -n "s/^${key}=//p" "$file" 2>/dev/null | head -1)"
  case "$value" in
    '' | *[!0-9]*) return 0 ;;
  esac
  printf '%s' "$value"
}

max_number() {
  local max=0 value
  for value in "$@"; do
    case "$value" in '' | *[!0-9]*) continue ;; esac
    [ "$value" -le "$max" ] || max="$value"
  done
  printf '%s' "$max"
}

process_start_token() {
  ps -p "$1" -o lstart= 2>/dev/null | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//'
}

claim_owner_id=""

recover_claim() {
  local lock="$1" attempt="$2" owner pid start socket current_start
  owner="$(read_state_field "$lock/owner" owner_id)"
  if [ -z "$owner" ]; then
    [ "$attempt" -ge 3 ] || return 1
    if [ -f "$lock/owner" ] && [ -z "$(read_state_field "$lock/owner" owner_id)" ]; then
      rm -f "$lock/owner" 2>/dev/null
    fi
    rmdir "$lock" 2>/dev/null || true
    return 1
  fi
  pid="$(record_number "$lock/owner" pid)"
  start="$(read_state_field "$lock/owner" process_start)"
  socket="$(read_state_field "$lock/owner" socket_path)"
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    current_start="$(process_start_token "$pid")"
    if [ "$socket" = "$SOCKET_PATH" ] && \
      { [ -z "$start" ] || [ "$start" = "$current_start" ]; }; then
      return 1
    fi
  fi
  [ "$(read_state_field "$lock/owner" owner_id)" = "$owner" ] || return 1
  rm -f "$lock/owner" 2>/dev/null
  rmdir "$lock" 2>/dev/null || true
  return 0
}

acquire_claim() {
  local lock="$1" attempts="$2" attempt=0 owner start owner_record
  while [ "$attempt" -lt "$attempts" ]; do
    attempt=$((attempt + 1))
    if mkdir "$lock" 2>/dev/null; then
      owner="$$.$RANDOM.$(now_seq)"
      start="$(process_start_token "$$")"
      owner_record="owner_id=$(encode_value "$owner")
pid=$$
process_start=$(encode_value "$start")
socket_path=$(encode_value "$SOCKET_PATH")"
      if ! atomic_write "$lock/owner" "$owner_record"; then
        rmdir "$lock" 2>/dev/null || true
        return 1
      fi
      claim_owner_id="$owner"
      return 0
    fi
    recover_claim "$lock" "$attempt" || true
    sleep 0.01
  done
  return 1
}

release_claim() {
  local lock="$1" owner="$2"
  [ -n "$owner" ] || return 0
  [ "$(read_state_field "$lock/owner" owner_id)" = "$owner" ] || return 0
  rm -f "$lock/owner" 2>/dev/null
  rmdir "$lock" 2>/dev/null || true
}

initialize_namespace() {
  local namespace socket_record reconcile_record
  namespace="$(namespace_dir)" || return 1
  mkdir -p "$namespace/panes" "$namespace/tasks" "$namespace/migration" 2>/dev/null || return 1
  socket_record="socket_path=$(encode_value "$SOCKET_PATH")"
  [ -f "$namespace/socket.state" ] || atomic_write "$namespace/socket.state" "$socket_record" || return 1
  reconcile_record="pending_generation=0
task_metadata_high_water=0
location_metadata_high_water=0
checkout_root=$(encode_value "")
repository_anchor=$(encode_value "")
retained_location=$(encode_value "")"
  [ -f "$namespace/reconcile.state" ] || \
    atomic_write "$namespace/reconcile.state" "$reconcile_record" || return 1
  return 0
}

# Agent and test harnesses can keep control pipes on descriptors above stderr.
# Detached descendants must not keep those pipes alive after their callback or
# test process has completed. Bash 3.2 reserves descriptor 255 for this script.
close_inherited_descriptors() {
  local descriptor fd
  for descriptor in /dev/fd/*; do
    fd="${descriptor##*/}"
    case "$fd" in
      0 | 1 | 2 | 255 | *[!0-9]*) continue ;;
    esac
    eval "exec ${fd}>&-" 2>/dev/null || true
  done
}

# Run a command with the prompt on stdin under a hard timeout. macOS ships no
# coreutils `timeout`, so a watchdog subshell SIGKILLs the engine on expiry.
run_with_timeout() {
  local secs="$1" infile="$2" outfile="$3"
  shift 3
  "$@" <"$infile" >"$outfile" 2>/dev/null &
  local pid=$!
  ( sleep "$secs"; kill -9 "$pid" ) >/dev/null 2>&1 &
  local watchdog=$!
  local rc=0
  wait "$pid" || rc=$?
  kill "$watchdog" >/dev/null 2>&1
  wait "$watchdog" 2>/dev/null
  return "$rc"
}

# ------------------------------------------------------------------- guards

command -v herdr >/dev/null 2>&1 || exit 0

# The sweep modes belong to no pane and no agent, and the herdr plugin that
# starts them runs outside an agent's environment, so they clear the guards
# below on their own: a reachable herdr CLI is all they need.
case "$mode" in
  sweep | sweep-daemon | ensure-daemon) ;;
  *)
    # Every entry point exits silently outside herdr, so the same files apply on
    # Linux/CI without a .chezmoiignore rule.
    [ "${HERDR_ENV:-}" = "1" ] || exit 0
    # Recursion guard: a naming call that itself fires agent hooks must not spawn
    # another worker.
    [ -z "${HERDR_TASK_SYNC_ACTIVE:-}" ] || exit 0
    [ -n "$pane" ] || exit 0
    [ -n "$SOCKET_PATH" ] || exit 0
    if [ "$worker_mode" -eq 0 ]; then
      [ -n "$agent" ] || exit 0
    fi
    ;;
esac

# ------------------------------------------------------------------- worker

read_state_field() {
  local file="$1" key="$2" encoded
  [ -f "$file" ] || return 0
  encoded="$(grep -m1 "^${key}=" "$file" 2>/dev/null | cut -d= -f2-)"
  [ -n "$encoded" ] || return 0
  printf '%s' "$encoded" | base64 -d 2>/dev/null || true
}

write_task_state() {
  local file="$1" generation="$2" slug="$3" first="$4" latest="$5" present="$6"
  local presentation_generation="${7:-0}" metadata_seq="${8:-0}"
  local content
  content="agent=$(encode_value "$agent")
pane=$(encode_value "$pane")
session=$(encode_value "$session")
generation=$generation
slug=$(encode_value "$slug")
first_prompt=$(encode_value "$first")
latest_prompt=$(encode_value "$latest")
presentation_required=$present
presentation_generation=$presentation_generation
metadata_seq=$metadata_seq"
  atomic_write "$file" "$content"
}

write_reconcile_state() {
  local file="$1" pending="$2" task_metadata="$3" location_metadata="$4"
  local checkout_root="$5" repository_anchor="$6" retained_location="$7" content
  content="pending_generation=$pending
task_metadata_high_water=$task_metadata
location_metadata_high_water=$location_metadata
checkout_root=$(encode_value "$checkout_root")
repository_anchor=$(encode_value "$repository_anchor")
retained_location=$(encode_value "$retained_location")"
  atomic_write "$file" "$content"
}

write_high_water() {
  local file="$1" generation="$2" committed="$3" metadata="$4" content
  content="generation=$generation
committed_generation=$committed
task_metadata_high_water=$metadata"
  atomic_write "$file" "$content"
}

write_control() {
  local file="$1" generation="$2" committed="$3" presentation="$4" metadata="$5"
  local kind="$6" value="$7" first="$8" content
  content="active_agent=$(encode_value "$agent")
active_session=$(encode_value "$session")
generation=$generation
committed_generation=$committed
presentation_generation=$presentation
task_metadata_high_water=$metadata
request_kind=$(encode_value "$kind")
request_value=$(encode_value "$value")
first_prompt=$(encode_value "$first")"
  atomic_write "$file" "$content"
}

legacy_record_complete() {
  local file="$1" key encoded
  [ -f "$file" ] || return 1
  for key in slug first_prompt latest_prompt; do
    grep -q "^${key}=" "$file" 2>/dev/null || return 1
    encoded="$(grep -m1 "^${key}=" "$file" 2>/dev/null | cut -d= -f2-)"
    printf '%s' "$encoded" | base64 -d >/dev/null 2>&1 || return 1
  done
  [ -n "$(read_state_field "$file" slug)" ]
}

import_legacy_state() {
  local task_file="$1" marker legacy slug first latest marker_record
  marker="$(migration_marker_file)"
  [ -f "$marker" ] && return 0
  marker_record="cutover=1"

  # A canonical record without its marker means a predecessor crashed between
  # those two atomic replacements. Keep the canonical record and finish only
  # the one-way cutover; a late legacy writer has no authority.
  if legacy_record_complete "$task_file"; then
    atomic_write "$marker" "$marker_record"
    return $?
  fi

  legacy="$(legacy_state_file_path)"
  if legacy_record_complete "$legacy"; then
    slug="$(read_state_field "$legacy" slug)"
    first="$(read_state_field "$legacy" first_prompt)"
    latest="$(read_state_field "$legacy" latest_prompt)"
    write_task_state "$task_file" 0 "$slug" "$first" "$latest" 0 0 0 || return 1
  fi
  # Malformed and absent legacy input also complete the cutover. This prevents
  # an old producer that writes later from entering canonical state.
  atomic_write "$marker" "$marker_record"
}

# A pane label opens with a short agent prefix, so several labels still fit
# in the tab label. Plain ASCII on purpose: the earlier Nerd Font glyph badges
# rendered as empty boxes on any terminal without a patched font. An agent
# with no prefix of its own falls back to its first letter.
pane_label() {
  local name="$1" slug="$2"
  case "$name" in
    claude) printf 'cc:%s' "$slug"; return 0 ;;
    opencode) printf 'oc:%s' "$slug"; return 0 ;;
    pi) printf 'pi:%s' "$slug"; return 0 ;;
    codex) printf 'cx:%s' "$slug"; return 0 ;;
  esac
  printf '%s:%s' \
    "$(LC_ALL=C printf '%s' "$name" | cut -c1 | tr '[:upper:]' '[:lower:]')" \
    "$slug"
}

# A pane running no agent is named after its command. The name comes from the
# leader of the foreground process group, never from the first entry of the
# list: the list runs from children up to the leader, so `bun run dev` reports
# a `node` child first and only the leader carries the command as typed.
#
# A pane whose foreground process group is the shell itself sits idle and gets
# no name. Arguments that start with `-` or `/` are dropped, because a flag or
# a path says nothing at a glance and eats the whole width.
pane_process_label() {
  local target="$1" info
  info="$(herdr pane process-info --pane "$target" 2>/dev/null)" || return 0
  [ -n "$info" ] || return 0
  printf '%s' "$info" | jq -r --argjson max "$PROC_LABEL_MAX_LEN" '
    def base: sub(".*/"; "");
    .result.process_info as $i
    | select($i.foreground_process_group_id != $i.shell_pid)
    | [$i.foreground_processes[]? | select(.pid == $i.foreground_process_group_id)][0]
    | select(. != null)
    | ((.argv // []) | if length == 0 then [(.argv0 // .name // "")] else . end) as $argv
    | ([($argv[0] // "") | base] + [$argv[1:3][] | select(test("^[-/]") | not)])
    | join(" ")
    | select(. != "")
    | if (length > $max) then (.[0:$max - 1] + "…") else . end
  ' 2>/dev/null
}

# Herdr stores one string per tab and composes nothing itself. The label is
# built from the panes of the tab: an agent pane contributes the label its
# naming call gave it, any other pane contributes its command.
#
# The command name is written back as that pane's label too, so it also shows
# on the pane border. A pane that falls idle becomes `~`. Both writes overwrite
# a name set by hand — only a pane running an agent is left alone.
#
# $1 = tab id, $2 = a `pane list` payload. Prints the composed label, or
# nothing when the tab holds no pane worth naming.
tab_label_for() {
  local tab_id="$1" panes="$2"
  local rows id agent_of label name parts="" named=0
  # The fields are joined with the unit separator, not a tab: a tab is IFS
  # whitespace, so `read` would collapse the empty agent field of a plain
  # command pane and shift its label into the wrong variable.
  rows="$(printf '%s' "$panes" | jq -r --arg t "$tab_id" \
    '.result.panes[] | select(.tab_id == $t)
     | [.pane_id, (.agent // ""), (.label // "")] | join("\u001f")' 2>/dev/null)"
  [ -n "$rows" ] || return 0

  # A here-doc rather than a pipe: a piped `while` runs in a subshell, and the
  # joined label built inside it would not survive the loop.
  while IFS="$(printf '\037')" read -r id agent_of label; do
    [ -n "$id" ] || continue
    if [ -n "$agent_of" ]; then
      name="$label"
    else
      name="$(pane_process_label "$id")"
      [ -n "$name" ] || name="$IDLE_PANE_LABEL"
      [ "$name" = "$label" ] || herdr pane rename "$id" "$name" >/dev/null 2>&1
    fi
    [ -n "$name" ] || continue
    [ "$name" = "$IDLE_PANE_LABEL" ] || named=1
    if [ -z "$parts" ]; then
      parts="$name"
    else
      parts="$parts$LABEL_SEPARATOR$name"
    fi
  done <<EOF
$rows
EOF

  # Status 1 says the tab holds no pane worth naming: every pane of it is idle.
  # The label is still printed, so a caller that has the tab's position can turn
  # it into a numbered placeholder instead of dropping the tab.
  printf '%s' "$parts"
  [ "$named" -eq 1 ] || return 1
  return 0
}

# The naming call refreshes the tab of the agent that just published a name, so
# that tab always holds one real name. An all-idle tab is left to the sweep,
# which knows the tab's position and can number the placeholder.
compose_tab_label() {
  command -v jq >/dev/null 2>&1 || return 0
  local panes tab_id label
  panes="$(herdr pane list 2>/dev/null)" || return 0
  tab_id="$(printf '%s' "$panes" \
    | jq -r --arg p "$pane" '.result.panes[] | select(.pane_id == $p) | .tab_id' 2>/dev/null)"
  [ -n "$tab_id" ] && [ "$tab_id" != "null" ] || return 0
  label="$(tab_label_for "$tab_id" "$panes")" || return 0
  [ -n "$label" ] || return 0
  herdr tab rename "$tab_id" "$label" >/dev/null 2>&1
}

# One pass over every tab herdr knows. A naming call refreshes only its own
# tab, so nothing notices a command that ends or an agent that quits. The sweep
# is that missing observer, and the daemon below repeats it.
#
# Both listings are fetched once per pass, and a tab is renamed only when its
# label really changed — a rename every few seconds would churn the tab row and
# the socket for nothing.
sweep_tabs() {
  command -v jq >/dev/null 2>&1 || return 1
  local panes tabs rows tab_id current index label
  panes="$(herdr pane list 2>/dev/null)" || return 1
  tabs="$(herdr tab list 2>/dev/null)" || return 1
  [ -n "$panes" ] && [ -n "$tabs" ] || return 1
  # Each row carries the tab's position inside its own workspace, counted in
  # listing order. A tab row shows one workspace at a time, so that position is
  # what makes a numbered placeholder unique where the eye can see it.
  rows="$(printf '%s' "$tabs" | jq -r '
    reduce .result.tabs[]? as $t ({counts: {}, out: []};
      ($t.workspace_id // "") as $ws
      | .counts[$ws] = ((.counts[$ws] // 0) + 1)
      | .out += [[$t.tab_id, ($t.label // ""), (.counts[$ws] | tostring)]])
    | .out[] | join("\u001f")' 2>/dev/null)"
  [ -n "$rows" ] || return 0
  while IFS="$(printf '\037')" read -r tab_id current index; do
    [ -n "$tab_id" ] || continue
    # An all-idle tab is named `~ <n>` rather than skipped: skipping froze its
    # last composed label, which then outlived the pane that produced it.
    if label="$(tab_label_for "$tab_id" "$panes")"; then
      [ -n "$label" ] || continue
    else
      label="$IDLE_PANE_LABEL $index"
    fi
    [ "$label" = "$current" ] && continue
    herdr tab rename "$tab_id" "$label" >/dev/null 2>&1
  done <<EOF
$rows
EOF
  return 0
}

# The sweep runs on a clock of its own rather than on herdr events, because the
# change that matters most has no event: a command started or ended inside a
# pane that already exists. The lock directory is created atomically, so a
# second daemon exits instead of doubling the rename traffic.
run_sweep_daemon() {
  mkdir -p "$STATE_DIR" 2>/dev/null || exit 0
  # A daemon started right after its predecessor was killed finds the lock still
  # there for a moment. Waiting a few seconds beats exiting, which would leave
  # the machine with no daemon at all until the next herdr event.
  local tries=0
  until mkdir "$SWEEP_LOCK_DIR" 2>/dev/null; do
    tries=$((tries + 1))
    [ "$tries" -ge 3 ] && exit 0
    sleep 1
  done
  printf '%s' "$$" > "$SWEEP_LOCK_DIR/pid" 2>/dev/null
  # Two traps, not one: a TERM handler that only cleans up would let the loop
  # carry on after it dropped its own lock, and the next hook would then start
  # a second daemon beside the first.
  #
  # The cleanup releases the lock only while this daemon still owns it. A
  # dying daemon that cleared its successor's lock left no daemon running.
  trap 'if [ "$(cat "$SWEEP_LOCK_DIR/pid" 2>/dev/null)" = "$$" ]; then
          rm -f "$SWEEP_LOCK_DIR/pid"
          rmdir "$SWEEP_LOCK_DIR" 2>/dev/null
        fi' EXIT
  trap 'exit 0' INT TERM
  local misses=0
  while :; do
    # Whoever holds the pid file owns the sweep. Losing it means another daemon
    # took over, and two daemons would rename every tab twice per interval.
    [ "$(cat "$SWEEP_LOCK_DIR/pid" 2>/dev/null)" = "$$" ] || exit 0
    if sweep_tabs; then
      misses=0
    else
      # herdr stopped answering: the server is gone, and with it the reason to
      # keep sweeping. Three misses rather than one, to ride out a restart.
      misses=$((misses + 1))
      [ "$misses" -ge 3 ] && exit 0
    fi
    sleep "$SWEEP_INTERVAL"
  done
}

# Called by the herdr plugin on startup and on agent-status events. A live
# daemon makes this a no-op; a lock left behind by a killed daemon is cleared.
ensure_sweep_daemon() {
  local self="$1" pid
  if [ -d "$SWEEP_LOCK_DIR" ]; then
    pid="$(cat "$SWEEP_LOCK_DIR/pid" 2>/dev/null)"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      return 0
    fi
    rm -f "$SWEEP_LOCK_DIR/pid" 2>/dev/null
    rmdir "$SWEEP_LOCK_DIR" 2>/dev/null
  fi
  # herdr reaps the process group of a plugin hook once the hook exits, and a
  # plain background child shares that group — it was killed within the second.
  # Job control puts the daemon in a process group of its own, out of reach.
  set -m
  nohup bash "$self" --sweep-daemon </dev/null >/dev/null 2>&1 &
  set +m
  return 0
}

publish() {
  herdr pane report-metadata "$pane" \
    --source "$SOURCE_ID" \
    --token "task=$1" \
    --seq "$seq" >/dev/null 2>&1
  herdr pane rename "$pane" "$(pane_label "$agent" "$1")" >/dev/null 2>&1
  compose_tab_label
}

# Claude Code writes one JSON object per line. Keep user entries that carry
# real prose: drop meta entries, tool results, and slash-command envelopes.
transcript_user_entries() {
  local path="$1"
  [ -f "$path" ] || return 0
  command -v jq >/dev/null 2>&1 || return 0
  jq -r '
    select(.type == "user")
    | select(.isMeta != true)
    | select(.agent_id == null)
    | .message.content
    | if type == "string" then .
      elif type == "array" then (map(select(.type == "text") | .text) | join("\n"))
      else empty end
  ' "$path" 2>/dev/null \
    | grep -v '^[[:space:]]*$' \
    | grep -v '^<' \
    | grep -v '^Caveat:' \
    || true
}

build_naming_prompt() {
  local previous="$1" first="$2" latest="$3"
  cat <<EOF
You name coding-agent sessions for a sidebar. Answer with the name only.

Output rules:
- 2 to 4 English words, lowercase, hyphen-separated, for example: cache-review
- no quotes, no punctuation, no explanation, no extra lines

Naming rules:
- Name the session's overall task, not the newest message.
- If the overall task has not changed, repeat the current name exactly.
- Acknowledgements and continuations ("continue", "продолжай", "да", "ok",
  "go on", "yes") never change the name.
- Change the name only when the session starts a different piece of work.
- With no current name, name the session from its first task.

Current name: ${previous:-(none)}

First prompt of the session:
${first:-(none)}

Latest prompt:
${latest:-(none)}
EOF
}

# The naming engine chain, isolated in one function per KTD1: one-shot pi
# first (faster and cheaper), then claude with a haiku-class model, then
# nothing. Prompts always travel on stdin, never as argv.
call_engine_chain() {
  local naming_prompt="$1"
  local infile outfile raw candidate
  infile="$(mktemp "${TMPDIR:-/tmp}/herdr-task-sync-in.XXXXXX")" || return 1
  outfile="$(mktemp "${TMPDIR:-/tmp}/herdr-task-sync-out.XXXXXX")" || {
    rm -f "$infile"
    return 1
  }
  printf '%s\n' "$naming_prompt" >"$infile"

  export HERDR_TASK_SYNC_ACTIVE=1
  cd "${TMPDIR:-/tmp}" 2>/dev/null || true

  if command -v pi >/dev/null 2>&1; then
    if run_with_timeout "$ENGINE_TIMEOUT" "$infile" "$outfile" \
      pi -p --model "$PI_MODEL" --thinking off \
      --no-tools --no-session --no-extensions --no-skills \
      --no-context-files --no-prompt-templates; then
      raw="$(cat "$outfile" 2>/dev/null)"
      candidate="$(normalize_slug "$(first_nonempty_line "$raw")")"
      if [ -n "$candidate" ] && [ "$(slug_word_count "$candidate")" -le "$SLUG_MAX_WORDS" ]; then
        rm -f "$infile" "$outfile"
        printf '%s' "$candidate"
        return 0
      fi
    fi
  fi

  if command -v claude >/dev/null 2>&1; then
    if run_with_timeout "$ENGINE_TIMEOUT" "$infile" "$outfile" \
      claude -p --model "$CLAUDE_MODEL"; then
      raw="$(cat "$outfile" 2>/dev/null)"
      candidate="$(normalize_slug "$(first_nonempty_line "$raw")")"
      if [ -n "$candidate" ] && [ "$(slug_word_count "$candidate")" -le "$SLUG_MAX_WORDS" ]; then
        rm -f "$infile" "$outfile"
        printf '%s' "$candidate"
        return 0
      fi
    fi
  fi

  rm -f "$infile" "$outfile"
  return 1
}

commit_task_result() {
  local control="$1" high_water="$2" task_file="$3" expected_generation="$4"
  local slug="$5" first="$6" latest="$7" presentation_required="$8"
  local lock owner current_generation current_agent current_session
  local presentation metadata request_kind request_value control_first
  local reconcile reconcile_lock reconcile_owner pending location_metadata
  local checkout_root repository_anchor retained_location now task_generation
  lock="$(pane_state_dir)/control.lock"
  acquire_claim "$lock" "$INBOX_LOCK_ATTEMPTS" || return 1
  owner="$claim_owner_id"

  current_generation="$(record_number "$control" generation)"
  current_agent="$(read_state_field "$control" active_agent)"
  current_session="$(read_state_field "$control" active_session)"
  if [ "$current_generation" != "$expected_generation" ] || \
    [ "$current_agent" != "$agent" ] || [ "$current_session" != "$session" ]; then
    release_claim "$lock" "$owner"
    return 2
  fi

  presentation="$(record_number "$control" presentation_generation)"
  metadata="$(max_number \
    "$(record_number "$control" task_metadata_high_water)" \
    "$(record_number "$high_water" task_metadata_high_water)")"
  request_kind="$(read_state_field "$control" request_kind)"
  request_value="$(read_state_field "$control" request_value)"
  control_first="$(read_state_field "$control" first_prompt)"

  if [ "$presentation_required" -eq 1 ]; then
    reconcile="$(namespace_dir)/reconcile.state"
    reconcile_lock="$(namespace_dir)/reconcile.lock"
    acquire_claim "$reconcile_lock" "$INBOX_LOCK_ATTEMPTS" || {
      release_claim "$lock" "$owner"
      return 1
    }
    reconcile_owner="$claim_owner_id"
    task_generation="$(record_number "$task_file" generation)"
    if [ "$task_generation" = "$expected_generation" ]; then
      presentation="$(record_number "$task_file" presentation_generation)"
      metadata="$(record_number "$task_file" metadata_seq)"
    fi
    if [ -z "$presentation" ] || [ "$presentation" -eq 0 ] || \
      [ -z "$metadata" ] || [ "$metadata" -eq 0 ]; then
      now="$(now_seq)"
      metadata="$(max_number \
        "$(record_number "$control" task_metadata_high_water)" \
        "$(record_number "$high_water" task_metadata_high_water)" \
        "$(record_number "$reconcile" task_metadata_high_water)" \
        "$expected_generation" "$now")"
      metadata=$((metadata + 1))
      presentation="$(max_number \
        "$(record_number "$reconcile" pending_generation)" "$metadata" "$now")"
      presentation=$((presentation + 1))
    fi
    pending="$(max_number \
      "$(record_number "$reconcile" pending_generation)" "$presentation")"
    metadata="$(max_number \
      "$(record_number "$reconcile" task_metadata_high_water)" "$metadata")"
    location_metadata="$(record_number "$reconcile" location_metadata_high_water)"
    checkout_root="$(read_state_field "$reconcile" checkout_root)"
    repository_anchor="$(read_state_field "$reconcile" repository_anchor)"
    retained_location="$(read_state_field "$reconcile" retained_location)"
  else
    reconcile=""
    reconcile_lock=""
    reconcile_owner=""
  fi

  write_task_state "$task_file" "$expected_generation" "$slug" "$first" "$latest" \
    "$presentation_required" "${presentation:-0}" "${metadata:-0}" || {
      [ -z "$reconcile_lock" ] || release_claim "$reconcile_lock" "$reconcile_owner"
      release_claim "$lock" "$owner"
      return 1
    }
  if [ -n "$reconcile" ]; then
    write_reconcile_state "$reconcile" "$pending" "$metadata" \
      "${location_metadata:-0}" "$checkout_root" "$repository_anchor" \
      "$retained_location" || {
        release_claim "$reconcile_lock" "$reconcile_owner"
        release_claim "$lock" "$owner"
        return 1
      }
    release_claim "$reconcile_lock" "$reconcile_owner"
  fi
  write_high_water "$high_water" "$expected_generation" "$expected_generation" "$metadata" || {
    release_claim "$lock" "$owner"
    return 1
  }
  write_control "$control" "$expected_generation" "$expected_generation" \
    "$presentation" "$metadata" "$request_kind" "$request_value" "$control_first" || {
      release_claim "$lock" "$owner"
      return 1
    }
  release_claim "$lock" "$owner"
  return 0
}

run_worker() {
  local pane_dir control high_water worker_lock worker_owner
  local generation committed kind value first latest previous slug naming_prompt
  local task_file task_generation presentation_required commit_status abort_worker
  initialize_namespace || exit 0
  pane_dir="$(pane_state_dir)"
  mkdir -p "$pane_dir" 2>/dev/null || exit 0
  control="$pane_dir/control.state"
  high_water="$pane_dir/high-water.state"
  worker_lock="$pane_dir/worker.claim"
  umask 077
  find "$(namespace_dir)/tasks" -type f -name '*.state' \
    -mtime "+$STATE_MAX_AGE_DAYS" -delete 2>/dev/null

  while :; do
    acquire_claim "$worker_lock" "$INBOX_LOCK_ATTEMPTS" || exit 0
    worker_owner="$claim_owner_id"
    abort_worker=0

    while :; do
      generation="$(record_number "$control" generation)"
      committed="$(record_number "$control" committed_generation)"
      [ -n "$generation" ] || break
      [ "${committed:-0}" -lt "$generation" ] || break

      agent="$(read_state_field "$control" active_agent)"
      session="$(read_state_field "$control" active_session)"
      kind="$(read_state_field "$control" request_kind)"
      value="$(read_state_field "$control" request_value)"
      first="$(read_state_field "$control" first_prompt)"
      if [ -z "$agent" ] || [ -z "$session" ]; then
        abort_worker=1
        break
      fi
      task_file="$(task_state_file)"
      task_generation="$(record_number "$task_file" generation)"

      if [ "$task_generation" = "$generation" ] && \
        [ "$(read_state_field "$task_file" agent)" = "$agent" ] && \
        [ "$(read_state_field "$task_file" session)" = "$session" ]; then
        slug="$(read_state_field "$task_file" slug)"
        first="$(read_state_field "$task_file" first_prompt)"
        latest="$(read_state_field "$task_file" latest_prompt)"
        presentation_required="$(record_number "$task_file" presentation_required)"
        [ -n "$presentation_required" ] || presentation_required=0
      else
        previous="$(read_state_field "$task_file" slug)"
        case "$kind" in
          set)
            slug="$(normalize_slug "$value")"
            latest="$(read_state_field "$task_file" latest_prompt)"
            [ -n "$first" ] || first="$(read_state_field "$task_file" first_prompt)"
            if [ -n "$slug" ]; then
              presentation_required=1
            else
              slug="$previous"
              presentation_required=0
            fi
            ;;
          prompt | transcript)
            latest="$value"
            naming_prompt="$(build_naming_prompt "$previous" "$first" "$latest")"
            slug="$(call_engine_chain "$naming_prompt")" || slug=""
            if [ -n "$slug" ]; then
              presentation_required=1
            else
              # Model failure commits the newest context but retains the prior
              # semantic slug and does not request redundant presentation.
              slug="$previous"
              presentation_required=0
            fi
            ;;
          *)
            abort_worker=1
            break
            ;;
        esac
      fi

      if commit_task_result "$control" "$high_water" "$task_file" "$generation" \
        "$slug" "$first" "$latest" "$presentation_required"; then
        commit_status=0
      else
        commit_status=$?
      fi
      # Status 2 means a newer committed inbox generation or native session
      # superseded this model result. Read the inbox again without side effects.
      if [ "$commit_status" -eq 1 ]; then
        abort_worker=1
        break
      fi
      if [ "$commit_status" -eq 0 ] && [ "$presentation_required" -eq 1 ] && \
        [ -n "$slug" ]; then
        if [ "$(record_number "$control" generation)" = "$generation" ] && \
          [ "$(record_number "$control" committed_generation)" = "$generation" ] && \
          [ "$(read_state_field "$control" active_agent)" = "$agent" ] && \
          [ "$(read_state_field "$control" active_session)" = "$session" ]; then
          seq="$(record_number "$control" task_metadata_high_water)"
          publish "$slug"
        fi
      fi
    done

    release_claim "$worker_lock" "$worker_owner"
    [ "$abort_worker" -eq 0 ] || exit 0
    generation="$(record_number "$control" generation)"
    committed="$(record_number "$control" committed_generation)"
    [ -n "$generation" ] && [ "${committed:-0}" -lt "$generation" ] || exit 0
    # Reacquire after release. An enqueue racing the quiescence edge is either
    # handled here or by the worker it starts; no pending generation is lost.
  done
}

# `$0` is a bare name when the script came from PATH, and a re-entry must run
# even when the file has no execute bit (a chezmoi source checkout, or a test
# running it in place), so every re-entry goes through `bash <resolved path>`.
script_path() {
  local self="$0"
  case "$self" in
    */*) ;;
    *) self="$(command -v "$self" 2>/dev/null)" ;;
  esac
  [ -n "$self" ] || return 1
  printf '%s' "$self"
}

case "$mode" in
  sweep | sweep-daemon | ensure-daemon)
    [ -n "$SOCKET_PATH" ] || exit 0
    initialize_namespace || exit 0
    SWEEP_LOCK_DIR="$(namespace_dir)/sweep.lock"
    ;;
esac

case "$mode" in
  sweep)
    sweep_tabs
    exit 0
    ;;
  sweep-daemon)
    close_inherited_descriptors
    run_sweep_daemon
    exit 0
    ;;
  ensure-daemon)
    ensure_sweep_daemon "$(script_path)"
    exit 0
    ;;
esac

if [ "$worker_mode" -eq 1 ]; then
  close_inherited_descriptors
  run_worker
  exit 0
fi

# -------------------------------------------------------------- entry point

[ -n "$session" ] || exit 0

prompt=""
if [ ! -t 0 ]; then
  prompt="$(cat 2>/dev/null)"
fi

request_kind=""
request_value=""
request_first=""
if [ -n "$set_name" ]; then
  request_kind="set"
  request_value="$set_name"
elif [ -n "$(printf '%s' "$prompt" | tr -d '[:space:]')" ]; then
  request_kind="prompt"
  request_value="$prompt"
elif [ -n "$transcript" ]; then
  entries="$(transcript_user_entries "$transcript")"
  [ -n "$entries" ] || exit 0
  request_kind="transcript"
  request_first="$(printf '%s\n' "$entries" | head -1)"
  request_value="$(printf '%s\n' "$entries" | tail -1)"
else
  exit 0
fi

mkdir -p "$STATE_DIR" 2>/dev/null || exit 0
chmod 700 "$STATE_DIR" 2>/dev/null
umask 077
initialize_namespace || exit 0

pane_dir="$(pane_state_dir)"
mkdir -p "$pane_dir" 2>/dev/null || exit 0
control="$pane_dir/control.state"
high_water="$pane_dir/high-water.state"
control_lock="$pane_dir/control.lock"
task_file="$(task_state_file)"

# The callback waits only for this bounded claim and two atomic replacements.
# Model and presentation work starts after the durable inbox generation exists.
acquire_claim "$control_lock" "$INBOX_LOCK_ATTEMPTS" || exit 0
inbox_owner="$claim_owner_id"
if ! import_legacy_state "$task_file"; then
  release_claim "$control_lock" "$inbox_owner"
  exit 0
fi

old_agent="$(read_state_field "$control" active_agent)"
old_session="$(read_state_field "$control" active_session)"
control_first="$(read_state_field "$control" first_prompt)"
task_first="$(read_state_field "$task_file" first_prompt)"
if [ "$request_kind" = "transcript" ]; then
  first="$request_first"
elif [ "$old_agent" = "$agent" ] && [ "$old_session" = "$session" ] && \
  [ -n "$control_first" ]; then
  first="$control_first"
elif [ -n "$task_first" ]; then
  first="$task_first"
elif [ "$request_kind" = "prompt" ]; then
  first="$request_value"
else
  first=""
fi

generation="$(max_number \
  "$(record_number "$control" generation)" \
  "$(record_number "$high_water" generation)" \
  "$(record_number "$task_file" generation)" \
  "$(now_seq)")"
generation=$((generation + 1))
committed="$(max_number \
  "$(record_number "$control" committed_generation)" \
  "$(record_number "$high_water" committed_generation)")"
presentation="$(record_number "$control" presentation_generation)"
metadata="$(max_number \
  "$(record_number "$control" task_metadata_high_water)" \
  "$(record_number "$high_water" task_metadata_high_water)")"

# Advancing the high-water record before the inbox can consume a generation on
# write failure, but it cannot accept a request that was never atomically stored.
if ! write_high_water "$high_water" "$generation" "$committed" "$metadata" || \
  ! write_control "$control" "$generation" "$committed" "$presentation" \
    "$metadata" "$request_kind" "$request_value" "$first"; then
  release_claim "$control_lock" "$inbox_owner"
  exit 0
fi
release_claim "$control_lock" "$inbox_owner"

[ -z "${HERDR_TASK_SYNC_TEST_NO_WORKER:-}" ] || exit 0
self="$(script_path)" || exit 0
[ -n "$self" ] || exit 0

# `bash "$self"` works from a non-executable chezmoi source checkout. The
# claimed worker reads the inbox rather than request argv, so every completion
# is fenced against the latest active native session and committed generation.
nohup bash "$self" --worker --pane "$pane" </dev/null >/dev/null 2>&1 &

exit 0
