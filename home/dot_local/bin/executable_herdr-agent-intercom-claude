#!/usr/bin/env bash

set -euo pipefail

claude_command="${AGENT_INTERCOM_CLAUDE_COMMAND:-}"
arg_count="${AGENT_INTERCOM_CLAUDE_ARGC:-}"
if [[ -z "$claude_command" || ! -x "$claude_command" || ! "$arg_count" =~ ^[0-9]+$ ]]; then
  printf 'herdr-agent-intercom: invalid Claude bridge environment\n' >&2
  exit 1
fi

original_args=()
arg_index=0
while [[ "$arg_index" -lt "$arg_count" ]]; do
  arg_name="AGENT_INTERCOM_CLAUDE_ARG_$arg_index"
  if ! declare -p "$arg_name" >/dev/null 2>&1; then
    printf 'herdr-agent-intercom: missing Claude argument %s\n' "$arg_index" >&2
    exit 1
  fi
  original_args+=("${!arg_name}")
  unset "$arg_name"
  arg_index=$((arg_index + 1))
done
unset AGENT_INTERCOM_CLAUDE_COMMAND AGENT_INTERCOM_CLAUDE_ARGC

# Keep cci's generated controls before a native `--` terminator. Without this
# split Claude reads the Intercom plugin and identity prompt as user messages.
before_terminator=()
after_terminator=()
found_terminator=0
set +u
for arg in "${original_args[@]}"; do
  if [[ "$found_terminator" -eq 0 && "$arg" == "--" ]]; then
    found_terminator=1
  fi
  if [[ "$found_terminator" -eq 0 ]]; then
    before_terminator+=("$arg")
  else
    after_terminator+=("$arg")
  fi
done

# Generated identity and permission controls come last among native options,
# so the managed Herdr posture wins if a caller supplies a conflicting value.
exec "$claude_command" "${before_terminator[@]}" "$@" "${after_terminator[@]}"
