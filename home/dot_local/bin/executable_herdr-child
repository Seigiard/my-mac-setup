#!/usr/bin/env bash
# herdr-child — launch and coordinate child agents in sibling herdr panes.
# Cross-module configuration is initialized here and consumed by sourced modules.
# shellcheck disable=SC2034

set -euo pipefail

SCRIPT_DIR="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=home/dot_local/lib/herdr-process.sh
source "$SCRIPT_DIR/../lib/herdr-process.sh"
# shellcheck source=home/dot_local/lib/herdr-aliases.sh
source "$SCRIPT_DIR/../lib/herdr-aliases.sh"
# shellcheck source=home/dot_local/lib/herdr-child-runtime.sh
source "$SCRIPT_DIR/../lib/herdr-child-runtime.sh"
# shellcheck source=home/dot_local/lib/herdr-child-supervision.sh
source "$SCRIPT_DIR/../lib/herdr-child-supervision.sh"
# shellcheck source=home/dot_local/lib/herdr-child-watcher.sh
source "$SCRIPT_DIR/../lib/herdr-child-watcher.sh"
# shellcheck source=home/dot_local/lib/herdr-child-launch.sh
source "$SCRIPT_DIR/../lib/herdr-child-launch.sh"
# shellcheck source=home/dot_local/lib/herdr-child-continuation.sh
source "$SCRIPT_DIR/../lib/herdr-child-continuation.sh"
# shellcheck source=home/dot_local/lib/herdr-child-reap.sh
source "$SCRIPT_DIR/../lib/herdr-child-reap.sh"

SOURCE_ID="child-agent"
TAB_SOURCE_ID="child-agent-tab"
WAITING_TTL_MS=3600000
SUPERVISED_TTL_MS=90000
DEFAULT_SUPERVISION_TIMEOUT=3600000
MAX_SUPERVISION_TIMEOUT=86400000
STATE_DIR="${HERDR_CHILD_STATE_DIR:-$HOME/.cache/herdr-child}"
POLL_INTERVAL="${HERDR_CHILD_POLL_INTERVAL:-0.5}"
# Spacing between agent-start retries after herdr reports agent_pane_busy.
PANE_BUSY_RETRY_DELAY="${HERDR_CHILD_PANE_BUSY_RETRY_DELAY:-1}"
MAX_DELIVERY_RETRIES="${HERDR_CHILD_MAX_DELIVERY_RETRIES:-12}"
DELIVERY_RETRY_INITIAL="${HERDR_CHILD_DELIVERY_RETRY_INITIAL:-1}"
DELIVERY_RETRY_MAX="${HERDR_CHILD_DELIVERY_RETRY_MAX:-15}"
WAIT_SLICE_MS="${HERDR_CHILD_WAIT_SLICE_MS:-30000}"

[ $# -gt 0 ] || { usage; exit 2; }
command="$1"
shift
case "$command" in
  start) start_child "$@" ;;
  __watcher) watch_child "$@" ;;
  ask) ask_parent "$@" ;;
  verify) verify_pair "$@" ;;
  reply) reply_child "$@" ;;
  prompt) prompt_child "$@" ;;
  reap) reap_children "$@" ;;
  -h|--help) usage ;;
  *) fail_usage "unknown subcommand: $command" ;;
esac
