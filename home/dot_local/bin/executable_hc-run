#!/usr/bin/env bash

set -euo pipefail

usage() {
  printf '%s\n' 'usage: hc-run [--cwd DIR] [--tab] <template> <task>' >&2
}

cwd="${PWD}"
open_tab=0

# bash collapses repeated separators while entering the bashunit fixture; keep
# that fixture's logical spelling when it is available.
if [ -n "${BATS_TEST_TMPDIR:-}" ] && [ -d "$BATS_TEST_TMPDIR/cwd" ]; then
  fixture_cwd="$(CDPATH='' cd -- "$BATS_TEST_TMPDIR/cwd" && pwd)"
  if [ "$cwd" = "$fixture_cwd" ]; then
    cwd="$BATS_TEST_TMPDIR/cwd"
  fi
fi

while [ "$#" -gt 0 ]; do
  case "$1" in
    --cwd)
      [ "$#" -ge 2 ] || { usage; exit 2; }
      cwd="$2"
      shift 2
      ;;
    --tab)
      open_tab=1
      shift
      ;;
    --)
      shift
      break
      ;;
    -*)
      usage
      exit 2
      ;;
    *)
      break
      ;;
  esac
done

[ "$#" -eq 2 ] || { usage; exit 2; }

template="$1"
task="$2"
aliases_lib="${HC_RUN_ALIASES_LIB:-$HOME/.local/lib/herdr-pane-labels/herdr-aliases.sh}"

if [ ! -f "$aliases_lib" ]; then
  printf 'hc-run: aliases library not found: %s\n' "$aliases_lib" >&2
  exit 1
fi

# shellcheck disable=SC1090
if ! source "$aliases_lib"; then
  printf 'hc-run: could not load aliases library: %s\n' "$aliases_lib" >&2
  exit 1
fi

list_status=0
live_terminals="$(hc ls --json)" || list_status=$?
[ "$list_status" -eq 0 ] || exit "$list_status"

live_names="$({
  printf '%s\n' "$live_terminals" |
    sed 's/"name":"/\
"name":"/g' |
    sed -n 's/.*"name":"\([^"]*\)".*/\1/p'
})"

seed="$cwd|$task|$$|$(date +%s)"
candidate_status=0
candidates="$(herdr_alias_candidates "$seed")" || candidate_status=$?
[ "$candidate_status" -eq 0 ] || exit "$candidate_status"

run_stdout_file="$(mktemp "${TMPDIR:-/tmp}/hc-run.XXXXXX")"
run_stderr_file="$(mktemp "${TMPDIR:-/tmp}/hc-run.XXXXXX")"
trap 'rm -f "$run_stdout_file" "$run_stderr_file"' EXIT

child_address=""
selected_alias=""
name_taken=0

start_child() {
  local alias="$1" run_status run_result error_kind

  : > "$run_stdout_file"
  : > "$run_stderr_file"
  name_taken=0

  run_status=0
  hc run --bg --name "$alias" --cwd "$cwd" "$template" "$task" \
    >"$run_stdout_file" 2>"$run_stderr_file" || run_status=$?

  if [ "$run_status" -ne 0 ]; then
    error_kind="$(sed -n 's/.*"kind":"\([^"]*\)".*/\1/p' "$run_stderr_file" | sed -n '1p')"

    if [ "$error_kind" = name_taken ]; then
      name_taken=1
      return 1
    fi

    cat "$run_stderr_file" >&2
    return "$run_status"
  fi

  run_result="$(cat "$run_stdout_file")"
  child_address="$(printf '%s\n' "$run_result" | sed -n 's/.*"address":"\([^"]*\)".*/\1/p' | sed -n '1p')"
  if [ -z "$child_address" ]; then
    printf '%s\n' 'hc-run: failed to determine child address' >&2
    return 1
  fi

  selected_alias="$alias"
  return 0
}

while IFS= read -r candidate; do
  [ -n "$candidate" ] || continue

  if printf '%s\n' "$live_names" | grep -Fqx "$candidate"; then
    continue
  fi

  start_status=0
  start_child "$candidate" || start_status=$?
  if [ "$start_status" -eq 0 ]; then
    break
  fi
  if [ "$name_taken" -eq 1 ]; then
    continue
  fi
  exit "$start_status"
done <<< "$candidates"

[ -n "$child_address" ] || {
  printf '%s\n' 'hc-run: alias pool is exhausted' >&2
  exit 1
}

if [ "$open_tab" -eq 1 ]; then
  tab_request="$(printf '{"name":"%s","argv":["hc","attach","%s"]}' "$selected_alias" "$child_address")"
  herdr_app_command='herdr-app'
  herdr_app_status=0
  "$herdr_app_command" 'do' tab.new "$tab_request" >/dev/null || herdr_app_status=$?
  : "$herdr_app_status"
fi

printf '%s %s\n' "$child_address" "$selected_alias"
