#!/usr/bin/env bash

set -euo pipefail

usage() {
  printf '%s\n' 'usage: hc-run [--cwd DIR] [--tab] <template> <task>' >&2
}

cwd="$PWD"
open_tab=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    --cwd)
      [ "$#" -ge 2 ] || { usage; exit 2; }
      cwd="$2"
      shift 2
      ;;
    --tab)
      open_tab=1
      shift
      ;;
    --)
      shift
      break
      ;;
    -*)
      usage
      exit 2
      ;;
    *)
      break
      ;;
  esac
done

[ "$#" -eq 2 ] || { usage; exit 2; }

template="$1"
task="$2"
aliases_lib="${HC_RUN_ALIASES_LIB:-$HOME/.local/lib/herdr-pane-labels/herdr-aliases.sh}"

if [ ! -f "$aliases_lib" ]; then
  printf 'hc-run: aliases library not found: %s\n' "$aliases_lib" >&2
  exit 1
fi

# shellcheck disable=SC1090
if ! source "$aliases_lib"; then
  printf 'hc-run: could not load aliases library: %s\n' "$aliases_lib" >&2
  exit 1
fi

list_status=0
live_terminals="$(hc ls --json)" || list_status=$?
[ "$list_status" -eq 0 ] || exit "$list_status"

live_names="$({
  printf '%s\n' "$live_terminals" |
    sed 's/"name":"/\
"name":"/g' |
    sed -n 's/.*"name":"\([^"]*\)".*/\1/p'
})"

seed="$cwd|$task|$$|$(date +%s)"
candidate_status=0
candidates="$(herdr_alias_candidates "$seed")" || candidate_status=$?
[ "$candidate_status" -eq 0 ] || exit "$candidate_status"

run_stdout_file="$(mktemp "${TMPDIR:-/tmp}/hc-run.XXXXXX")"
run_stderr_file="$(mktemp "${TMPDIR:-/tmp}/hc-run.XXXXXX")"
tab_stderr_file="$(mktemp "${TMPDIR:-/tmp}/hc-run.XXXXXX")"
trap 'rm -f "$run_stdout_file" "$run_stderr_file" "$tab_stderr_file"' EXIT

child_address=""
selected_alias=""
first_message_sent=""
launch_turn=0
name_taken=0

start_confirmation_timeout="${HC_RUN_START_CONFIRM_TIMEOUT:-5}"
start_confirmation_poll_interval="${HC_RUN_START_CONFIRM_POLL_INTERVAL:-0.1}"

start_child() {
  local alias="$1" run_status run_result error_kind

  : > "$run_stdout_file"
  : > "$run_stderr_file"
  name_taken=0

  run_status=0
  hc run --bg --name "$alias" --cwd "$cwd" "$template" "$task" \
    >"$run_stdout_file" 2>"$run_stderr_file" || run_status=$?

  if [ "$run_status" -ne 0 ]; then
    error_kind="$(sed -n 's/.*"kind":"\([^"]*\)".*/\1/p' "$run_stderr_file" | sed -n '1p')"

    if [ "$error_kind" = name_taken ]; then
      name_taken=1
      return 1
    fi

    cat "$run_stderr_file" >&2
    return "$run_status"
  fi

  run_result="$(cat "$run_stdout_file")"
  child_address="$(printf '%s\n' "$run_result" | sed -n 's/.*"address":"\([^"]*\)".*/\1/p' | sed -n '1p')"
  if [ -z "$child_address" ]; then
    printf '%s\n' 'hc-run: failed to determine child address' >&2
    return 1
  fi

  if first_message_sent="$({
    python3 -c '
import json
import sys

raw = sys.stdin.read().lstrip()
message = json.JSONDecoder().raw_decode(raw)[0].get("first_message")
print("false" if isinstance(message, dict) and message.get("sent") is False else "")
' <<< "$run_result"
  })"; then
    :
  else
    first_message_sent=""
  fi

  if launch_turn="$({
    python3 -c '
import json
import sys

raw = sys.stdin.read().lstrip()
try:
    value = json.JSONDecoder().raw_decode(raw)[0].get("turn", 0)
except (ValueError, TypeError):
    value = 0
print(value if isinstance(value, int) and value >= 0 else 0)
' <<< "$run_result"
  })"; then
    :
  else
    launch_turn=0
  fi

  selected_alias="$alias"
  return 0
}

monotonic_seconds() {
  python3 -c 'import time; print(time.monotonic())'
}

child_snapshot() {
  python3 -c '
import json
import sys

try:
    payload = json.load(sys.stdin)
except (ValueError, TypeError):
    raise SystemExit(1)

status = payload.get("status") or {}
state = status.get("state") or payload.get("state") or ""
turn = payload.get("turn", 0)
if not isinstance(turn, int) or turn < 0:
    turn = 0
print("{} {}".format(state, turn))
'
}

is_task_draft() {
  HC_RUN_TASK="$task" python3 -c '
import json
import os
import re
import sys

try:
    payload = json.load(sys.stdin)
except (ValueError, TypeError):
    raise SystemExit(1)

if payload.get("complete") is not True or payload.get("how") != "screen":
    raise SystemExit(1)

text = payload.get("text")
task = os.environ.get("HC_RUN_TASK", "")
if not isinstance(text, str):
    raise SystemExit(1)

has_pasted_draft = re.search(r"\[Pasted ~[0-9]+ lines?\]", text) is not None
has_task_draft = bool(task) and task in text
has_dialog = re.search(
    r"(?im)^\s*(?:[┃│|]\s*)?(?:trust(?: this (?:folder|workspace))?|allow|permission|confirm|question)\b",
    text,
) is not None

raise SystemExit(0 if (has_pasted_draft or has_task_draft) and not has_dialog else 1)
'
}

confirm_child_started() {
  local started_at deadline now snapshot state turn read_result
  local enter_attempted=0

  started_at="$(monotonic_seconds)"
  deadline="$(python3 -c 'import sys; print(float(sys.argv[1]) + float(sys.argv[2]))' "$started_at" "$start_confirmation_timeout")"

  while :; do
    if read_result="$(hc get --json "$child_address" 2>/dev/null)" &&
      snapshot="$(printf '%s\n' "$read_result" | child_snapshot 2>/dev/null)"; then
      state="${snapshot%% *}"
      turn="${snapshot#* }"

      if [ "$state" = working ] || [ "$turn" -gt "$launch_turn" ]; then
        return 0
      fi

      if [ "$state" = blocked ] || [ "$state" = error ] || [ "$state" = finished ]; then
        return 1
      fi

      if [ "$state" = idle ] && [ "$turn" -eq "$launch_turn" ] && [ "$enter_attempted" -eq 0 ]; then
        if read_result="$(hc read --json "$child_address" 2>/dev/null)" &&
          printf '%s\n' "$read_result" | is_task_draft; then
          enter_attempted=1
          hc keys "$child_address" enter >/dev/null 2>&1 || :
        fi
      fi
    fi

    now="$(monotonic_seconds)"
    if python3 -c 'import sys; raise SystemExit(0 if float(sys.argv[1]) >= float(sys.argv[2]) else 1)' "$now" "$deadline"; then
      return 1
    fi
    sleep "$start_confirmation_poll_interval"
  done
}

while IFS= read -r candidate; do
  [ -n "$candidate" ] || continue

  if printf '%s\n' "$live_names" | grep -Fqx "$candidate"; then
    continue
  fi

  start_status=0
  start_child "$candidate" || start_status=$?
  if [ "$start_status" -eq 0 ]; then
    break
  fi
  if [ "$name_taken" -eq 1 ]; then
    continue
  fi
  exit "$start_status"
done <<< "$candidates"

[ -n "$child_address" ] || {
  printf '%s\n' 'hc-run: alias pool is exhausted' >&2
  exit 1
}

if [ "$open_tab" -eq 1 ]; then
  tab_request="$(printf '{"name":"%s","argv":["hc","attach","%s"]}' "$selected_alias" "$child_address")"
  if ! herdr-app 'do' tab.new "$tab_request" >/dev/null 2>"$tab_stderr_file"; then
    printf 'hc-run: could not open a tab: %s\n' "$(cat "$tab_stderr_file")" >&2
  fi
fi

printf '%s %s\n' "$child_address" "$selected_alias"
if [ "$first_message_sent" = false ]; then
  printf 'hc-run: task not sent: hc read %s\n' "$child_address" >&2
  exit 3
fi

if ! confirm_child_started; then
  printf 'hc-run: task sent but not started: hc read %s\n' "$child_address" >&2
  exit 3
fi
