{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "~/.config/agents/writing-style.md"
  ],
  "permission": {
    "external_directory": {
      "*": "allow"
    }
  },
  "compaction": {
    "prune": true
  },
  "agent": {
    "build": {
      "model": "openai/gpt-6.1-sol",
      "variant": "medium"
    }
  },
  "mcp": {
    "fff": {
      "type": "local",
      "command": [
        "fff-mcp"
      ],
      "enabled": true
    },
    "executor": {
      "type": "local",
      "command": [
        "executor",
        "mcp"
      ],
      "enabled": true
    },
    "memex": {
      "type": "local",
      "command": [
        "memex",
        "mcp",
        "--transport",
        "stdio"
      ],
      "enabled": true
    },
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp",
      "enabled": true
    },
    "tavily-mcp": {
      "type": "remote",
      "url": "https://mcp.tavily.com/mcp/?tavilyApiKey={env:TAVILY_API_KEY}",
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@0.0.83"
      ],
      "enabled": true
    }
  },
  "provider": {
    "openrouter": {
      "models": {
        "cohere/north-mini-code:free": {},
        "thinkingmachines/inkling-small:free": {},
        "nvidia/nemotron-3.5-lightning:free": {},
        "nex-agi/nex-n2.5-mini:free": {}
      }
    }
  }
}
