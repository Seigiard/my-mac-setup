{
  "instructions": [
    "~/.config/agents/writing-style.md"
  ],
  "permissions": [
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "agents": {
    "build": {
      "model": {
        "providerID": "openai",
        "model": "gpt-6.1-sol",
        "variant": "medium"
      }
    }
  },
  "mcp": {
    "servers": {
      "fff": {
        "type": "local",
        "command": [
          "fff-mcp"
        ],
        "disabled": false,
        "codemode": true
      },
      "executor": {
        "type": "local",
        "command": [
          "executor",
          "mcp"
        ],
        "disabled": false,
        "codemode": true
      },
      "memex": {
        "type": "local",
        "command": [
          "memex",
          "mcp",
          "--transport",
          "stdio"
        ],
        "disabled": false,
        "codemode": true
      },
      "deepwiki": {
        "type": "remote",
        "url": "https://mcp.deepwiki.com/mcp",
        "disabled": false,
        "codemode": true
      },
      "tavily-mcp": {
        "type": "remote",
        "url": "https://mcp.tavily.com/mcp/?tavilyApiKey={env:TAVILY_API_KEY}",
        "disabled": false,
        "codemode": true
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@0.0.83"
        ],
        "disabled": false,
        "codemode": true
      }
    }
  },
  "providers": {
    "openrouter": {
      "models": {
        "cohere/north-mini-code:free": {},
        "thinkingmachines/inkling-small:free": {},
        "nvidia/nemotron-3.5-lightning:free": {},
        "nex-agi/nex-n2.5-mini:free": {}
      }
    }
  }
}
