font-family = IosevkaTerm Nerd Font
#font-family = JetBrains Mono
#font-family = Rec Mono Duotone
font-size = 18

#theme = Flexoki Dark
theme = Flexoki Light
#theme = Subliminal
#theme = Violet Dark
#theme = Violet Light
cursor-style = block

shell-integration = zsh
shell-integration-features = no-cursor,sudo,title

unfocused-split-opacity = 0.7

window-inherit-working-directory = true

mouse-hide-while-typing = true
mouse-scroll-multiplier = 0.5
#mouse-scroll-multiplier = 2

macos-option-as-alt = right

quit-after-last-window-closed=true
window-save-state = always
macos-titlebar-style = hidden
window-colorspace = "display-p3"
window-new-tab-position = "end"
window-padding-balance = true
window-padding-x = 0
window-padding-y = 0

clipboard-trim-trailing-spaces = true
# copy-on-select = clipboard silently replaced the system clipboard on
# every mouse selection (accidental focus-click drags included), making
# cmd+v "randomly" paste garbage. Copying is explicit now: select, cmd+c.
copy-on-select = false

font-feature = -calt
font-feature = -liga
font-feature = -dlig

#term = xterm-256color
term = xterm-ghostty

# KEYBINDINGS
keybind = shift+enter=text:\x1b[13;2u
keybind = ctrl+key_c=text:\x03
