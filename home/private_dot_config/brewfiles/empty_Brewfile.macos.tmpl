{{- /* CI-minimal render guard. See docs/plans/2026-08-20-2217-perf-ci-minimal-brew-install-plan.md */ -}}
{{- /*                                                                                                */ -}}
{{- /* The guard covers the whole file: no test in tests/ references any cask                         */ -}}
{{- /* here, nor elio, terminal-notifier or linear. On push/PR CI this                                */ -}}
{{- /* renders to zero bytes; see the note below. The casks are 291 s of the                         */ -}}
{{- /* 400 s macOS apply step, so this file is where nearly all of the saving is.                     */ -}}
{{- /*                                                                                                */ -}}
{{- /* See Brewfile.tmpl for why the flag is read with `get` rather than as                           */ -}}
{{- /* `.ci_minimal`, and for why every comment here is a template comment.                           */ -}}
{{- /*                                                                                                */ -}}
{{- /* The `empty_` prefix on this file's name is load-bearing, not decoration.                       */ -}}
{{- /* chezmoi deletes a file whose template renders to nothing unless the source                     */ -}}
{{- /* name carries that attribute, and the minimal render here is exactly zero                       */ -}}
{{- /* bytes. `brew bundle` is perfectly happy with an empty file — the problem                       */ -}}
{{- /* is that without the attribute there is no file at all, so the apply dies                       */ -}}
{{- /* on the next line of run_onchange_after_1 with "No Brewfile found".                             */ -}}
{{- /* chezmoi strips the attribute from the target path, so the deployed name                        */ -}}
{{- /* stays ~/.config/brewfiles/Brewfile.macos.                                                      */ -}}
{{- $full := not (get . "ci_minimal") -}}
{{ if $full -}}
# macOS-specific packages

# Third-party taps (declare before their formulas; trusted so `brew bundle`
# will install formulas from them on a clean machine)
tap "schpet/tap", trusted: true
tap "letstri/tap", trusted: true
tap "kamillobinski/thock", trusted: true

# CLI tools (macOS only)
brew "elio"         # terminal file manager (theme synced under Library/)
brew "terminal-notifier"
brew "schpet/tap/linear"
brew "letstri/tap/druk"

# ImageMagick delegates. imagemagick lives in Brewfile, but it reaches these
# two by shelling out at runtime (`gs` for the pdf/ps/eps delegates,
# `rsvg-convert` for svg), not by linking them — so brew records no dependency
# and a clean machine gets an imagemagick that fails only at conversion time.
brew "ghostscript"  # gs
brew "librsvg"      # rsvg-convert

# AI coding agents (macOS-only casks; cross-platform ones live in Brewfile)
cask "claude-code"
cask "codex"
# Ships the executor CLI inside the app bundle; ~/.local/bin/executor symlinks to it.
cask "executor"

# Fonts
cask "font-jetbrains-mono-nerd-font"
cask "font-iosevka-term-nerd-font"
cask "font-symbols-only-nerd-font"

# Terminal & editors
cask "ghostty"
cask "kitty"
cask "zed"
cask "obsidian"

# Productivity
cask "raycast"
cask "marta"
cask "ticktick"
cask "setapp"
cask "dropbox"
cask "syncthing-app"

# Utilities
cask "1password-cli"
cask "karabiner-elements"
cask "the-unarchiver"
cask "imageoptim"
cask "tailscale-app"
cask "kamillobinski/thock/thock"

# Media
cask "spotify"
cask "notunes"
cask "iina"
cask "transmission"

# Browsers
cask "helium-browser"
cask "zen"

# Communication
cask "telegram"

# Design
cask "figma"

# Other
cask "android-file-transfer"
{{ end -}}
