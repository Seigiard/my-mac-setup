# revmux runtime knobs. Precedence: command line, ./.revmux/config, this file, built-in default.
# Layers merge per key, so only the keys set here differ from what ships.

# `mixed` runs each `lean` lens group once, on the model that found more of its gating findings
# across the `dual-model` archive, and `docs+tests` on both. It replaced `dual-model` as the
# default because that archive showed the second agent of a pair rarely added a finding, while
# the second model did; `mixed` keeps both models at six agents instead of ten. `dual-model`
# stays available by name. `code-review` picks a narrower profile when the gap in a diff is small.
#
# Trial, 2026-10-30 to 2026-11-06: `mixed-terra`, which is `mixed` with a gpt-6.1-terra twin of each
# codex group, nine agents. The #576 holdout failed Terra on one finding of a kind the owner counts
# as valid, so a week of real rounds decides instead; `docs/benchmarks/revmux-harness/trial-terra/`
# holds the tally and the rule. At the end of the week this line goes back to `mixed`, or `mixed`
# itself moves its codex groups to Terra, in a PR with the tally as evidence.
profile = mixed-terra

# Six agents in one wave. Each agent runs the diff command in `scope.md` itself, so two waves
# launched minutes apart would read different material from a working tree still being edited;
# a cap that holds the whole roster avoids that. `dual-model` has ten agents and runs as 6 + 4,
# which keeps both halves of each adjacent pair in the same wave.
max-parallel = 6

# One pool for every round, whatever directory it was launched from. `tasks-dir`
# otherwise resolves against the process working directory, so a review run in a
# herdr worktree wrote its archive into that worktree and lost it when the
# worktree went away. Rounds are the evidence `revmux self` and issue #353 read,
# so they have to accumulate in one place rather than one per checkout.
#
# The value is templated because revmux expands nothing: no `~`, no `$HOME`. It
# takes the string as written and resolves a relative one against the working
# directory, which is the behaviour this line exists to stop.
#
# Two consequences. `revmux stats` and `revmux cleanup --task` now act on every
# repository's rounds at once. And task ids are machine-wide: two repositories
# deriving the same id would share one history, and revmux injects a task's
# prior rounds into every later round of it, so name a task for its subject
# whenever the derived id could read as another repository's.
tasks-dir = "{{ .chezmoi.homeDir }}/.local/state/revmux/tasks"
