{{- $machineRole := includeTemplate "machine-role" . | trim -}}
{{- if and $machineRole (not (hasKey .ssh.roles $machineRole)) -}}
{{-   fail (printf "invalid machine_role %q: expected mbp2021, mbp2026, or server" $machineRole) -}}
{{- end -}}
{{- if and $machineRole (ne .chezmoi.os (index .ssh.roles $machineRole).os) -}}
{{-   fail (printf "machine role %q is not supported on %s" $machineRole .chezmoi.os) -}}
{{- end }}

# README and docs
README.md
LICENSE

# Read-only commands preserve SSH files until apply binds a missing role. The
# server does not use the local 1Password SSH agent.
{{ if not $machineRole }}
.ssh/config
.ssh/authorized_keys
.ssh/mbp2021.pub
.ssh/mbp2026.pub
.config/1Password/ssh/agent.toml
{{ else if eq $machineRole "server" }}
.config/1Password/ssh/agent.toml
{{ end }}

# macOS-only files (ignore on Linux)
# Patterns match target paths, not source names
{{ if ne .chezmoi.os "darwin" }}
.hammerspoon
.hammerspoon/**
Library
Library/**
.config/ghostty
.config/ghostty/**
.config/kitty
.config/kitty/**
.config/karabiner
.config/karabiner/**
.config/karabiner.edn
.config/zed
.config/zed/**
.chezmoiscripts/darwin
.chezmoiscripts/darwin/**
.config/herdr/plugins/herdr-caffeinate
.config/herdr/plugins/herdr-caffeinate/**
.config/herdr/plugins/herdr-focus-notify
.config/herdr/plugins/herdr-focus-notify/**

# Executor CLI: the symlink target lives inside /Applications/Executor.app,
# which only exists on macOS.
.local/bin/executor
{{ end }}

# Python bytecode caches. Running any managed .py script (the herdr
# command-palette plugin, for example) drops a __pycache__ directory next to
# it. Without this rule a stray cache inside home/ becomes a managed file and
# shows up in every chezmoi diff. Python regenerates these on demand.
**/__pycache__
**/__pycache__/**

# Karabiner automatic backups (generated by Karabiner, not needed in dotfiles)
.config/karabiner/automatic_backups

# Linux-only files (ignore on macOS)
{{ if ne .chezmoi.os "linux" }}
.chezmoiscripts/linux
{{ end }}
