{{- $machineRole := includeTemplate "machine-role" . | trim -}}
{{- if and $machineRole (not (hasKey .machines.roles $machineRole)) -}}
{{-   fail (printf "invalid machine_role %q: expected mbp2021, mbp2026, or server" $machineRole) -}}
{{- end -}}
{{- if and $machineRole (ne .chezmoi.os (index .machines.roles $machineRole).os) -}}
{{-   fail (printf "machine role %q is not supported on %s" $machineRole .chezmoi.os) -}}
{{- end }}
{{- /* dig rather than .chezmoi.config.age.identity: a host config generated */}}
{{- /* before the age block existed has no such key, and the render must     */}}
{{- /* still succeed there so `chezmoi init` can be run to refresh it.       */}}
{{- $ageIdentity := dig "age" "identity" "" .chezmoi.config }}

# README and docs
README.md
LICENSE

# Read-only commands preserve SSH files until apply binds a missing role.
{{ if not $machineRole }}
.ssh/config
.ssh/authorized_keys
.ssh/mbp2021.pub
.ssh/mbp2026.pub
.memex/config.toml
{{ end }}

# Machine secrets decrypt only where a Machine identity exists. Without one
# (the server, CI, Docker, a laptop before enrollment) the encrypted target is
# left out so apply does not fail on a file this machine cannot read.
{{ if not (and $ageIdentity (stat $ageIdentity)) }}
.config/secrets
.config/secrets/**
{{ end }}

# macOS-only files (ignore on Linux)
# Patterns match target paths, not source names
{{ if ne .chezmoi.os "darwin" }}
.memex
.memex/**
.hammerspoon
.hammerspoon/**
Library
Library/**
.config/ghostty
.config/ghostty/**
.config/kitty
.config/kitty/**
.config/karabiner
.config/karabiner/**
.config/karabiner.edn
.config/zed
.config/zed/**
.chezmoiscripts/darwin
.chezmoiscripts/darwin/**
.config/herdr/plugins/config/herdr-wakeup
.config/herdr/plugins/config/herdr-wakeup/**
# Executor CLI: the symlink target lives inside /Applications/Executor.app,
# which only exists on macOS.
.local/bin/executor
{{ end }}

# Python bytecode caches. Running a managed .py script can drop a __pycache__
# directory next to it. Without this rule a stray cache inside home/ becomes a
# managed file and shows up in every chezmoi diff. Python regenerates these on
# demand.
**/__pycache__
**/__pycache__/**

# Karabiner automatic backups (generated by Karabiner, not needed in dotfiles)
.config/karabiner/automatic_backups

# Linux-only files (ignore on macOS)
{{ if ne .chezmoi.os "linux" }}
.chezmoiscripts/linux
{{ end }}
