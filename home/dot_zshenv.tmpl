# ~/.zshenv - Sourced by ALL zsh shells (interactive and non-interactive)
# Keep this minimal - only env vars needed by scripts/tools

# Helpers
has() { command -v "$1" > /dev/null 2>&1; }

# -------------------------------------------
# Homebrew env (inlined equivalent of `brew shellenv`, no subshell fork)
# -------------------------------------------
for _hb in /opt/homebrew /usr/local /home/linuxbrew/.linuxbrew; do
  if [[ -d "$_hb/bin" ]]; then
    export HOMEBREW_PREFIX="$_hb"
    export HOMEBREW_CELLAR="$_hb/Cellar"
    export HOMEBREW_REPOSITORY="$_hb"
    fpath=("$_hb/share/zsh/site-functions" $fpath)
    export PATH="$_hb/bin:$_hb/sbin:$PATH"
    export INFOPATH="$_hb/share/info${INFOPATH:+:$INFOPATH}"
    break
  fi
done
unset _hb

# -------------------------------------------
# Path
# -------------------------------------------
export PATH="$HOME/.local/bin:$PATH"

# Rust/Cargo
[[ -r "$HOME/.cargo/env" ]] && . "$HOME/.cargo/env"

# -------------------------------------------
# mise (version manager) — activate output is cached, regenerated when
# the mise binary is newer than the cache file. Saves ~10ms per shell.
# -------------------------------------------
if has mise; then
  _mise_cache="$HOME/.cache/zsh/mise-activate.zsh"
  [[ -d "${_mise_cache:h}" ]] || mkdir -p "${_mise_cache:h}"
  if [[ ! -s "$_mise_cache" || "$_mise_cache" -ot "$(command -v mise)" ]]; then
    # Write through a temp file: shells starting together (a multiplexer
    # restoring its panes) all regenerate a stale cache, and redirecting
    # straight into "$_mise_cache" leaves one shell's tail past the end of
    # another's shorter output. `mise activate` embeds the generating shell's
    # PATH, so the two outputs differ in length and the splice is visible --
    # it left orphan handler lines at top level and every later shell printed
    # "zsh: command not found: " while sourcing them.
    # mktemp rather than "$_mise_cache.$$": zsh reports the parent shell's PID
    # in a subshell, so $$ does not separate concurrent writers.
    #
    # sed strips the absolute `export PATH='...'` snapshot mise emits as line
    # 1: it captures THIS shell's PATH, and caching it froze that PATH into
    # every later shell until the mise binary changed (a capture from a shell
    # with an augmented PATH pinned those extra entries for weeks). The
    # activate script ends by calling _mise_hook, which recomputes PATH via
    # `mise hook-env` at source time, so dropping the snapshot loses nothing —
    # each shell mutates its own PATH instead of inheriting a frozen one.
    # Scoped to line 1 so a relative, runtime PATH mutation elsewhere in the
    # output would survive.
    _mise_cache_tmp="$(mktemp "$_mise_cache.XXXXXX")"
    mise activate zsh 2>/dev/null | sed '1{/^export PATH=/d;}' > "$_mise_cache_tmp"
    if [[ $pipestatus[1] -eq 0 ]]; then
      mv -f "$_mise_cache_tmp" "$_mise_cache"
    else
      rm -f "$_mise_cache_tmp"
    fi
    unset _mise_cache_tmp
  fi
  [[ -s "$_mise_cache" ]] && source "$_mise_cache"
  unset _mise_cache
fi

# -------------------------------------------
# Editor
# -------------------------------------------
export EDITOR="zed"

# -------------------------------------------
# Linear CLI
# -------------------------------------------
export LINEAR_ISSUE_SORT="manual"

# -------------------------------------------
# OpenCode
# Keep Claude-only skill discovery disabled so explicit-only Claude adapters
# cannot leak into OpenCode. OpenCode discovers ~/.agents/skills natively.
# This is an env-var escape hatch, not an opencode.json key.
# -------------------------------------------
export OPENCODE_DISABLE_CLAUDE_CODE_SKILLS=1

{{ if .is_darwin }}
# -------------------------------------------
# Agent Browser
# -------------------------------------------
export AGENT_BROWSER_EXECUTABLE_PATH="/Applications/Helium.app/Contents/MacOS/Helium"
{{- end }}

{{- $unattended := eq (env "MMS_CHEZMOI_UNATTENDED") "1" }}
{{- $unattendedProfile := env "MMS_CHEZMOI_UNATTENDED_PROFILE" }}
{{ if and $unattended (eq $unattendedProfile "full-fixture") }}
# API Keys (from unattended fixtures)
export LINEAR_API_KEY={{ env "MMS_CHEZMOI_FIXTURE_LINEAR_API_KEY" | quote }}
export TAVILY_API_KEY={{ env "MMS_CHEZMOI_FIXTURE_TAVILY_API_KEY" | quote }}
export JINA_API_KEY={{ env "MMS_CHEZMOI_FIXTURE_JINA_API_KEY" | quote }}
export CONTEXT7_API_KEY={{ env "MMS_CHEZMOI_FIXTURE_CONTEXT7_API_KEY" | quote }}
export VECTOR_PRIME_API_KEY={{ env "MMS_CHEZMOI_FIXTURE_VECTOR_PRIME_API_KEY" | quote }}
{{- else if and $unattended (eq $unattendedProfile "host-partial") }}
# API Keys (secret-backed target; omitted from host-partial state operations)
export LINEAR_API_KEY="{{ onepasswordRead "op://Private/Linear API Key/credential" "my.1password.com" }}"
export TAVILY_API_KEY="{{ onepasswordRead "op://Private/Tavily API Key/credential" "my.1password.com" }}"
export JINA_API_KEY="{{ onepasswordRead "op://Private/Jina API Key/credential" "my.1password.com" }}"
export CONTEXT7_API_KEY="{{ onepasswordRead "op://Private/Context7 API Key/credential" "my.1password.com" }}"
export VECTOR_PRIME_API_KEY="{{ onepasswordRead "op://Private/VectorPrime API Key/credential" "my.1password.com" }}"
{{- else if $unattended }}
{{-   fail "invalid unattended chezmoi profile" }}
{{- else if lookPath "op" }}
# API Keys (from 1Password)
export LINEAR_API_KEY="{{ onepasswordRead "op://Private/Linear API Key/credential" "my.1password.com" }}"
export TAVILY_API_KEY="{{ onepasswordRead "op://Private/Tavily API Key/credential" "my.1password.com" }}"
export JINA_API_KEY="{{ onepasswordRead "op://Private/Jina API Key/credential" "my.1password.com" }}"
export CONTEXT7_API_KEY="{{ onepasswordRead "op://Private/Context7 API Key/credential" "my.1password.com" }}"
export VECTOR_PRIME_API_KEY="{{ onepasswordRead "op://Private/VectorPrime API Key/credential" "my.1password.com" }}"
{{- end }}
