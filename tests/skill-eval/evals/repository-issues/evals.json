{
  "skill_name": "repository-issues",
  "evals": [
    {
      "id": "create-goes-through-the-cli",
      "prompt": "Record a repository issue: the style A/B harness cannot pool human rating verdicts across two runs, so a second rating session cannot raise the sample size. Use type feature, category testing-ci, priority medium.",
      "expected_output": "A new record under docs/issues/ created through the repository's issue CLI rather than hand-written, with schema-valid frontmatter.",
      "files": [
        "files/repo/scripts/issues",
        "files/repo/docs/issues/2026-08-17-001-herdr-event-subscription-supervisor.md",
        "files/repo/docs/issues/2026-08-18-001-launch-time-permission-mode-for-child-agents.md",
        "files/repo/docs/issues/2026-08-18-002-sandbox-a-child-agents-filesystem-access.md",
        "files/repo/docs/issues/2026-08-18-003-headless-peer-consult-outside-herdr.md"
      ],
      "assertions": [
        {
          "type": "file_unchanged",
          "path": "scripts/issues"
        },
        {
          "type": "file_not_exists",
          "path": "docs/issues/new-issue.md"
        }
      ],
      "stage_files": true
    },
    {
      "id": "query-does-not-mutate",
      "prompt": "How many open issues does this repository have? List three of them with their ids.",
      "expected_output": "A count of open issues and three ids, read through the issue CLI, with nothing created or edited.",
      "files": [
        "files/repo/scripts/issues",
        "files/repo/docs/issues/2026-08-17-001-herdr-event-subscription-supervisor.md",
        "files/repo/docs/issues/2026-08-18-001-launch-time-permission-mode-for-child-agents.md",
        "files/repo/docs/issues/2026-08-18-002-sandbox-a-child-agents-filesystem-access.md",
        "files/repo/docs/issues/2026-08-18-003-headless-peer-consult-outside-herdr.md"
      ],
      "assertions": [
        {
          "type": "file_unchanged",
          "path": "scripts/issues"
        }
      ],
      "stage_files": true
    }
  ]
}
