#!/usr/bin/env python3
"""Run one prompt set through a skill's presence and absence, and record both.

Each job gets its own git workspace, so the workspace path is the join key
between a job and the session the shim recorded. Nothing is shared between jobs.

The observation is the trajectory, not the answer text: which skill fired and
which commands ran. Read it with `tests/skill-eval/trajectory`.

Must be invoked through `tests/skill-eval/run`, which supplies the isolation
shim and the trajectory index.

Usage:
  tests/skill-eval/run tests/skill-eval/matrix \
      --skill .claude/skills/repository-issues \
      --prompts tests/skill-eval/prompts/repository-issues.tsv \
      --fixture scripts/issues --fixture docs/issues \
      --runs 2
"""

import argparse
import concurrent.futures as futures
import json
import os
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

REPOSITORY = Path(__file__).resolve().parents[2]
JOB_TIMEOUT_SECONDS = 300
TOOLS = "Skill,Bash,Read,Glob,Grep,Write,Edit"


def build_workspace(root, fixtures, skill_dir):
    """A fresh git repository holding the fixtures, and the skill only when asked."""
    # Resolved, not as mkdtemp returns it. On macOS mkdtemp yields /var/... while
    # the shell resolves $PWD to /private/var/..., and the shim records the
    # latter. The workspace path is the join key, so the two must be the same
    # string.
    workspace = Path(tempfile.mkdtemp(prefix="skill-eval-", dir=root)).resolve()
    subprocess.run(["git", "init", "-q", "."], cwd=workspace, check=True)
    subprocess.run(["git", "config", "user.email", "eval@local"], cwd=workspace, check=True)
    subprocess.run(["git", "config", "user.name", "Skill Eval"], cwd=workspace, check=True)

    for fixture in fixtures:
        source = REPOSITORY / fixture
        target = workspace / fixture
        target.parent.mkdir(parents=True, exist_ok=True)
        if source.is_dir():
            shutil.copytree(source, target)
        else:
            shutil.copy2(source, target)

    subprocess.run(["git", "add", "-A"], cwd=workspace, check=True)
    subprocess.run(["git", "commit", "-q", "-m", "fixtures"], cwd=workspace, check=True)

    if skill_dir is not None:
        destination = workspace / ".claude" / "skills" / Path(skill_dir).name
        destination.parent.mkdir(parents=True, exist_ok=True)
        shutil.copytree(REPOSITORY / skill_dir, destination)

    return workspace


def run_job(job, root, fixtures, skill_dir):
    workspace = build_workspace(root, fixtures, skill_dir if job["arm"] == "with_skill" else None)
    started = time.time()
    try:
        completed = subprocess.run(
            ["claude", "-p", job["prompt"], "--allowed-tools", TOOLS],
            cwd=workspace, stdin=subprocess.DEVNULL, capture_output=True,
            text=True, timeout=JOB_TIMEOUT_SECONDS,
        )
    except subprocess.TimeoutExpired:
        return {**job, "workspace": str(workspace), "status": "timeout"}

    (workspace / "answer.txt").write_text(completed.stdout)
    return {
        **job,
        "workspace": str(workspace),
        "status": "ok" if completed.returncode == 0 else f"exit {completed.returncode}",
        "seconds": round(time.time() - started, 1),
        "stderr_tail": completed.stderr[-300:],
    }


def read_prompts(path):
    rows = []
    for number, line in enumerate(Path(path).read_text().splitlines(), 1):
        if not line.strip():
            continue
        parts = line.split("\t")
        if len(parts) != 2:
            raise SystemExit(f"{path}:{number}: expected 2 tab-separated fields")
        rows.append({"prompt_id": parts[0], "prompt": parts[1]})
    return rows


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    parser.add_argument("--skill", required=True, help="skill directory, relative to the repository")
    parser.add_argument("--prompts", required=True)
    parser.add_argument("--fixture", action="append", default=[],
                        help="repository path copied into every workspace; repeatable")
    parser.add_argument("--runs", type=int, default=2)
    parser.add_argument("--workers", type=int, default=4)
    parser.add_argument("--out", default=None, help="where to write the job index")
    args = parser.parse_args(argv)

    if not os.environ.get("SKILL_EVAL_REAL_CLAUDE"):
        raise SystemExit("run this through tests/skill-eval/run, which supplies the shim")

    prompts = read_prompts(args.prompts)
    jobs = [
        {"prompt_id": row["prompt_id"], "prompt": row["prompt"], "arm": arm, "repeat": repeat}
        for row in prompts
        for repeat in range(1, args.runs + 1)
        for arm in ("with_skill", "without_skill")
    ]

    root = tempfile.mkdtemp(prefix="skill-eval-matrix-")
    print(f"{len(jobs)} job(s), workspaces under {root}")

    results = []
    with futures.ThreadPoolExecutor(max_workers=args.workers) as pool:
        pending = [pool.submit(run_job, job, root, args.fixture, args.skill) for job in jobs]
        for done in futures.as_completed(pending):
            result = done.result()
            results.append(result)
            print("." if result["status"] == "ok" else "F", end="", flush=True)
    print()

    out = Path(args.out or (Path(root) / "jobs.json"))
    out.write_text(json.dumps(results, indent=2, ensure_ascii=False))
    print(f"jobs: {out}")
    for result in results:
        if result["status"] != "ok":
            print(f"  {result['prompt_id']}/{result['arm']}/r{result['repeat']}: {result['status']}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
