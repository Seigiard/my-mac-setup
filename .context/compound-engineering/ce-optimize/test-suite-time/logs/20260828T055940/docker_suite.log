+# ===========================================
+# Cross-Platform Aliases (macOS + Linux)
+# ===========================================
+
+# Helpers (if not already defined in .zshrc)
+has() { command -v "$1" > /dev/null 2>&1; }
+
+# Detect OS
+case "$(uname -s)" in
+  Darwin) OS="macos" ;;
+  Linux)  OS="linux" ;;
+esac
+
+# -------------------------------------------
+# Modern tool replacements (shadow built-ins)
+# -------------------------------------------
+
+has bat && alias cat='bat'
+has eza && {
+  alias l='eza --group-directories-first'
+  alias ls='eza --group-directories-first'
+  alias ll='eza -la --group-directories-first'
+  alias la='eza -a --group-directories-first'
+  alias lt='eza -la --sort=modified --group-directories-first'
+}
+has btop && { alias h='btop'; alias htop='btop'; }
+has dust && alias du='dust'
+has duf && alias df='duf'
+has procs && alias ps='procs'
+
+# -------------------------------------------
+# Navigation
+# -------------------------------------------
+
+alias ..='cd ..'
+alias ...='cd ../..'
+alias ....='cd ../../..'
+alias zi='zoxide query -i'
+
+# -------------------------------------------
+# Grep (with colors)
+# -------------------------------------------
+
+alias grep='grep --color=auto'
+alias fgrep='fgrep --color=auto'
+alias egrep='egrep --color=auto'
+
+# -------------------------------------------
+# Network (OS-specific)
+# -------------------------------------------
+
+if [[ "$OS" == "macos" ]]; then
+  alias ports='lsof -iTCP -sTCP:LISTEN -n -P'
+  alias localip='ipconfig getifaddr en0'
+else
+  alias ports='ss -tulpn'
+  alias localip='hostname -I | awk "{print \$1}"'
+  alias free='free -h'
+fi
+alias myip='curl -s ifconfig.me'
+
+# Kill process(es) holding port(s): killport 6006 [3000 ...]
+killport() {
+  [[ $# -eq 0 ]] && { echo "Usage: killport <port> [port ...]"; return 1; }
+  local port pid pids dev_auto_pids kids attempt remaining rc=0
+  local tw
+  for port in "$@"; do
+    pids=$(lsof -ti:"$port" -sTCP:LISTEN 2>/dev/null | sort -u)
+
+    # Escalate via cached sudo (non-interactive) for root-owned processes
+    if [[ -z "$pids" ]] && sudo -n true 2>/dev/null; then
+      pids=$(sudo -n lsof -ti:"$port" -sTCP:LISTEN 2>/dev/null | sort -u)
+    fi
+
+    # dev-auto reserves ports before child services bind them, so a stuck
+    # dev-auto parent can block the default port without appearing in lsof.
+    dev_auto_pids=""
+    if [[ -f .logs/dev-auto-ports.json ]]; then
+      if has jq; then
+        dev_auto_pids=$(jq -r --argjson port "$port" 'to_entries[] | select(any(.value.ports[]?; . == $port)) | .value.pid' .logs/dev-auto-ports.json 2>/dev/null | sort -u)
+      elif has node; then
+        dev_auto_pids=$(node -e '
+const fs = require("fs")
+const port = Number(process.argv[1])
+try {
+  const db = JSON.parse(fs.readFileSync(".logs/dev-auto-ports.json", "utf8"))
+  for (const entry of Object.values(db)) {
+    if (entry && Object.values(entry.ports || {}).includes(port)) console.log(entry.pid)
+  }
+} catch {}
+' "$port" 2>/dev/null | sort -u)
+      fi
+
+      for pid in $dev_auto_pids; do
+        kill -0 "$pid" 2>/dev/null || continue
+        if [[ -z "$pids" ]]; then
+          pids="$pid"
+        else
+          pids="$pids
+$pid"
+        fi
+      done
+      pids=$(echo "$pids" | sort -u)
+    fi
+
+    if [[ -z "$pids" ]]; then
+      # No process — check if port is stuck in TIME_WAIT (kernel state, not killable)
+      if [[ "$OS" == "macos" ]]; then
+        tw=$(netstat -an -p tcp 2>/dev/null | awk -v p="\\.$port\$|:$port\$" '$NF=="TIME_WAIT" && $4 ~ p' | wc -l | tr -d ' ')
+      else
+        tw=$(ss -tan state time-wait 2>/dev/null | awk -v p=":$port\$" 'NR>1 && $4 ~ p' | wc -l | tr -d ' ')
+      fi
+      if [[ "${tw:-0}" -gt 0 ]]; then
+        echo "No process on port $port — but $tw TIME_WAIT connection(s) (kernel releases in ~60s)"
+      else
+        echo "No process on port $port"
+      fi
+      continue
+    fi
+    if [[ -n "$dev_auto_pids" ]]; then
+      echo "Port $port held/reserved by: $(echo $pids | tr '\n' ' ')"
+    else
+      echo "Port $port held by: $(echo $pids | tr '\n' ' ')"
+    fi
+
+    # Kill children first — shell wrappers (npm/pnpm/yarn) spawn nodes that hold the port
+    for pid in $pids; do
+      kids=$(pgrep -P "$pid" 2>/dev/null)
+      [[ -n "$kids" ]] && kill -TERM $kids 2>/dev/null
+    done
+
+    # Graceful TERM, then KILL with sudo fallback; retry to handle respawns and races
+    kill -TERM $pids 2>/dev/null
+    for attempt in 1 2 3; do
+      sleep 0.2
+      remaining=$(lsof -ti:"$port" -sTCP:LISTEN 2>/dev/null | sort -u)
+      for pid in $dev_auto_pids; do
+        kill -0 "$pid" 2>/dev/null || continue
+        if [[ -z "$remaining" ]]; then
+          remaining="$pid"
+        else
+          remaining="$remaining
+$pid"
+        fi
+      done
+      remaining=$(echo "$remaining" | sort -u)
+      [[ -z "$remaining" ]] && break
+      kill -KILL $remaining 2>/dev/null || sudo kill -KILL $remaining 2>/dev/null
+    done
+
+    remaining=$(lsof -ti:"$port" -sTCP:LISTEN 2>/dev/null | sort -u)
+    for pid in $dev_auto_pids; do
+      kill -0 "$pid" 2>/dev/null || continue
+      if [[ -z "$remaining" ]]; then
+        remaining="$pid"
+      else
+        remaining="$remaining
+$pid"
+      fi
+    done
+    remaining=$(echo "$remaining" | sort -u)
+    if [[ -z "$remaining" ]]; then
+      echo "Port $port freed"
+    else
+      echo "Port $port still held/reserved by: $(echo $remaining | tr '\n' ' ') (run: lsof -i:$port; bun run dev:ports)"
+      rc=1
+    fi
+  done
+  return $rc
+}
+
+# -------------------------------------------
+# macOS only
+# -------------------------------------------
+
+if [[ "$OS" == "macos" ]]; then
+  alias o='open .'
+  alias ql='qlmanage -p'
+  alias flushdns='sudo dscacheutil -flushcache; sudo killall -HUP mDNSResponder'
+
+  # SMB mounts (home.local) - uses Finder for native credential handling
+  alias mnt-public='open "smb://guest@home.local/public"'
+  alias mnt-andrew='open "smb://andrew@home.local/andrew"'
+  alias unmnt-public='diskutil unmount /Volumes/public'
+  alias unmnt-andrew='diskutil unmount /Volumes/andrew'
+
+  # herdr-web bridge for phone access over tailscale (enable tailscale first)
+  [ -x "$HOME/.local/share/herdr-web/start-bridge.sh" ] && alias hweb="$HOME/.local/share/herdr-web/start-bridge.sh"
+fi
+
+# -------------------------------------------
+# Git
+# -------------------------------------------
+
+alias g='git'
+alias gs='git status'
+alias ga='git add'
+alias gaa='git add -A'
+alias gc='git commit -m'
+alias gp='git push'
+alias gpl='git pull'
+alias gl='git log --oneline -10'
+alias gd='git diff'
+alias gco='git checkout'
+alias gb='git branch'
+alias lg='lazygit'
+
+check-deps() (
+  cd "$(git rev-parse --show-toplevel)" || return 1
+  if git rev-parse -q --verify ORIG_HEAD >/dev/null \
+     && ! git diff --quiet ORIG_HEAD HEAD -- bun.lock; then
+    echo "bun.lock changed — bun install"
+    bun install || return 1
+  fi
+  bun run build:all -- --env-mode=loose
+)
+
+gpmain() {
+  git pullmain "$@"
+}
+
+gmmain() {
+  local merge_status
+
+  echo '→ Updating main...'
+  gpmain || return $?
+
+  echo '→ Merging main into current branch...'
+  git merge main --no-edit
+  merge_status=$?
+
+  if [[ -n "$(git ls-files --unmerged)" ]]; then
+    echo '✗ Conflicts detected, launching Pi...'
+    pi --print 'fix all merge conflicts'
+    return $?
+  fi
+
+  if [[ $merge_status -ne 0 ]]; then
+    echo '✗ Merge failed'
+    return $merge_status
+  fi
+
+  echo '✓ Merged cleanly'
+}
+
+# -------------------------------------------
+# Editors
+# -------------------------------------------
+
+alias e='micro'
+alias m='mc'
+
+# -------------------------------------------
+# Safety
+# (skip in Claude Code - breaks non-interactive shell)
+# -------------------------------------------
+
+if [[ -z "$CLAUDECODE" ]]; then
+  alias rm='rm -i'
+  alias cp='cp -i'
+  alias mv='mv -i'
+fi
+
+# -------------------------------------------
+# Homelab specific
+# -------------------------------------------
+
+alias hldeploy='/opt/homelab/scripts/docker/deploy.sh'
+alias hlstop='/opt/homelab/scripts/docker/stop.sh'
+alias hlrebuild='/opt/homelab/scripts/docker/rebuild.sh'
+alias hlstatus='/opt/homelab/scripts/docker/status.sh'
+alias hllogs='cd /opt/homelab && docker compose logs -f'
+
+# -------------------------------------------
+# Claude Code
+# -------------------------------------------
+
+alias fable='claude --model fable --effort high'
+
+# oh-my-claudecode in an isolated config sandbox. The extra /.claude level
+# keeps OMC's MCP-registry sync (writes to dirname of the config dir) inside
+# ~/.claude-omc instead of clobbering the real ~/.claude.json.
+omc() {
+  CLAUDE_CONFIG_DIR="$HOME/.claude-omc/.claude" \
+  CODEX_HOME="$HOME/.claude-omc/codex" \
+  OMC_STATE_DIR="$HOME/.claude-omc/state" \
+  claude "$@"
+}
+
+# -------------------------------------------
+# Misc
+# -------------------------------------------
+
+alias reload='source ~/.zshrc'
+alias path='echo -e ${PATH//:/\\n}'
+alias now='date +"%Y-%m-%d %H:%M:%S"'
+alias week='date +%V'
+alias zsh-bench='for i in {1..5}; do time zsh -i -c exit; done'
+
+# Alert for long-running commands (Linux only)
+if [[ "$OS" == "linux" ]]; then
+  alias alert='notify-send --urgency=low -i "$([ $? = 0 ] && echo terminal || echo error)" "$(history|tail -n1|sed -e '\''s/^\s*[0-9]\+\s*//;s/[;&|]\s*alert$//'\'')"'
+fi
+
+# -------------------------------------------
+# Yazi - cd to directory on exit
+# -------------------------------------------
+
+function y() {
+  local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
+  yazi "$@" --cwd-file="$tmp"
+  if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
+    builtin cd -- "$cwd"
+  fi
+  rm -f -- "$tmp"
+}
