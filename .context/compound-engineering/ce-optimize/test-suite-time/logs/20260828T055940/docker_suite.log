+[[commands]]
+group = "Git"
+title = "Lazygit in new tab"
+description = "Open a new tab in the current pane's directory and run lazygit"
+type = "tab_run"
+label = "lazygit"
+command = "lazygit"
+
+[[commands]]
+group = "Git"
+title = "Lazygit in popup"
+# The Cyrillic entries are `lg` and `lazy` typed on the ЙЦУКЕН layout: the
+# palette opens in whatever layout you were already typing in, and the shortcut
+# list is literal text, so nothing in the palette has to know about layouts.
+shortcuts = ["lg", "дп", "дфян"]
+description = "Open lazygit in a 90%×90% popup in the current pane's directory"
+type = "shell"
+pause = false
+command = "nohup bash -c \"sleep 0.4; herdr plugin pane open --plugin seigi.command-palette --entrypoint lazygit --width 90% --height 90% --cwd {target_cwd_q} --focus\" >/dev/null 2>&1 &"
+
+[[commands]]
+group = "Git"
+title = "Switch to the latest main"
+description = "Switch to the latest main branch, pull changes and update"
+type = "shell"
+command = "zsh -ic 'git checkout main && gpmain && check-deps'"
+
+[[commands]]
+group = "Git"
+title = "Merge main branch"
+description = "Run gmmain in the current pane's directory"
+type = "shell"
+command = "zsh -ic 'gmmain && check-deps'"
+
+[[commands]]
+group = "Git"
+title = "Update main branch"
+description = "Run gpmain in the current pane's directory"
+type = "shell"
+command = "zsh -ic 'gpmain'"
+
+[[commands]]
+group = "Editor"
+title = "Open in Zed"
+shortcuts = ["zed", "яув"]
+description = "Open the current pane's directory in Zed"
+type = "shell"
+pause = false
+command = "python3 {plugin_root_q}/open_in_zed.py {target_cwd_q}"
+
+[[commands]]
+group = "Herdr"
+title = "Switch workspace"
+shortcuts = ["ws", "цы"]
+description = "Choose and focus a workspace"
+type = "workspace_picker"
+
+[[commands]]
+group = "Smithers"
+title = "sm monitor"
+description = "Open the smithers live web UI (Gateway :7331) in the browser"
+type = "shell"
+pause = false
+command = "se monitor"
+
+[[commands]]
+group = "Herdr"
+title = "Reload config"
+description = "Apply config.toml changes without restarting panes"
+type = "herdr"
+args = ["server", "reload-config"]
+
+[[commands]]
+group = "Settings"
+title = "Edit command palette config"
+shortcuts = ["edit", "увше"]
+description = "Open commands.toml in a new tab with $EDITOR"
+# tab_run, not pane_run: the palette refuses to type into a pane an agent owns,
+# and most panes here have one. A new tab always has room for the editor.
+type = "tab_run"
+label = "commands.toml"
+command = "${EDITOR:-vi} {config_file_q}"
diff --git a/.config/herdr/config.toml b/.config/herdr/config.toml
new file mode 100644
index 0000000000000000000000000000000000000000..192a592d76c57ccf83c98267dd6f7da0215c5fc3
--- /dev/null
+++ b/.config/herdr/config.toml
@@ -0,0 +1,69 @@
+onboarding = false
+
+[theme]
+name = "rose-pine-dawn"
+
+[theme.custom]
+panel_bg = "reset"
+
+[experimental]
+kitty_graphics = true
+pane_history = true
+allow_nested = true
+
+[keys]
+switch_workspace = "ctrl+shift+1..9"
+previous_workspace = "prefix+{"
+next_workspace = "prefix+}"
+focus_pane_left = "shift+alt+left"
+focus_pane_down = "shift+alt+down"
+focus_pane_up = "shift+alt+up"
+focus_pane_right = "shift+alt+right"
+split_horizontal = "prefix+minus"
+split_vertical = "prefix+v"
+close_pane = ""
+swap_pane_left = "ctrl+shift+left"
+swap_pane_down = "ctrl+shift+down"
+swap_pane_up = "ctrl+shift+up"
+swap_pane_right = "ctrl+shift+right"
+resize_pane_left = "ctrl+alt+left"
+resize_pane_down = "ctrl+alt+down"
+resize_pane_up = "ctrl+alt+up"
+resize_pane_right = "ctrl+alt+right"
+
+[[keys.command]]
+key = "cmd+shift+p"
+type = "plugin_action"
+command = "seigi.command-palette.open"
+description = "command palette"
+
+[[keys.command]]
+key = "prefix+space"
+type = "plugin_action"
+command = "seigi.command-palette.open"
+description = "command palette"
+
+[[keys.command]]
+key = "prefix+x"
+type = "plugin_action"
+command = "seigi.command-palette.smart_close"
+description = "close pane, then tab, but keep workspace"
+
+[ui]
+prompt_new_tab_name = false
+sidebar_min_width = 32
+
+# The `pane` row renders the pane label, which herdr-task-sync
+# (~/.local/bin/herdr-task-sync) sets to `<agent-prefix>:<task-slug>`, or to the
+# prefix alone until a task slug exists. The same script rebuilds each tab label
+# from the labels of its panes. The second sidebar row renders the combined Git
+# location token without adding Git information back to tab labels.
+[ui.sidebar.agents]
+rows = [["state_icon", "workspace", "pane"], ["$git_ref", "$git_status"]]
+
+# Native agent-status toasts are off: the herdr-focus-notify plugin sends its
+# own clickable notification (with `herdr agent focus` on click), and the two
+# would otherwise stack for every status change.
+[ui.toast]
+delivery = "off"   # off | herdr | terminal | system
+delay_seconds = 1
