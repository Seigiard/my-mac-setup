@@ -0,0 +1,738 @@
+#!/usr/bin/env bash
+# se — CLI wrapper over smithers for the se-pipeline workflow.
+# Launch/observe durable pipeline runs without bunx incantations.
+set -euo pipefail
+
+SMITHERS_DIR="${SE_SMITHERS_DIR:-$HOME/.claude/.smithers}"
+SMITHERS_BIN="./node_modules/.bin/smithers"
+PIPELINE_WORKFLOW="workflows/se-pipeline.tsx"
+FLOW_WORKFLOW="workflows/se-flow.tsx"
+CATALOG_SCRIPT="workflows/catalog.ts"
+FLOW_PRINT_SCRIPT="workflows/flow-print.ts"
+FLOW_SALVAGE_SCRIPT="workflows/flow-salvage.ts"
+
+usage() {
+  cat <<'EOF'
+Usage: se <command> [args]
+
+Commands:
+  pipeline <plan-path> [--until=branch|pr] [--validate-cmd '<cmd>'] [--setup-cmd '<cmd>'] [--doc-review] [--attach]
+      Launch the se-pipeline workflow for a plan file. Run from the target
+      repository: the current directory becomes PIPELINE_REPO (and
+      DOC_REVIEW_REPO for the verify-doc child workflow).
+        --until          stop stage: branch (default) or pr
+        --doc-review     run the verify-doc plan-review stage before work. OFF by
+                         default (the `se-work` command); the `se-review-and-work`
+                         command passes it. Simplify runs in BOTH — it is not a
+                         flag, it is always present and autonomously run-or-skipped.
+        --validate-cmd   Command the work gate runs to validate work in the run
+                         worktree. OPTIONAL: if omitted, it is derived from the
+                         plan's own Verification Contract (the scoped test/
+                         typecheck commands the plan already declares). Pass this
+                         only to override. Keep it FAST — it runs synchronously;
+                         unit/type checks, NOT full e2e.
+        --setup-cmd      Worktree provisioning command, run once in the staged
+                         worktree before work (installs, workspace dist builds
+                         the validate-cmd needs). Non-zero exit fails the run.
+        --validate-timeout N   seconds before validate-cmd is killed (default
+                         600). A too-broad command (e2e) that hits this fails
+                         the gate — scope the command rather than raising this.
+        --attach         run in the foreground streaming logs. NOTE: Ctrl-C
+                         sends SIGINT, which CANCELS the run (smithers aborts
+                         gracefully) — it does NOT detach. To leave a run going
+                         and stop watching, launch without --attach (detached
+                         is the default) and use `se logs <runId>` to follow.
+                         Recover a cancelled run with `se resume <runId>`.
+      Default is detached: prints the runId immediately and returns.
+  flow <spec.json> [--budget N] [--setup-cmd '<cmd>'] [--validate-cmd '<cmd>'] [--dry-run] [--attach]
+      Launch a composed flow spec through the static interpreter workflow
+      (se-flow.tsx). Run from the target repository (becomes FLOW_REPO). The
+      spec is operator-supplied data; command-bearing fields carry references,
+      never inline command strings (KTD15).
+        --budget N       run cost ceiling in USD; a breach parks the run for an
+                         operator ack, it never hard-kills (KTD9).
+        --setup-cmd      worktree provisioning command for workspace-needing flows.
+        --validate-cmd   behavior check the run-validate block and the simplify
+                         subflow execute. It arrives here, never in the spec: a
+                         spec that names it would choose what "verified" means
+                         for its own run (KTD15). Omitted, run-validate records
+                         exitCode null and its gate fails closed.
+        --dry-run        print the assembled input + command without launching.
+  flow salvage <runId>
+      Rebuild an outcome archive for a flow run killed before its epilog, from
+      the block rows in smithers.db (KTD10). Prints the archive path on stdout
+      for a later spec's `artifactsFrom`; refuses to overwrite the record of a
+      run that did reach its epilog. A killed run keeps its worktree, so the
+      manifest artifacts are recovered too when it is still there.
+  blocks [--json]      emit the composable block catalog the orchestrator
+                       composes from (KTD6). --json is the default machine form.
+  list [--json]        list se-pipeline runs (status incl. waiting-approval)
+                       --json: {runs, summaries} for unattended callers
+  show <runId> [--json]
+                       one run in depth: live status, summary verdict/branch,
+                       report dir and its files. --json merges all of it
+  monitor              open the live web UI (smithers monitor, Gateway :7331)
+  logs <runId>         show logs for a run
+  chat <runId>         open chat for a run
+  approve <runId> [--no-resume]
+                       accept the paused gate's offer. NOT always "continue":
+                       at a failed work gate approve buys ONE more attempt of
+                       that stage, and after a second failure it STOPS the run
+                       with a report. Both commands print the pending request
+                       — its title says what your decision does. The run is
+                       resumed automatically afterwards, because the owner
+                       process exits when a run parks and a recorded decision
+                       moves nothing on its own. --no-resume records the
+                       decision only, for deciding several gates before
+                       driving the run
+  deny <runId> [--no-resume]
+                       reject the offer (onDeny: fail)
+  abort <runId>        hard-stop a run (smithers cancel)
+  resume <runId> [--force]
+                       resume a run (smithers up --run-id <id> --resume true).
+                       --force resumes a run still marked running: use it only
+                       for a run whose owner process is dead, never to hurry a
+                       live one — two engines on one run corrupt its state
+  --help               show this help
+
+Environment:
+  SE_DRY_RUN=1         print the assembled command + env instead of executing
+  SE_SMITHERS_DIR      override runtime dir (default: ~/.claude/.smithers)
+EOF
+}
+
+die() {
+  echo "se: $*" >&2
+  exit 1
+}
+
+usage_die() {
+  echo "se: $*" >&2
+  usage >&2
+  exit 1
+}
+
+dry_run() { [[ "${SE_DRY_RUN:-0}" == "1" ]]; }
+
+# Real state db: smithers 0.28 resolves its state root by walking UP, so a
+# runtime dir literally named `.smithers` lands the db one level above
+# SMITHERS_DIR. Prefer the first non-empty smithers.db from SMITHERS_DIR
+# upward (two levels cover both layouts); empty files are probe artifacts.
+se_db() {
+  local d
+  for d in "$SMITHERS_DIR" "$(dirname "$SMITHERS_DIR")"; do
+    if [[ -s "$d/smithers.db" ]]; then
+      printf '%s' "$d/smithers.db"
+      return 0
+    fi
+  done
+  printf '%s' "$SMITHERS_DIR/smithers.db"
+}
+
+# The engine records every approval's title and reasons in _smithers_approvals,
+# and nothing rendered them: `se logs` prints a node-completion check mark for a
+# gate whatever it decided, then "Approval requested" with no subject. On
+# run-1786718288581 an operator approved two FAILED work gates reading the check
+# marks as green stages. Emitted as JSON so both the human and the --json
+# consumer read the same rows; best-effort, never fatal.
+pending_approvals_json() {
+  local run_id=$1 db_path rows
+  [[ $run_id =~ ^[A-Za-z0-9:_-]+$ ]] || return 0
+  command -v sqlite3 >/dev/null 2>&1 || return 0
+  command -v jq >/dev/null 2>&1 || return 0
+  db_path="$(se_db)"
+  [[ -s $db_path ]] || return 0
+  rows="$(sqlite3 -json "$db_path" \
+    "SELECT node_id, request_json FROM _smithers_approvals
+     WHERE run_id='$run_id' AND status='pending'
+     ORDER BY requested_at_ms" 2>/dev/null)" || return 0
+  [[ -n $rows ]] || return 0
+  printf '%s' "$rows"
+}
+
+print_pending_approvals() {
+  local rows
+  rows="$(pending_approvals_json "$1")"
+  [[ -n $rows && $rows != "[]" ]] || return 0
+  jq -r '.[] | (try (.request_json | fromjson) catch {title: "(request unreadable)", summary: ""}) as $r |
+    "\n─── DECISION REQUIRED: \(.node_id) ───\n\($r.title)\n\n\($r.summary // "(no reasons recorded)")"' <<<"$rows" 2>/dev/null || true
+}
+
+run_field() {
+  local run_id=$1 field=$2 db_path
+  [[ $run_id =~ ^[A-Za-z0-9:_-]+$ ]] || return 1
+  command -v sqlite3 >/dev/null 2>&1 || return 1
+  db_path="$(se_db)"
+  [[ -s $db_path ]] || return 1
+  sqlite3 "$db_path" "SELECT $field FROM _smithers_runs WHERE run_id='$run_id' LIMIT 1" 2>/dev/null
+}
+
+# True when a live engine process owns the run. runtime_owner_id is
+# "pid:<pid>:<uuid>" while a process drives the run and is CLEARED when the run
+# parks, so an empty owner means nobody is driving. Any other shape is opaque
+# and counts as owned: a second engine on one run corrupts its state, so an
+# unreadable owner must block the automatic resume, never allow it.
+run_owner_alive() {
+  local owner pid
+  owner="$(run_field "$1" runtime_owner_id)" || return 0
+  [[ -n $owner ]] || return 1
+  case $owner in
+    pid:*) ;;
+    *) return 0 ;;
+  esac
+  pid=${owner#pid:}
+  pid=${pid%%:*}
+  [[ $pid =~ ^[0-9]+$ ]] || return 0
+  kill -0 "$pid" 2>/dev/null
+}
+
+# A decision alone does not move the run: the owner process exited when the run
+# parked, so smithers records the approval and nothing drives it. Measured on
+# run-1786718288581 — approved 16:42:24, no progress until a manual resume at
+# 16:44:47. Resuming here closes that gap, and only when nobody owns the run.
+resume_after_decision() {
+  local run_id=$1 status
+  sleep 2 # let the engine claim the run itself, if anything is going to
+  status="$(run_field "$run_id" status)" || return 0
+  case $status in
+    "" | finished | failed | cancelled) return 0 ;;
+  esac
+  if run_owner_alive "$run_id"; then
+    echo "se: $run_id is owned by a live process; not resuming (it is already being driven)." >&2
+    return 0
+  fi
+  echo "se: decision recorded, nothing is driving $run_id — resuming it ('--no-resume' skips this)." >&2
+  cmd_resume "$run_id"
+}
+
+cmd_decide() {
+  local cmd=$1 run_id=$2
+  shift 2
+  local resume_after=1
+  while (($#)); do
+    case $1 in
+      --no-resume) resume_after=0 ;;
+      *) usage_die "$cmd: unknown option $1" ;;
+    esac
+    shift
+  done
+  require_runtime_dir
+  # Never decide blind: what is being decided, and what the decision does, go to
+  # the screen before the decision is recorded.
+  print_pending_approvals "$run_id" >&2
+  smithers_run "$cmd" "$run_id"
+  ((resume_after)) && resume_after_decision "$run_id"
+  return 0
+}
+
+sq() {
+  local s=${1//\'/\'\\\'\'}
+  printf "'%s'" "$s"
+}
+
+print_smithers_cmd() {
+  printf 'cd %s &&' "$(sq "$SMITHERS_DIR")"
+  local arg
+  for arg in "$SMITHERS_BIN" "$@"; do
+    if [[ $arg =~ ^[A-Za-z0-9_./:=-]+$ ]]; then
+      printf ' %s' "$arg"
+    else
+      printf ' %s' "$(sq "$arg")"
+    fi
+  done
+  printf '\n'
+}
+
+require_runtime_dir() {
+  dry_run && return 0
+  [[ -d "$SMITHERS_DIR" ]] || die "smithers runtime dir not found: $SMITHERS_DIR"
+  [[ -x "$SMITHERS_DIR/$SMITHERS_BIN" ]] || die "smithers binary not found: $SMITHERS_DIR/$SMITHERS_BIN (run bun install in $SMITHERS_DIR)"
+}
+
+smithers_run() {
+  if dry_run; then
+    print_smithers_cmd "$@"
+    return 0
+  fi
+  cd "$SMITHERS_DIR"
+  "$SMITHERS_BIN" "$@"
+}
+
+json_escape() {
+  local s=$1
+  s=${s//\\/\\\\}
+  s=${s//\"/\\\"}
+  s=${s//$'\n'/\\n}
+  s=${s//$'\r'/\\r}
+  s=${s//$'\t'/\\t}
+  printf '%s' "$s"
+}
+
+build_input_json() {
+  local plan_path=$1 until=$2 validate_cmd=$3 validate_timeout_ms=$4 doc_review=$5 setup_cmd=$6
+  if command -v jq >/dev/null 2>&1; then
+    jq -cn --arg planPath "$plan_path" --arg until "$until" --arg validateCmd "$validate_cmd" \
+      --arg setupCmd "$setup_cmd" \
+      --argjson validateTimeoutMs "$validate_timeout_ms" --argjson docReview "$doc_review" \
+      '{planPath: $planPath, until: $until, validateCmd: $validateCmd, validateTimeoutMs: $validateTimeoutMs, docReview: $docReview, setupCmd: $setupCmd}'
+  else
+    printf '{"planPath":"%s","until":"%s","validateCmd":"%s","validateTimeoutMs":%s,"docReview":%s,"setupCmd":"%s"}' \
+      "$(json_escape "$plan_path")" "$(json_escape "$until")" "$(json_escape "$validate_cmd")" "$validate_timeout_ms" "$doc_review" "$(json_escape "$setup_cmd")"
+  fi
+}
+
+cmd_pipeline() {
+  local plan="" until="branch" validate_cmd="" attach=0 validate_timeout_s=600 doc_review=false setup_cmd=""
+
+  while (($#)); do
+    case $1 in
+      --until=*) until=${1#--until=} ;;
+      --until)
+        [[ $# -ge 2 ]] || usage_die "--until requires a value (branch|pr)"
+        shift; until=$1 ;;
+      --validate-cmd=*) validate_cmd=${1#--validate-cmd=} ;;
+      --validate-cmd)
+        [[ $# -ge 2 ]] || usage_die "--validate-cmd requires a value"
+        shift; validate_cmd=$1 ;;
+      --setup-cmd=*) setup_cmd=${1#--setup-cmd=} ;;
+      --setup-cmd)
+        [[ $# -ge 2 ]] || usage_die "--setup-cmd requires a value"
+        shift; setup_cmd=$1 ;;
+      --validate-timeout=*) validate_timeout_s=${1#--validate-timeout=} ;;
+      --validate-timeout)
+        [[ $# -ge 2 ]] || usage_die "--validate-timeout requires a value (seconds)"
+        shift; validate_timeout_s=$1 ;;
+      # The single doc-review key (R8): the `se-review-and-work` skill passes it,
+      # `se-work` omits it. The user never types it — the command name selects it.
+      --doc-review) doc_review=true ;;
+      --attach) attach=1 ;;
+      -h|--help) usage; return 0 ;;
+      -*) usage_die "unknown option for pipeline: $1" ;;
+      *)
+        [[ -z $plan ]] || usage_die "unexpected argument: $1"
+        plan=$1 ;;
+    esac
+    shift
+  done
+
+  [[ -n $plan ]] || usage_die "pipeline requires a <plan-path>"
+  [[ -f $plan ]] || die "plan file not found: $plan"
+  case $until in
+    branch|pr) ;;
+    *) usage_die "invalid --until value '$until' (must be branch|pr)" ;;
+  esac
+  # --validate-cmd is optional: when omitted, the workflow derives the command
+  # from the plan's Verification Contract (gate-0). It hard-errors there if the
+  # plan has none. An empty string in the input JSON signals "derive from plan".
+  [[ $validate_timeout_s =~ ^[0-9]+$ ]] || usage_die "--validate-timeout must be an integer number of seconds"
+
+  local plan_abs repo input
+  plan_abs="$(cd "$(dirname "$plan")" && pwd -P)/$(basename "$plan")"
+  repo="$(pwd -P)"
+  input="$(build_input_json "$plan_abs" "$until" "$validate_cmd" "$((validate_timeout_s * 1000))" "$doc_review" "$setup_cmd")"
+
+  local -a args=(up "$PIPELINE_WORKFLOW")
+  ((attach)) || args+=(--detach)
+  args+=(--input "$input")
+
+  if dry_run; then
+    printf 'PIPELINE_REPO=%s\n' "$repo"
+    printf 'DOC_REVIEW_REPO=%s\n' "$repo"
+    print_smithers_cmd "${args[@]}"
+    return 0
+  fi
+
+  require_runtime_dir
+  cd "$SMITHERS_DIR"
+  local rc=0
+  PIPELINE_REPO="$repo" DOC_REVIEW_REPO="$repo" "$SMITHERS_BIN" "${args[@]}" || rc=$?
+  # exit 3 = run reached a durable wait (waiting-approval) — a pause, not a
+  # failure. Only surfaces on --attach; --detach returns 0 immediately.
+  if [[ $rc -eq 3 ]]; then
+    echo "se: run paused at an Approval gate (awaiting a decision, not a failure). Use 'se list', then 'se approve|deny|abort <runId>'." >&2
+    return 0
+  fi
+  return $rc
+}
+
+# jq filter: se-pipeline runs out of `smithers ps --format json` ({cta, runs}).
+PS_RUNS_FILTER='[(.runs // .)[] | select((.workflowId // .workflow // "") == "se-pipeline")]'
+
+cmd_list() {
+  local as_json=0
+  while (($#)); do
+    case $1 in
+      --json) as_json=1 ;;
+      *) usage_die "unknown option for list: $1" ;;
+    esac
+    shift
+  done
+  require_runtime_dir
+  if dry_run; then
+    print_smithers_cmd ps --format json
+    return 0
+  fi
+  cd "$SMITHERS_DIR"
+
+  if ((as_json)); then
+    command -v jq >/dev/null 2>&1 || die "se list --json requires jq"
+    local runs summaries="[]"
+    runs="$("$SMITHERS_BIN" ps --format json | jq "$PS_RUNS_FILTER")" || die "smithers ps failed"
+    local db_path
+    db_path="$(se_db)"
+    if command -v sqlite3 >/dev/null 2>&1 && [[ -s $db_path ]]; then
+      summaries="$(sqlite3 -json "$db_path" \
+        "SELECT verdict, run_id, branch, plan_path, report_dir, total_tokens, est_cost_usd
+         FROM summary ORDER BY rowid DESC LIMIT 20")"
+      [[ -n $summaries ]] || summaries="[]"
+    fi
+    jq -n --argjson runs "$runs" --argjson summaries "$summaries" \
+      '{runs: $runs, summaries: $summaries}'
+    return 0
+  fi
+
+  local out
+  if command -v jq >/dev/null 2>&1; then
+    # The toon-format `smithers ps` output interleaves runs with a giant
+    # cta/description blob; render a compact table from the JSON instead.
+    # Child runs (parentRunId set) are folded away — `se show` has them.
+    out="$("$SMITHERS_BIN" ps --format json)" || die "smithers ps failed"
+    echo "runs (id | status | started):"
+    jq -r "$PS_RUNS_FILTER"' | .[] | select(.parentRunId == null)
+      | [.id, .status, (.started // "")] | join(" | ")' <<<"$out"
+  else
+    out="$("$SMITHERS_BIN" ps)" || die "smithers ps failed"
+    awk 'NR == 1 || /se-pipeline/' <<<"$out"
+  fi
+
+  # Cost per finished run comes ONLY from the run's summary output — the single
+  # authoritative store (KTD6/U6); tokens are ground truth, USD is an estimate.
+  local db_path
+  db_path="$(se_db)"
+  if command -v sqlite3 >/dev/null 2>&1 && [[ -s $db_path ]]; then
+    echo
+    echo "summary (verdict | run | branch | plan | tokens | ~USD):"
+    local summary_out summary_rc
+    summary_out="$(sqlite3 -separator ' | ' "$db_path" \
+      "SELECT s.verdict, substr(s.run_id, 1, 12), s.branch,
+              replace(s.plan_path, rtrim(s.plan_path, replace(s.plan_path, '/', '')), ''),
+              s.total_tokens, printf('%.2f', s.est_cost_usd)
+       FROM summary s ORDER BY rowid DESC LIMIT 20" 2>&1)"
+    summary_rc=$?
+    # A real query error (locked db, missing table) must be distinguishable from
+    # a genuinely empty history — never collapse both into "no summaries yet".
+    if [[ $summary_rc -ne 0 ]]; then
+      echo "  (summary query failed: $summary_out)" >&2
+    elif [[ -z $summary_out ]]; then
+      echo "  (no summaries yet — older runs predate the cost store)"
+    else
+      echo "$summary_out"
+    fi
+  fi
+}
+
+cmd_show() {
+  local run_id="" as_json=0
+  while (($#)); do
+    case $1 in
+      --json) as_json=1 ;;
+      -*) usage_die "unknown option for show: $1" ;;
+      *)
+        [[ -z $run_id ]] || usage_die "unexpected argument: $1"
+        run_id=$1 ;;
+    esac
+    shift
+  done
+  [[ -n $run_id ]] || usage_die "show requires a <runId>"
+  # run_id lands in a SQL literal below — allow only smithers id charset.
+  [[ $run_id =~ ^[A-Za-z0-9:_-]+$ ]] || die "invalid runId: $run_id"
+  require_runtime_dir
+  if dry_run; then
+    print_smithers_cmd inspect "$run_id" --format json
+    return 0
+  fi
+  cd "$SMITHERS_DIR"
+  command -v jq >/dev/null 2>&1 || die "se show requires jq"
+
+  # Child run ids (…:child:…) are rejected by `smithers inspect` — the summary
+  # row and report dir still resolve, so inspect degrades to null, not a die.
+  local inspect summary="[]"
+  inspect="$("$SMITHERS_BIN" inspect "$run_id" --format json 2>/dev/null)" || inspect="null"
+  local db_path
+  db_path="$(se_db)"
+  if command -v sqlite3 >/dev/null 2>&1 && [[ -s $db_path ]]; then
+    summary="$(sqlite3 -json "$db_path" \
+      "SELECT verdict, run_id, branch, plan_path, report_dir, total_tokens, est_cost_usd, notes
+       FROM summary WHERE run_id='$run_id' LIMIT 1")"
+    [[ -n $summary ]] || summary="[]"
+  fi
+
+  local report_dir files="[]"
+  report_dir="$(jq -r '.[0].report_dir // empty' <<<"$summary")"
+  if [[ -n $report_dir && -d $report_dir ]]; then
+    files="$(find "$report_dir" -maxdepth 1 -type f -exec basename {} \; | jq -R . | jq -s 'sort')"
+  fi
+
+  local pending
+  pending="$(pending_approvals_json "$run_id")"
+  [[ -n $pending ]] || pending="[]"
+
+  if ((as_json)); then
+    jq -n --argjson run "${inspect:-null}" --argjson summary "$summary" \
+      --argjson reportFiles "$files" --arg reportDir "${report_dir:-}" \
+      --argjson pendingApprovals "$pending" \
+      '{run: ($run.run? // $run), summary: ($summary[0] // null),
+        reportDir: (if $reportDir == "" then null else $reportDir end),
+        reportFiles: $reportFiles, pendingApprovals: $pendingApprovals}'
+    return 0
+  fi
+
+  jq -rn --argjson run "${inspect:-null}" --argjson summary "$summary" \
+    --argjson reportFiles "$files" --arg reportDir "${report_dir:-}" --arg id "$run_id" '
+    def row(k; v): "\(k): \(if v == null or v == "" then "—" else v end)";
+    row("run"; $id),
+    row("status"; ($run.run.status? // $run.status? // null)),
+    row("verdict"; ($summary[0].verdict? // null)),
+    row("branch"; ($summary[0].branch? // null)),
+    row("plan"; ($summary[0].plan_path? // null)),
+    row("tokens"; ($summary[0].total_tokens? | if . == null then null else (round | tostring) end)),
+    row("~USD"; ($summary[0].est_cost_usd? | if . == null then null else (. * 100 | round / 100 | tostring) end)),
+    row("reportDir"; (if $reportDir == "" then null else $reportDir end)),
+    ("reportFiles: " + ($reportFiles | join(", ") | if . == "" then "—" else . end)),
+    row("notes"; ($summary[0].notes? // null))'
+
+  print_pending_approvals "$run_id"
+}
+
+cmd_resume() {
+  local run_id=$1
+  shift
+  # --force maps to smithers' bare `--force` switch, which resumes a run still
+  # marked running. It is the escape hatch for a run whose owner was killed:
+  # the state row still says running until the dead owner's heartbeat expires
+  # (~30-45s), and a plain resume refuses for that whole window. The engine
+  # takes no value after the flag.
+  local force=""
+  while [[ $# -gt 0 ]]; do
+    case $1 in
+      --force) force="--force"; shift ;;
+      *) usage_die "resume: unknown option $1" ;;
+    esac
+  done
+
+  require_runtime_dir
+  if dry_run; then
+    print_smithers_cmd up "$PIPELINE_WORKFLOW" --run-id "$run_id" --resume true ${force:+"$force"}
+    return 0
+  fi
+  cd "$SMITHERS_DIR"
+
+  # The workflow reads the target repo from PIPELINE_REPO/DOC_REVIEW_REPO (or
+  # FLOW_REPO) at module load; resume must restore them or the resumed run would
+  # target the smithers dir (cwd) instead of the original repo. Both workflows
+  # persist the repo in their gate0 output, so recover it from smithers.db.
+  local repo="" workflow_path="" db_path
+  db_path="$(se_db)"
+  if command -v sqlite3 >/dev/null 2>&1 && [[ -s $db_path ]]; then
+    repo="$(sqlite3 "$db_path" "SELECT repo_path FROM gate0 WHERE run_id='$run_id' LIMIT 1" 2>/dev/null || true)"
+    workflow_path="$(sqlite3 "$db_path" "SELECT workflow_path FROM _smithers_runs WHERE run_id='$run_id' LIMIT 1" 2>/dev/null || true)"
+  fi
+  if [[ -z $repo ]]; then
+    die "cannot resume $run_id: no persisted repo path found (gate0 not reached, or pre-U6 run). Re-launch with 'se pipeline' from the target repo."
+  fi
+
+  # Resume the workflow the run actually started under. Resuming a flow run
+  # against se-pipeline.tsx fails with "workflow path changed since this run
+  # started" and no way forward — the run's own recorded path is the authority,
+  # not the command that happens to be resuming it.
+  local rc=0
+  if [[ $workflow_path == *se-flow.tsx ]]; then
+    FLOW_REPO="$repo" "$SMITHERS_BIN" up "$FLOW_WORKFLOW" --run-id "$run_id" --resume true ${force:+"$force"} || rc=$?
+  else
+    PIPELINE_REPO="$repo" DOC_REVIEW_REPO="$repo" "$SMITHERS_BIN" up "$PIPELINE_WORKFLOW" --run-id "$run_id" --resume true ${force:+"$force"} || rc=$?
+  fi
+  # exit 3 = the resumed run advanced and paused again at an Approval gate — a
+  # normal outcome, NOT a resume failure. Anything else is a real failure.
+  if [[ $rc -eq 3 ]]; then
+    echo "se: resumed; run is paused at an Approval gate (awaiting a decision). Use 'se list', then 'se approve|deny|abort $run_id'." >&2
+    return 0
+  fi
+  if [[ $rc -ne 0 ]]; then
+    {
+      echo "se: resume failed for $run_id (exit $rc)"
+      if [[ -z $force ]]; then
+        echo "se: hint: a run whose owner was killed still reads as running until the heartbeat expires (~30-45s). Either wait and retry, or run 'se resume $run_id --force'. Do not force a run whose owner is alive."
+      fi
+      echo "se: suggested command from 'smithers why $run_id':"
+      "$SMITHERS_BIN" why "$run_id" || true
+    } >&2
+    exit 1
+  fi
+}
+
+build_flow_input() {
+  local spec_path=$1 budget=$2 setup_cmd=$3 validate_cmd=$4
+  if command -v jq >/dev/null 2>&1; then
+    jq -cn --arg specPath "$spec_path" --arg setupCmd "$setup_cmd" \
+      --arg validateCmd "$validate_cmd" --argjson budgetUsd "$budget" \
+      '{specPath: $specPath, budgetUsd: $budgetUsd, setupCmd: $setupCmd, validateCmd: $validateCmd}'
+  else
+    printf '{"specPath":"%s","budgetUsd":%s,"setupCmd":"%s","validateCmd":"%s"}' \
+      "$(json_escape "$spec_path")" "$budget" "$(json_escape "$setup_cmd")" "$(json_escape "$validate_cmd")"
+  fi
+}
+
+# Renders the ordered block list + cost estimate for a spec. Non-zero exit means
+# the validator refused the spec; its errors are already on stderr.
+print_flow_plan() {
+  local spec_path=$1
+  if dry_run && [[ ! -d "$SMITHERS_DIR" ]]; then
+    return 0
+  fi
+  (cd "$SMITHERS_DIR" && bun run "$FLOW_PRINT_SCRIPT" "$spec_path")
+}
+
+# U5/KTD10: rebuild an outcome archive for a run killed before its epilog, so a
+# later spec can still name it in `artifactsFrom`. Prints the archive path on
+# stdout; progress and warnings go to stderr, so the caller can capture the path
+# with a plain command substitution.
+cmd_flow_salvage() {
+  local run_id=$1
+  [[ -n $run_id ]] || usage_die "flow salvage requires a <runId>"
+  if dry_run; then
+    print_smithers_cmd run "$FLOW_SALVAGE_SCRIPT" "$run_id" "$(se_db)"
+    return 0
+  fi
+  require_runtime_dir
+  (cd "$SMITHERS_DIR" && bun run "$FLOW_SALVAGE_SCRIPT" "$run_id" "$(se_db)")
+}
+
+cmd_blocks() {
+  # --json is the only (and default) form; accepted for symmetry with other
+  # subcommands. The catalog is generated from the block registry (KTD6).
+  while (($#)); do
+    case $1 in
+      --json) ;;
+      -h|--help) usage; return 0 ;;
+      *) usage_die "unknown option for blocks: $1" ;;
+    esac
+    shift
+  done
+  if dry_run; then
+    printf 'cd %s && bun run %s\n' "$(sq "$SMITHERS_DIR")" "$CATALOG_SCRIPT"
+    return 0
+  fi
+  require_runtime_dir
+  cd "$SMITHERS_DIR"
+  bun run "$CATALOG_SCRIPT"
+}
+
+cmd_flow() {
+  # `flow salvage <runId>` is a subcommand, not a spec path. Checked before the
+  # option loop so a runId is never mistaken for a spec file.
+  if [[ ${1:-} == salvage ]]; then
+    shift
+    cmd_flow_salvage "$@"
+    return $?
+  fi
+
+  local spec="" budget="null" setup_cmd="" validate_cmd="" attach=0 local_dry=0
+  while (($#)); do
+    case $1 in
+      --budget=*) budget=${1#--budget=} ;;
+      --budget)
+        [[ $# -ge 2 ]] || usage_die "--budget requires a value (USD)"
+        shift; budget=$1 ;;
+      --setup-cmd=*) setup_cmd=${1#--setup-cmd=} ;;
+      --setup-cmd)
+        [[ $# -ge 2 ]] || usage_die "--setup-cmd requires a value"
+        shift; setup_cmd=$1 ;;
+      --validate-cmd=*) validate_cmd=${1#--validate-cmd=} ;;
+      --validate-cmd)
+        [[ $# -ge 2 ]] || usage_die "--validate-cmd requires a value"
+        shift; validate_cmd=$1 ;;
+      --dry-run) local_dry=1 ;;
+      --attach) attach=1 ;;
+      -h|--help) usage; return 0 ;;
+      -*) usage_die "unknown option for flow: $1" ;;
+      *)
+        [[ -z $spec ]] || usage_die "unexpected argument: $1"
+        spec=$1 ;;
+    esac
+    shift
+  done
+
+  [[ -n $spec ]] || usage_die "flow requires a <spec.json>"
+  [[ -f $spec ]] || die "spec file not found: $spec"
+  [[ $budget == null || $budget =~ ^[0-9]+(\.[0-9]+)?$ ]] || usage_die "--budget must be a number (USD)"
+
+  local spec_abs repo input
+  spec_abs="$(cd "$(dirname "$spec")" && pwd -P)/$(basename "$spec")"
+  repo="$(pwd -P)"
+  input="$(build_flow_input "$spec_abs" "$budget" "$setup_cmd" "$validate_cmd")"
+
+  local -a args=(up "$FLOW_WORKFLOW")
+  ((attach)) || args+=(--detach)
+  args+=(--input "$input")
+
+  if dry_run || ((local_dry)); then
+    printf 'FLOW_REPO=%s\n' "$repo"
+    print_flow_plan "$spec_abs" || die "flow spec refused by the validator (see above)"
+    print_smithers_cmd "${args[@]}"
+    return 0
+  fi
+
+  require_runtime_dir
+  # R10: show the composed flow and its cost before starting, then start without
+  # waiting for an acknowledgement. A spec the validator refuses stops here
+  # rather than at the interpreter's gate-0, which saves a launch.
+  print_flow_plan "$spec_abs" || die "flow spec refused by the validator (see above)"
+  cd "$SMITHERS_DIR"
+  local rc=0
+  FLOW_REPO="$repo" "$SMITHERS_BIN" "${args[@]}" || rc=$?
+  if [[ $rc -eq 3 ]]; then
+    echo "se: flow paused at an Approval gate (awaiting a decision, not a failure). Use 'se list', then 'se approve|deny|abort <runId>'." >&2
+    return 0
+  fi
+  return $rc
+}
+
+require_run_id() {
+  local cmd=$1
+  [[ $# -ge 2 && -n ${2:-} ]] || usage_die "$cmd requires a <runId>"
+}
+
+main() {
+  (($#)) || { usage >&2; exit 1; }
+  local cmd=$1
+  shift
+  case $cmd in
+    -h|--help|help) usage ;;
+    pipeline) cmd_pipeline "$@" ;;
+    flow) cmd_flow "$@" ;;
+    blocks) cmd_blocks "$@" ;;
+    list) cmd_list "$@" ;;
+    show) cmd_show "$@" ;;
+    db-path) se_db; echo ;;
+    logs|chat)
+      require_run_id "$cmd" "$@"
+      require_runtime_dir
+      smithers_run "$cmd" "$@" ;;
+    approve|deny)
+      require_run_id "$cmd" "$@"
+      cmd_decide "$cmd" "$@" ;;
+    monitor)
+      require_runtime_dir
+      smithers_run monitor "$@" ;;
+    abort)
+      require_run_id abort "$@"
+      require_runtime_dir
+      smithers_run cancel "$@" ;;
+    resume)
+      require_run_id resume "$@"
+      cmd_resume "$@" ;;
+    *) usage_die "unknown command: $cmd" ;;
+  esac
+}
+
+main "$@"
diff --git a/.claude/.smithers/bun.lock b/.claude/.smithers/bun.lock
new file mode 100644
index 0000000000000000000000000000000000000000..c81547118b3a00bc2cac641f13267ecc51d2fdea
--- /dev/null
+++ b/.claude/.smithers/bun.lock
@@ -0,0 +1,1612 @@
+{
+  "lockfileVersion": 1,
+  "configVersion": 1,
+  "workspaces": {
+    "": {
+      "name": "claude-smithers-workflows",
+      "dependencies": {
+        "smithers-orchestrator": "0.32.0",
+        "zod": "4.4.3",
+      },
+      "devDependencies": {
+        "@types/bun": "^1.3.14",
+        "@types/node": "26.1.1",
+        "typescript": "6.0.3",
+      },
+    },
+  },
+  "trustedDependencies": [
+    "@smithers-orchestrator/jj-darwin-arm64",
