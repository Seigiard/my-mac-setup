diff --git a/.config/herdr/plugins/herdr-pane-labels/ensure.sh b/.config/herdr/plugins/herdr-pane-labels/ensure.sh
new file mode 100644
index 0000000000000000000000000000000000000000..45daf02cc1641d1e05096b9ff48615b1063002fa
--- /dev/null
+++ b/.config/herdr/plugins/herdr-pane-labels/ensure.sh
@@ -0,0 +1,14 @@
+#!/bin/sh
+# Startup ensures the fallback daemon; lifecycle hooks request reconciliation.
+# Both paths stay silent and fail open so plugin failures never affect Herdr.
+sync="$HOME/.local/bin/herdr-task-sync"
+[ -x "$sync" ] || exit 0
+
+case "${1:-}" in
+  --event)
+    "$sync" --event >/dev/null 2>&1 || true
+    ;;
+  '') "$sync" --ensure-daemon >/dev/null 2>&1 || true ;;
+esac
+
+exit 0
diff --git a/.config/herdr/plugins/herdr-pane-labels/herdr-plugin.toml b/.config/herdr/plugins/herdr-pane-labels/herdr-plugin.toml
new file mode 100644
index 0000000000000000000000000000000000000000..22fa1d4739e76fdb1f0ff324f0d17b835c5ed463
--- /dev/null
+++ b/.config/herdr/plugins/herdr-pane-labels/herdr-plugin.toml
@@ -0,0 +1,72 @@
+id = "seigi.pane-labels"
+name = "Pane Labels"
+version = "0.1.0"
+min_herdr_version = "0.8.0"
+description = "Keep pane and tab labels in step with what each pane runs."
+platforms = ["macos", "linux"]
+
+# ~/.local/bin/herdr-task-sync remains the only pane and tab label writer.
+# Events only invalidate its session-wide presentation coordinator, while the
+# daemon repairs foreground process and CWD changes that emit no useful event.
+
+# Starts the daemon with the herdr server.
+[[startup]]
+command = ["sh", "ensure.sh"]
+
+# Herdr 0.8 lifecycle events are invalidation signals, not state payloads.
+[[events]]
+on = "pane.created"
+command = ["sh", "ensure.sh", "--event"]
+
+[[events]]
+on = "pane.moved"
+command = ["sh", "ensure.sh", "--event"]
+
+[[events]]
+on = "pane.exited"
+command = ["sh", "ensure.sh", "--event"]
+
+[[events]]
+on = "pane.closed"
+command = ["sh", "ensure.sh", "--event"]
+
+[[events]]
+on = "pane.agent_detected"
+command = ["sh", "ensure.sh", "--event"]
+
+[[events]]
+on = "pane.agent_status_changed"
+command = ["sh", "ensure.sh", "--event"]
+
+[[events]]
+on = "tab.created"
+command = ["sh", "ensure.sh", "--event"]
+
+[[events]]
+on = "tab.closed"
+command = ["sh", "ensure.sh", "--event"]
+
+[[events]]
+on = "tab.moved"
+command = ["sh", "ensure.sh", "--event"]
+
+[[events]]
+on = "tab.renamed"
+command = ["sh", "ensure.sh", "--event"]
+
+# A worktree opened through herdr invalidates the pass immediately. An agent
+# that creates its own worktree emits no herdr event, so that case still waits
+# for the daemon's own sweep.
+[[events]]
+on = "worktree.created"
+command = ["sh", "ensure.sh", "--event"]
+
+[[events]]
+on = "worktree.opened"
+command = ["sh", "ensure.sh", "--event"]
+
+[[actions]]
+id = "sweep"
+title = "Pane labels: refresh now"
+contexts = ["workspace"]
+command = ["sh", "sweep.sh"]
diff --git a/.config/herdr/plugins/herdr-pane-labels/sweep.sh b/.config/herdr/plugins/herdr-pane-labels/sweep.sh
