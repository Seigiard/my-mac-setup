+  });
+
+  test(`${SCAN_OVERRIDE_ENV} из окружения пропускает tier 2, как и tier 1`, () => {
+    // #given the operator's per-invocation escape hatch in the environment
+    const repo = makeRepo();
+    const head = git(repo, "rev-parse", "HEAD");
