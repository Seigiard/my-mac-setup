+
+  test("requirements-only план → отказ с причиной (AE4)", () => {
+    const r = planGate(requirementsOnlyPlan, "branch");
+    expect(r.ok).toBe(false);
+    if (r.ok) throw new Error("expected refusal");
+    expect(r.reason).toContain("artifact_readiness");
